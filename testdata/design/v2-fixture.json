  {
   "version": "14.3.0",
   "date": "6 Oct 2026",
   "notes": [
    "Wi-Fi reconnects more reliably after an access point restart",
    "Energy: daily total no longer double-counts at midnight",
    "Berry scripts start faster and use less heap",
    "Console keeps its scroll position while output streams"
   ]
  },
  {
   "version": "14.2.0",
   "date": "18 Aug 2026",
   "notes": [
    "New PowerOnState option for staggered start after power loss",
    "MQTT: TLS session resumption",
    "Fixed: dimmer flicker on some PWM drivers"
   ]
  },
  {
   "version": "14.1.0",
   "date": "30 Jun 2026",
   "notes": [
    "Web UI: device groups",
    "Reduced flash wear for frequent settings saves"
   ]
  }
