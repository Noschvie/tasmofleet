package web

import (
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/hellwand/tasmofleet/internal/model"
	"github.com/hellwand/tasmofleet/internal/web/ui"
)

// fleetBackupsPage is Devices -> Device backups (#409, named by its object since #1106): the last scheduled run, the device table, the storage
// totals, the schedule form and the backups of deleted devices. The device table is the one long list, so
// every other card is short and it comes last on a phone (#684). Back up all now acts on the whole fleet,
// not on the table: it is in the page header, and the broker notice (#853) stands once below it. The schedule is the backups entry of
// sysLayout, saved through the same form machinery as the Settings page, with the page's own save bar.
// An operator sees the same cards read-only: nothing on it starts a fleet run or changes a setting.
templ fleetBackupsPage(p sysPage) {
	@ui.PageHeader("Device backups", "Device backups for the whole fleet") {
		if p.Fleet.Admin {
			@ui.Button(ui.Btn{Label: "Back up all now", Kind: "primary", Type: "submit", Form: "bk-all", Attrs: templ.Attributes{"title": p.Fleet.AllTitle()}})
		}
	}
	if p.Fleet.ACL {
		@ui.BrokerACLNotice()
	}
	@sysErrors(p)
	<div class="syswrap">
		if p.Fleet.Admin {
			<form id="sysform" class="syspage bk-page" data-keep-draft="backups" method="post" action={ templ.SafeURL(p.Base + fleetPath) }>
				<input type="hidden" name="csrf" value={ p.CSRF }/>
				@fleetStacks(p)
				@ui.SaveBar(ui.SaveBarData{Discard: p.Base + fleetPath, WhileDirty: !p.Posted})
			</form>
		} else {
			<div class="syspage bk-page">
				@fleetStacks(p)
			</div>
		}
	</div>
	// bk-sig belongs to this empty form, so the schedule's save (sysform refuses a field it does not know) never posts it.
	<form id="bk-live"></form>
	if p.Fleet.Admin {
		<form id="picker" method="post" action={ templ.SafeURL(p.Base + "/devices/bulk/backup") }>
			<input type="hidden" name="csrf" value={ p.CSRF }/>
		</form>
		<form id="bk-all" method="post" action={ templ.SafeURL(p.Base + "/devices/bulk/backup") }>
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			for _, id := range p.Fleet.AllIDs {
				<input type="hidden" name="id" value={ strconv.FormatInt(int64(id), 10) }/>
			}
			for _, id := range p.Fleet.SkippedIDs {
				<input type="hidden" name="left" value={ strconv.FormatInt(int64(id), 10) }/>
			}
		</form>
	}
	if p.Storage != nil && len(p.Storage.Orphans) > 0 {
		<form id="bk-orph" method="post" action={ templ.SafeURL(p.Base + fleetPath) }>
			<input type="hidden" name="csrf" value={ p.CSRF }/>
		</form>
		if p.Storage.CanBulk {
			<form id="bk-orph-sel" method="get" action={ templ.SafeURL(p.Base + orphansDeletePath) }></form>
		}
		if p.Storage.CanDelete {
			@backupDeleteDialog(backupsView{CSRF: p.CSRF})
		}
	}
	<div id="bk-prune">
		if p.Fleet.CanBulk && len(p.Fleet.PruneNow) > 0 {
			@fleetPruneDialog(p)
		}
	</div>
	if p.Fleet.CanBulk && p.Storage != nil && len(p.Storage.Unreferenced) > 0 {
		@fleetUnrefDialog(p)
	}
	if p.NeedStepUp {
		@ui.StepUp(p.StepUp)
	}
}

templ fleetStacks(p sysPage) {
	for _, tab := range p.Tabs {
		<div class="sys-tab" id={ "sec-" + tab.Slug } data-sys-tab={ tab.Slug }>
		@ui.CardStacks(3) {
			for si, span := range tab.Spans {
				@ui.CardStack(span) {
					for _, c := range tab.Cards {
						if c.Stack == si {
							switch {
								case c.ID == "schedule" && p.Fleet.Admin:
									@fleetSchedule(p, c)
								case c.ID == "schedule":
									@fleetScheduleReadOnly(p, c)
								default:
									@sysCardView(p, c)
							}
						}
					}
				}
			}
		}
		</div>
	}
}

// fleetLastRun is the first card: the last scheduled run as four tiles. The devices behind the counts are in
// the table below, which the Failed and Skipped tiles link; the card does not name them again (#996).
templ fleetLastRun(p sysPage, c sysCard) {
	{{ v := p.Fleet }}
	@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: fleetLastNote(*v), Class: ui.StackRank(c.Phone), Plain: true}) {
		switch {
			case v.Run == nil && !v.Scheduled:
				@fleetNoSchedule(*v)
			case v.Run == nil:
				@fleetMissed(*v)
				<p class="ufield-help">No scheduled run has finished yet.</p>
			case !v.Scheduled:
				@fleetNoSchedule(*v)
			default:
				@fleetMissed(*v)
				@fleetRunSums(*v)
		}
	}
}

func fleetLastNote(v fleetView) string {
	if !v.Scheduled {
		return "Choose the backup days under Schedule, next to this card."
	}
	return "The last scheduled run, " + v.Plan + ". Manual runs are on the Transactions page."
}

// fleetMissed says that the newest scheduled time was skipped because TasmoFleet was down (#601).
templ fleetMissed(v fleetView) {
	if !v.Missed.IsZero() {
		<div class="sys-status">
			<span class="sys-status-dot t-warn" aria-hidden="true"></span>
			<div class="sys-status-text">
				<b>A scheduled run was skipped</b>
				<span>TasmoFleet was not running at the scheduled time and was back more than 60 minutes late, so the run was not made up. Noticed <time { ui.StampAttrs(v.Missed, ui.StampRelative)... }>{ ui.StampRelativeText(v.Now, v.Missed) }</time>. The next run is as scheduled.</span>
			</div>
		</div>
	}
}

templ fleetNoSchedule(v fleetView) {
	<div class="sys-status">
		<span class="sys-status-dot t-neutral" aria-hidden="true"></span>
		<div class="sys-status-text">
			<b>No schedule</b>
			<span>Scheduled backups are off. Devices are backed up only when someone starts it, here or on a device.</span>
			if v.Run != nil {
				<span>Last scheduled run <time { ui.StampAttrs(v.Run.StartedAt, ui.StampRelative)... }>{ ui.StampRelativeText(v.Now, v.Run.StartedAt) }</time> · { v.LastLine() }</span>
			}
		</div>
	</div>
}

// fleetRunSum is a count of the last run; it links the table filtered to it while there is something to see.
// The note, when there is one, sits on the tile.
templ fleetRunSum(label string, n int, href, note string) {
	if n > 0 {
		@sysSumLink(label, strconv.Itoa(n), href) {
			if note != "" {
				<div class="sys-sum-note">{ note }</div>
			}
		}
	} else {
		@sysSum(label, "0")
	}
}

templ fleetRunSums(v fleetView) {
	<div class="sys-sums">
		<div class="sys-sum">
			<div class="sys-sum-label">Started</div>
			<div class="sys-sum-value"><span class="sys-sum-sm"><time { ui.StampAttrs(v.Run.StartedAt, ui.StampRelative)... }>{ ui.StampRelativeText(v.Now, v.Run.StartedAt) }</time></span></div>
		</div>
		@sysSum("Backed up", strconv.Itoa(v.Run.OK))
		@fleetRunSum("Failed", v.Run.Failed, v.ChipHref(fleetFailed), "")
		@fleetRunSum("Skipped", v.Run.Skipped, v.ChipHref(fleetSkipped), "Not failures, not in the notification")
	</div>
}

// fleetWhy is a reason with its time: "Offline since Yesterday 21:14".
templ fleetWhy(w whyText) {
	if w.Since.IsZero() {
		{ w.Reason }
	} else {
		{ w.Reason + " since " }<time { ui.StampAttrs(w.Since, ui.StampRelative)... } title={ w.SinceFull }>{ w.SinceText }</time>
	}
}

// fleetSentence starts a stored reason with a capital: "offline since ..." reads as a line of its own.
func fleetSentence(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

// fleetDevices is the main table card: filter chips, one row per device, the run buttons. It is also the
// live region of the page (#950): on a backup, device or resync event it reloads the page's own address and
// takes its own insides and, out of band, the cards a run changes (LiveOOB). select.js keeps the ticked rows
// across the swap and holds it while a menu, a dialog or the Storage fold is open. hx-sync asks again once
// the request in flight is done, so the last event of a run is never dropped (a throttle would).
templ fleetDevices(p sysPage, c sysCard) {
	{{ v := p.Fleet }}
	<section
		class={ "scard", ui.StackRank(c.Phone) }
		id={ "card-" + c.ID }
		data-select-scope
		data-live-region
		hx-get={ v.LiveHref() }
		hx-include="#bk-sig"
		hx-trigger="sse:backup, sse:device, sse:resync"
		hx-sync="this:queue last"
		hx-select={ "#card-" + c.ID + " > *" }
		hx-select-oob={ v.LiveOOB() }
		hx-swap="innerHTML"
	>
		<input type="hidden" id="bk-sig" name="sig" form="bk-live" value={ v.Sig }/>
		<div class="sch">
			<div>
				<h2>{ c.Title }</h2>
				<p class="cnote">Newest backup, files and the result of the last scheduled run, per device.</p>
			</div>
			if v.Admin {
				<div class="cbd">
					@ui.Button(ui.Btn{Label: "Back up selected", Type: "submit", Form: "picker", Disabled: true, Attrs: templ.Attributes{"data-needs-selection": true}}) {
						<span data-select-suffix></span>
					}
				</div>
			}
		</div>
		<div class="sbody sbody-plain">
			<div class="dv-tools bk-tools">
				<div class="dv-chips">
					for _, ch := range v.Chips {
						@ui.Chip(ui.ChipData{Label: ch.Label, Count: strconv.Itoa(ch.N), Href: ch.Href, Current: ch.Current})
					}
				</div>
			</div>
			if v.PWNote() != "" {
				<p class="cnote bk-pwnote">
					{ v.PWNote() }
					if v.PWHref != "" {
						{ " " }<a href={ templ.SafeURL(v.PWHref) }>Set them under System › MQTT, Device MQTT passwords</a>
					}
				</p>
			}
			<div class="table-scroll">
				<table class="dense bk-table">
					<colgroup>
						if v.Admin {
							<col class="bk-c-sel"/>
						}
						<col class="bk-c-dev"/>
						<col class="bk-c-new"/>
						<col class="bk-c-runs"/>
						<col class="bk-c-files"/>
						<col class="bk-c-res"/>
						<col class="bk-c-act"/>
					</colgroup>
					<thead>
						<tr>
							if v.Admin {
								<th class="sel"><input type="checkbox" data-select-all aria-label="Select all listed devices"/><span class="sr-only">Select</span></th>
							}
							@fleetSortTh(*v, "device", "Device")
							@fleetSortTh(*v, "newest", "Newest backup")
							<th title="Backups stored for the device">Backups</th>
							<th title="Whether the files on the device are in the backup too">Device files</th>
							@fleetSortTh(*v, "result", "Last result")
							<th><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, row := range v.Rows {
							@fleetRowView(*v, row)
						}
					</tbody>
				</table>
			</div>
			<p class="cnote bk-foot">{ v.FootNote() }</p>
		</div>
	</section>
}

templ fleetSortTh(v fleetView, col, label string) {
	<th aria-sort={ v.AriaSort(col) }><a class={ v.SortClass(col) } href={ templ.SafeURL(v.SortHref(col)) }>{ label }<span class="sortmark" aria-hidden="true"></span></a></th>
}

templ fleetRowView(v fleetView, r fleetRow) {
	<tr>
		if v.Admin {
			<td data-label="Select" class="sel"><label class="hit"><input type="checkbox" form="picker" name="id" value={ strconv.FormatInt(int64(r.ID), 10) } aria-label={ "Select " + r.Name }/></label></td>
		}
		<td data-label="Device" class="wrap p1 dv-name" title={ r.Name }><span class="bk-nm"><a href={ templ.SafeURL(r.DeviceHref) }>@ui.Soft(r.Name)</a><span class="muted nowrap bk-devid">{ "#" + strconv.FormatInt(int64(r.ID), 10) }</span></span></td>
		<td data-label="Newest backup" class="bk-new s">
			if r.Newest.IsZero() {
				@ui.Badge(ui.ToneAccent, "No backup")
			} else {
				<time { ui.StampAttrs(r.Newest, ui.StampRelative)... } title={ ui.StampText(r.Newest, ui.StampTitle) }>{ ui.StampRelativeText(v.Now, r.Newest) }</time>
				<span class="muted">{ " · " + r.Ago }</span>
			}
		</td>
		<td data-label="Backups" class="nowrap s" title={ r.RunsTitle }>
			if r.Runs == 0 {
				<span class="muted">-</span>
			} else {
				<span class="mono">{ strconv.Itoa(r.Runs) }</span><span class="bk-u">{ " " + noun(r.Runs, "backup", "backups") }</span>
			}
		</td>
		<td data-label="Device files" class="nowrap s">
			switch {
				case r.Files != "":
					<span class="bk-files-ok" title="The files of the device are stored with the backup">{ r.Files }</span>
				case r.FilesBadge != "":
					@ui.BadgeOf(ui.BadgeData{Tone: ui.ToneNeutral, Label: r.FilesBadge, Title: fleetSentence(r.FilesWhy)})
				default:
					<span class="muted">-</span>
			}
		</td>
		<td data-label="Last result" class="wrap s" if r.ResultTitle() != "" { title={ r.ResultTitle() } }>
			switch r.Outcome {
				case model.BackupOutcomeOK:
					@ui.Badge(ui.ToneOK, "Succeeded")
				case model.BackupOutcomeFailed:
					@ui.Badge(ui.ToneDanger, "Failed")
					<span class="bk-rsn" title={ r.Why.Plain() }>
						{ " " }
						if r.SetPWHref != "" {
							@setPasswordLink(r.SetPWHref, r.Name)
							{ " · " }
						}
						@fleetWhy(r.Why)
					</span>
				case model.BackupOutcomeSkipped:
					@ui.Badge(ui.ToneNeutral, "Skipped")
					<span class="bk-rsn" title={ r.Why.Plain() }>{ " " }@fleetWhy(r.Why)</span>
				default:
					if r.NotInRun {
						<span class="muted">Not in a run yet</span>
					} else {
						<span class="muted">-</span>
					}
			}
		</td>
		<td data-label="Actions" class="rowacts">
			@ui.RowMenu("Actions for "+r.Name, fleetMenu(r), false)
		</td>
	</tr>
}

// setPasswordLink leads from a backup that failed for want of a usable MQTT password to the device's form that sets it
// (#997). In the Backups table it opens the reason, so the cell's cut at desktop width never hides it. The link names
// the device for a screen reader, which reads it out of its row.
templ setPasswordLink(href, name string) {
	<a class="bk-link" href={ templ.SafeURL(href) } aria-label={ "Set the MQTT password of " + name }>Set MQTT password</a>
}

func fleetMenu(r fleetRow) []ui.MenuItem {
	items := []ui.MenuItem{{Label: "Open backups", Href: r.BackupsHref}, {Label: "Open device", Href: r.DeviceHref}}
	if r.ReplaceHref != "" {
		items = append(items, ui.MenuItem{Label: "Replace…", Href: r.ReplaceHref})
	}
	return items
}

// fleetStorage is the Storage card: totals and what the next run deletes.
templ fleetStorage(p sysPage, c sysCard) {
	{{ v := p.Fleet }}
	@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: c.Note, Class: ui.StackRank(c.Phone), Plain: true}) {
		<div class="sys-sums">
			@sysSum("Backups", strconv.Itoa(v.Runs))
			@sysSum("Total size", v.Size)
			@sysSum("Kept (never pruned)", strconv.Itoa(v.Kept))
			@sysSumLink("Devices without a backup", strconv.Itoa(v.Without), v.WithoutHref)
		</div>
		<h3 class="sys-subhead">{ "Pruned at the next run (" + strconv.Itoa(v.PruneRuns) + ")" }</h3>
		if v.PruneRuns == 0 {
			<p class="cnote">Nothing: no device is at its limit of { v.Keep } backups.</p>
		} else {
			<div class="bk-bar">
				<div class="bk-retention">
					{ plural(v.PruneRuns, "backup") + " of " + plural(len(v.Prune), "device") + " · " + v.PruneSize + " beyond the limit of " + v.Keep + ". Each device loses its oldest backups when its next one is taken. Kept backups are never pruned." }
				</div>
				if v.CanBulk && len(v.PruneNow) > 0 {
					@ui.Button(ui.Btn{Label: "Prune now…", Href: v.Base + pruneNowPath, Dialog: "dlg-fprune"})
				}
			</div>
			<details class="fold">
				<summary>Devices <span class="meta">{ strconv.Itoa(len(v.Prune)) }</span></summary>
				<div class="sys-orphans">
					for _, pr := range v.Prune {
						<div class="sys-orphan">
							<div class="sys-orphan-main">
								<div class="sys-orphan-title">
									<a href={ templ.SafeURL(pr.Href) } class="sys-store-name">{ pr.Name }</a>
									if pr.LeftOut != "" {
										@ui.BadgeOf(ui.BadgeData{Tone: ui.ToneNeutral, Label: "Left out", Title: "Prune now leaves it alone: " + pr.LeftOut})
									}
								</div>
								<div class="sys-orphan-detail">{ plural(pr.Runs, "backup") + " · oldest " }<time { ui.StampAttrs(pr.Oldest, ui.StampDateTime)... }>{ ui.StampText(pr.Oldest, ui.StampDateTime) }</time>{ " · " + pr.Size }</div>
							</div>
						</div>
					}
				</div>
			</details>
		}
	}
}

// fleetPruneDialog is Prune now: the runs the Storage list takes (the devices that took part), deleted now. It
// posts their ids; the server cuts them to what is still allowed. The page twin is the link's address.
templ fleetPruneDialog(p sysPage) {
	{{ v := p.Fleet }}
	<dialog id="dlg-fprune" class="udlg" aria-labelledby="dlg-fprune-h">
		<form method="post" action={ templ.SafeURL(p.Base + pruneNowPath) } class="udlg-in">
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<input type="hidden" name="confirm" value="1"/>
			for _, run := range v.PruneNow {
				<input type="hidden" name="id" value={ strconv.FormatInt(int64(run.ID), 10) }/>
			}
			<h2 id="dlg-fprune-h">Prune { plural(len(v.PruneNow), "backup") } now?</h2>
			<p class="udlg-body"><b>{ plural(len(v.PruneNow), "backup") + " of " + plural(v.PruneNowDevices, "device") + ", " + v.PruneNowSize + " in all" }</b>, are deleted now instead of at their next backup. { pruneNowRules } { pruneLeftOutText(v.PruneLeftOut) } This cannot be undone; the audit log lists every backup.</p>
			<div class="udlg-changes">
				for _, run := range v.PruneNow {
					<div><span>{ run.Name }</span><span><time { ui.StampAttrs(run.Taken, ui.StampDateTime)... }>{ ui.StampText(run.Taken, ui.StampDateTime) }</time>{ " · " + humanBytes(run.Bytes) }</span></div>
				}
			</div>
			<div class="udlg-foot">
				@ui.Button(ui.Btn{Label: "Cancel", Attrs: templ.Attributes{"data-close": true}})
				@ui.Button(ui.Btn{Label: "Prune " + plural(len(v.PruneNow), "backup"), Kind: "danger-solid", Type: "submit"})
			</div>
		</form>
	</dialog>
}

// fleetUnrefDialog is Delete all for the unreferenced files: it posts every path listed now.
templ fleetUnrefDialog(p sysPage) {
	{{ st := p.Storage }}
	<dialog id="dlg-unref" class="udlg" aria-labelledby="dlg-unref-h">
		<form method="post" action={ templ.SafeURL(p.Base + unrefDeletePath) } class="udlg-in">
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<input type="hidden" name="confirm" value="1"/>
			for _, f := range st.Unreferenced {
				<input type="hidden" name="path" value={ f.Path }/>
			}
			<h2 id="dlg-unref-h">Delete { plural(len(st.Unreferenced), "unreferenced file") }?</h2>
			<p class="udlg-body"><b>{ plural(len(st.Unreferenced), "file") + ", " + st.UnrefSize + " in all" }</b>, in old backup folders that no backup entry points to. No backup and no restore point uses them. This cannot be undone; the audit log lists every file.</p>
			<div class="udlg-changes">
				for _, f := range st.Unreferenced {
					<div><span class="mono">{ f.Path }</span><span class="mono">{ f.Size }</span></div>
				}
			</div>
			<div class="udlg-foot">
				@ui.Button(ui.Btn{Label: "Cancel", Attrs: templ.Attributes{"data-close": true}})
				@ui.Button(ui.Btn{Label: "Delete " + plural(len(st.Unreferenced), "file"), Kind: "danger-solid", Type: "submit"})
			</div>
		</form>
	</dialog>
}

// fleetSchedule is the Schedule card of an admin: a line with what is set, the fields in a fold. It is the
// same card as every settings card (sysCardData), with the fold added around its rows; the fold is open
// while a row has a problem, so an error or a secret to enter again is never hidden in it (#684).
templ fleetSchedule(p sysPage, c sysCard) {
	@ui.SettingsCard(sysCardData(p, c)) {
		<div class="sys-status">
			<span class={ "sys-status-dot", templ.KV("t-ok", p.Fleet.Scheduled), templ.KV("t-neutral", !p.Fleet.Scheduled) } aria-hidden="true"></span>
			<div class="sys-status-text">
				if p.Fleet.Scheduled {
					<b>{ fleetSentence(p.Fleet.Plan) }</b>
				} else {
					<b>No schedule: manual only</b>
				}
				<span>{ fleetScheduleLine(c) }</span>
			</div>
		</div>
		<div class="sf w-full">
			@fleetScheduleNote(*p.Fleet)
		</div>
		<details class="fold" open?={ slices.ContainsFunc(c.Rows, sysRow.hasProblem) }>
			<summary>Change the schedule <span class="meta">Days, time, retention</span></summary>
			<div class="sbody">
				for _, row := range c.Rows {
					@sysRowView(p, row)
				}
			</div>
		</details>
	}
}

// fleetScheduleReadOnly is the Schedule card for an operator: the values, no fields.
templ fleetScheduleReadOnly(p sysPage, c sysCard) {
	@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: c.Note, Class: ui.StackRank(c.Phone), Plain: true}) {
		for _, row := range c.Rows {
			<div class="sf w-full sf-locked">
				<div class="lrow"><span class="lbl">{ fleetScheduleLabel(row) }</span></div>
				<div class="in ro mono">{ fleetScheduleValue(row) }</div>
			</div>
		}
		<p class="cnote">Read-only for operators. Admins change the schedule.</p>
	}
}

func fleetScheduleLabel(row sysRow) string {
	switch row.Key {
	case "BACKUP_DAYS":
		return "Days"
	case "BACKUP_TIME":
		return "Time"
	case "BACKUP_KEEP":
		return "Kept per device"
	case "BACKUP_MAX_AGE":
		return "Never prune younger than"
	}
	return row.Label
}

func fleetScheduleValue(row sysRow) string {
	switch row.Key {
	case "BACKUP_DAYS":
		if row.Value == "" {
			return "None: manual only"
		}
		days := strings.Split(row.Value, ",")
		for i, d := range days {
			days[i] = dayLabels[d]
		}
		return strings.Join(days, ", ")
	}
	return row.Value
}

// fleetScheduleNote is what the schedule form cannot say by itself: whose clock the time is on and when
// the next run is.
templ fleetScheduleNote(v fleetView) {
	@sysScheduleNote(v.Zone, v.Scheduled, v.Now, v.Next)
}

// sysScheduleNote is the note under a schedule form (Backups and Snapshots): the clock the time is on and,
// while a schedule is set, when it runs next.
templ sysScheduleNote(zone string, on bool, now, next time.Time) {
	<p class="ufield-help">
		Times are on the server's clock ({ zone }).
		if on {
			{ " Next run " }<time { ui.StampAttrs(next, ui.StampRelative)... }>{ ui.StampRelativeText(now, next) }</time>.
		}
	</p>
}
