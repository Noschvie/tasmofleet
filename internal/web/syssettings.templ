package web

import (
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/hellwand/tasmofleet/internal/sysconfig"
	"github.com/hellwand/tasmofleet/internal/web/ui"
)

// sysSettingsPage is System settings: the page header, eight tabs (all in one form, shown one at a
// time), a grid of cards per tab and one save bar. The danger zone and the container list sit
// after the form. The fields are the real settings of sysconfig.
templ sysSettingsPage(p sysPage) {
	@ui.PageHeader("Settings", "Applies to the whole TasmoFleet instance")
	<label class="sys-picker" data-sys-picker hidden>
		<span>Section</span>
		<select aria-label="Settings section">
			for _, tab := range p.Tabs {
				<option value={ tab.Slug } selected?={ tab.Slug == p.Active }>{ tab.Label }</option>
			}
		</select>
	</label>
	@ui.Tabs("Settings sections", sysTabLinks(p))
	if p.Error != "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: p.Error, Alert: true})
	}
	if len(p.Pending) > 0 {
		@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Title: "Restart required.", Text: "The stored value of " + strings.Join(p.Pending, ", ") + " applies after the next restart of the container."})
	}
	if p.CannotStepUp {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Alert: true, Text: "This account cannot confirm its identity. Settings that need a confirmation (" + strings.Join(p.StepUpKeys, ", ") + ") cannot be confirmed from this session and must be set in the container configuration."})
	}
	if len(p.Skipped) > 0 {
		<div class="banner tone-warn" role="status">
			<span class="banner-dot"></span>
			<div class="banner-text">
				<b>Stored values that are ignored.</b>
				<ul class="sys-skipped">
					for _, k := range sortedKeys(p.Skipped) {
						<li><code>{ k }</code>: { p.Skipped[k] }</li>
					}
				</ul>
			</div>
		</div>
	}
	<div class="syswrap">
	<form id="sysform" class="syspage" data-keep-draft="sysconfig" method="post" action={ templ.SafeURL(p.Base + sysPath + "?tab=" + p.Active) }>
		<input type="hidden" name="csrf" value={ p.CSRF }/>
		for _, tab := range p.Tabs {
			<div class="sys-tab" id={ "sec-" + tab.Slug } data-sys-tab={ tab.Slug } hidden?={ tab.Slug != p.Active }>
				@ui.CardStacks(3) {
					for si, span := range tab.Spans {
						@ui.CardStack(span) {
							for _, c := range tab.Cards {
								if c.Stack == si {
									@sysCardView(p, c)
								}
							}
						}
					}
				}
			</div>
		}
		@ui.SaveBar(p.Base + sysPath + "?tab=" + p.Active)
	</form>
	<div class="sys-after" id="after-advanced" data-sys-tab="advanced" hidden?={ p.Active != "advanced" }>
		@sysContainer(p.ReadOnly)
		@sysResetBox(p)
	</div>
	</div>
	@ui.Dialog(ui.DialogData{ID: "dlg-reset", Title: "Reset all settings?", Body: sysResetText,
		Action: p.Base + sysPath + "/reset", CSRF: p.CSRF, Verb: "Reset settings", Danger: true})
	if p.NeedStepUp {
		@ui.StepUp(p.StepUp)
	}
}

// snapshotsPage is System -> Snapshots (admins): the database snapshot download, the stored snapshots,
// the schedule (saved through the page's own save bar) and how to restore. The settings are the
// snapshot tab of sysLayout, the same fields and the same save as on the Settings page.
templ snapshotsPage(p sysPage) {
	@ui.PageHeader("Snapshots", "Copies of TasmoFleet’s own database. Device backups are a separate thing.")
	if p.Error != "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: p.Error, Alert: true})
	}
	<div class="syswrap">
		<form id="sysform" class="syspage" data-keep-draft="snapshots" method="post" action={ templ.SafeURL(p.Base + snapPath) }>
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			for _, tab := range p.Tabs {
				<div class="sys-tab" id={ "sec-" + tab.Slug } data-sys-tab={ tab.Slug }>
					@ui.CardStacks(3) {
						for si, span := range tab.Spans {
							@ui.CardStack(span) {
								for _, c := range tab.Cards {
									if c.Stack == si {
										@sysCardView(p, c)
									}
								}
							}
						}
					}
				</div>
			}
			@ui.SaveBar(p.Base + snapPath)
		</form>
	</div>
	<form id="db-dl" data-no-busy method="post" action={ templ.SafeURL(p.Base + sysPath + "/snapshot") }>
		<input type="hidden" name="csrf" value={ p.CSRF }/>
	</form>
	if len(p.DB.Files) > 0 {
		@backupDeleteDialog(backupsView{CSRF: p.CSRF})
	}
	if p.NeedStepUp {
		@ui.StepUp(p.StepUp)
	}
}

// sysCardView is one card of a tab's grid. The Backups storage and deleted-device cards hold
// read-only data; every other card holds the fields its definition names.
templ sysCardView(p sysPage, c sysCard) {
	switch c.ID {
		case "lastrun":
			if p.Fleet != nil {
				@fleetLastRun(p, c)
			}
		case "devices":
			if p.Fleet != nil {
				@fleetDevices(p, c)
			}
		case "storage":
			if p.Fleet != nil {
				@fleetStorage(p, c)
			}
		case "orphans":
			if p.Storage != nil {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: "Own list with its own delete action, outside the settings form.", Class: ui.StackRank(c.Phone), Plain: true}) {
					if len(p.Storage.Orphans) == 0 {
						<p class="ufield-help">No backups of deleted devices.</p>
					} else {
						if p.Fleet != nil && !p.Fleet.Admin {
							<p class="ufield-help">Kept when their device was deleted. You can keep or release them; admins download or delete them.</p>
						} else {
							<p class="ufield-help">Kept when their device was deleted. Download one to restore it on a device by hand.</p>
						}
						@sysOrphans(p, *p.Storage)
					}
				}
			}
		case "unreferenced":
			if p.Storage != nil && len(p.Storage.Unreferenced) > 0 {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: "Files in old backup folders that no backup entry points to. TasmoFleet leaves them alone; you can remove them by hand.", Class: ui.StackRank(c.Phone), Plain: true}) {
					@sysUnreferencedFiles(*p.Storage)
				}
			}
		case "download":
			if p.DB != nil {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: "Acts at once, outside the schedule form. Every download is written to the audit log.", Class: ui.StackRank(c.Phone), Plain: true}) {
					@sysDownloadBlock(p, *p.DB)
				}
			}
		case "stored":
			if p.DB != nil {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, NoteHTML: sysStoredNote(*p.DB), Class: ui.StackRank(c.Phone), Plain: true}) {
					@sysStoredBlock(*p.DB)
				}
			}
		case "restore":
			if p.DB != nil {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: c.Note, Class: ui.StackRank(c.Phone), Plain: true}) {
					@sysRestoreBlock(*p.DB)
				}
			}
		default:
			if len(c.Rows) > 0 || c.ID == "mqttdiscovery" || c.ID == "notify-message" || c.ID == "notify-browser" {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: c.Note, NoteHTML: sysCardNote(p, c), Class: ui.StackRank(c.Phone), Depends: c.Depends, Badges: sysCardBadges(c)}) {
					if c.ID == "mqttdiscovery" {
						@sysDiscoveryCard(p)
					}
					if c.ID == "credentials" {
						<div class="sf w-xs">
							<div class="lrow"><span class="lbl">Web user</span></div>
							<div class="in ro mono">admin</div>
							<small class="ufield-help">Fixed by Tasmota.</small>
						</div>
					}
					for _, row := range c.Rows {
						@sysRowView(p, row)
						if c.ID == "idp" && row.Key == "OIDC_ISSUER" {
							@sysTestRow("Test discovery", p.Base+sysPath+"/sso-test?tab=signin", "SSO check", p.SSOResult, "Saves nothing.", "")
						}
					}
					if c.ID == "schedule" && p.Fleet != nil {
						@fleetScheduleNote(*p.Fleet)
					}
					if c.ID == "snapshots" && p.DB != nil {
						@sysSnapshotStatus(*p.DB)
					}
					if c.ID == "mode" {
						<p class="ufield-help">Needs PUBLIC_URL. The local admin always works as a fallback.</p>
					}
					if c.ID == "mqttdiscovery" && p.Discovery.Link {
						<div class="sys-card-foot">
							@ui.Button(ui.Btn{Label: "Open Discovered", Href: p.Base + "/devices/new#card-discovered"})
						</div>
					}
					if c.ID == "scan" {
						<p class="ufield-help scan-nets">Scans only inside the <a href={ templ.SafeURL(p.Base + sysPath + "?tab=network#card-networks") } data-sys-goto="network">device networks</a> (Network & devices).</p>
					}
					if c.ID == "broker" && p.MQTT.Legacy == "" {
						@sysTestRow("Test connection", p.Base+sysPath+"/mqtt-test?tab=mqtt", "MQTT connection test", p.MQTTResult, "Saves nothing.", "")
					}
					if c.ID == "notify-browser" {
						@sysBrowserNotify()
					}
					if c.ID == "notify-message" {
						<div class="sf w-full">
							<div class="sf-main">
								<pre class="sys-pre">{ p.Notify.Preview }</pre>
								<small class="ufield-help">The whole webhook request: request line, headers and body (the secret header is not shown). The e-mail uses the title as subject and the text as body, with the link when PUBLIC_URL is set.</small>
							</div>
						</div>
					}
					if c.ID == "notify-webhook" && p.Notify.On {
						@sysChannelStatus(p.Notify.Webhook)
						@sysTestRow("Send test", p.Base+sysPath+"/notify-test/webhook?tab=notifications", "Webhook test", p.Notify.WebhookResult, webhookTestHelp, sysDependsOn("NOTIFY_WEBHOOK"))
					}
					if c.ID == "notify-email" && p.Notify.On {
						@sysChannelStatus(p.Notify.Email)
						@sysTestRow("Send test", p.Base+sysPath+"/notify-test/email?tab=notifications", "E-mail test", p.Notify.EmailResult, emailTestHelp, sysDependsOn("NOTIFY_SMTP"))
					}
				}
			}
	}
}

// sysBrowserNotify is the browser-notification control (#540). The state is the browser's, so the
// server draws a neutral frame and notify.js fills in the status and shows the buttons that fit.
// Without scripts the frame stays as it is.
templ sysBrowserNotify() {
	<div class="sf w-full" data-bn>
		<div class="sys-status">
			<span class="sys-status-dot t-neutral" aria-hidden="true" data-bn-dot></span>
			<div class="sys-status-text">
				<b data-bn-title>Needs JavaScript</b>
				<span data-bn-text>Browser notifications are set up on this page with scripts on.</span>
			</div>
		</div>
		<div class="sys-test">
			<button type="button" class="btn" data-bn-enable hidden>Enable browser notifications</button>
			<button type="button" class="btn" data-bn-test hidden>Send test</button>
			<button type="button" class="btn" data-bn-disable hidden>Turn off</button>
		</div>
	</div>
}

// sysRowView draws one setting in the control its kind calls for, then the settings that depend
// on it, together in one group the page dims while the switch is off.
templ sysRowView(p sysPage, row sysRow) {
	switch {
		case row.Locked:
			@sysLocked(row)
		case row.Key == "MQTT_URL" && p.MQTT.Legacy == "":
			@sysBroker(p, row)
		case row.Bool:
			@sysSwitch(row)
		default:
			@sysInput(row)
	}
	if row.Key == "MQTT_URL" && p.MQTT.Legacy != "" {
		@sysKeepLegacy(p)
	}
	if len(row.Deps) > 0 {
		<div class="dep" data-depends={ sysDependsOn(row.Key) }>
			for _, d := range row.Deps {
				switch d.Key {
					case "NOTIFY_SMTP_HOST":
						@sysSMTPServer(row.Deps)
					case "NOTIFY_SMTP_PORT", "NOTIFY_SMTP_SECURITY":
						// drawn with the host
					default:
						@sysRowView(p, d)
				}
			}
		</div>
	}
}

// sysFieldData is the label row and help of a setting; the card's restart badge replaces the
// field's own.
func sysFieldData(row sysRow) ui.SettingFieldData {
	c := sysFieldCopy(row.Key)
	return ui.SettingFieldData{Key: row.Key, Label: sysLabel(row), Width: c.Width, Help: c.Help, Info: c.Info, Err: row.Err,
		Notice: sysNotice(row), Pending: row.PendingRestart,
		Restart: row.Apply != sysconfig.Live && !row.InRestartCard, CanReset: sysCanReset(row), Default: sysDefault(row), Locked: row.Locked}
}

// sysInput is a text, number, password, list or choice setting.
templ sysInput(row sysRow) {
	@ui.SettingField(sysFieldDataGroup(row)) {
		switch {
			case row.Key == "LOG_LEVEL":
				@ui.Segmented(row.Label, row.InputName(), sysLevelOptions(row.Posted))
			case row.Key == "AUTH_MODE":
				@ui.RadioCards(row.Label, row.InputName(), sysAuthOptions(row.Posted))
			case sysSegmentedEnum(row.Key):
				@ui.Segmented(row.Label, row.InputName(), sysEnumOptions(row))
			case row.Key == "BACKUP_DAYS":
				@sysDayChips(row, "Backup days")
			case row.Key == "SNAPSHOT_DAYS":
				@sysDayChips(row, "Snapshot days")
			case len(row.Choices) > 0:
				<div class="cks" role="group" aria-label={ row.Label }>
					<input type="hidden" name={ "m." + row.Key } value="1"/>
					for _, c := range row.Choices {
						<label class="ucheck"><input type="checkbox" name={ row.InputName() } value={ c } checked?={ slices.Contains(sysChecked(row), c) }/><span>{ c }</span></label>
					}
				</div>
			case row.Key == "BACKUP_TIME" || row.Key == "SNAPSHOT_TIME":
				<input type="time" name={ row.InputName() } id={ ui.SettingControlID(row.Key) } class="mono" value={ row.Posted } step="60" required { sysDescribe(row)... }/>
			case row.Secret:
				<input type="password" name={ row.InputName() } id={ ui.SettingControlID(row.Key) } class="mono" autocomplete="new-password" maxlength={ sysSecretMax(row) } placeholder={ sysSecretHint(row) } { sysDescribe(row)... }/>
			case len(row.Enum) > 0:
				<select name={ row.InputName() } id={ ui.SettingControlID(row.Key) } { sysDescribe(row)... }>
					for _, o := range row.Enum {
						<option value={ o } selected?={ o == row.Posted }>{ sysEnumLabel(row.Key, o) }</option>
					}
				</select>
			case row.Multiline:
				<textarea name={ row.InputName() } id={ ui.SettingControlID(row.Key) } class="mono" rows="3" maxlength="2048" placeholder={ sysPlaceholder(row) } { sysDescribe(row)... }>{ row.Posted }</textarea>
			default:
				<input name={ row.InputName() } id={ ui.SettingControlID(row.Key) } class="mono" value={ row.Posted } maxlength="512" placeholder={ sysPlaceholder(row) } { sysDescribe(row)... }/>
		}
	}
}

// sysSwitch is an on/off setting. The b.KEY marker says the switch was on the page, so "off" is saved.
templ sysSwitch(row sysRow) {
	@ui.SettingField(sysSwitchData(row)) {
		<input type="hidden" name={ "b." + row.Key } value="1"/>
		<label class="swhit"><input type="checkbox" role="switch" id={ ui.SettingControlID(row.Key) } name={ row.InputName() } value="true" checked?={ row.Posted == "true" } { sysDescribe(row)... }/><span class="swtrack" aria-hidden="true"></span></label>
	}
}

// sysDayChips is the weekday choice of a schedule (label: the group's name for a screen reader): one chip
// per day, Monday first. The chips are plain checkboxes in a group, so they work without JavaScript and by
// keyboard; none ticked is manual only (backups) or off (snapshots).
templ sysDayChips(row sysRow, label string) {
	<div class="cks chips" role="group" aria-label={ label }>
		<input type="hidden" name={ "m." + row.Key } value="1"/>
		for _, c := range row.Choices {
			<label class="ucheck chip"><input type="checkbox" name={ row.InputName() } value={ c } checked?={ slices.Contains(sysChecked(row), c) }/><span>{ dayLabels[c] }<span class="sr-only">{ " " + dayFull[c] }</span></span></label>
		}
	</div>
}

// sysLocked is a setting the container configuration fixes: no control, the Environment badge and
// the key to change it by. Secrets show only whether a value is set.
templ sysLocked(row sysRow) {
	@ui.SettingField(ui.SettingFieldData{Key: row.Key, Label: sysLabel(row), Width: sysFieldCopy(row.Key).Width, Info: sysFieldCopy(row.Key).Info,
		Help: row.Key + " in the container configuration.", Locked: true, Switch: false}) {
		if row.Secret {
			<div class="in ro mono">{ sysSetWord(row.HasValue) }</div>
		} else {
			<div class="in ro mono">{ row.Value }</div>
		}
	}
}

// sysBroker is MQTT_URL as the Broker host, port and TLS in one row (N18).
templ sysBroker(p sysPage, row sysRow) {
	<div class="brow">
		@ui.SettingField(ui.SettingFieldData{Key: row.Key, Label: "Host", Width: "grow", Err: row.Err, CanReset: row.Source == "stored"}) {
			<input name="mqtt.host" id={ ui.SettingControlID(row.Key) } class="mono" value={ p.MQTT.Host } maxlength="255" placeholder="empty: MQTT off" { sysDescribe(row)... }/>
		}
		<div class="sf w-port">
			<div class="lrow"><label class="lbl" for="f-mqtt-port">Port</label></div>
			<input name="mqtt.port" id="f-mqtt-port" class="mono" value={ p.MQTT.Port } inputmode="numeric" maxlength="5" placeholder="1883"/>
		</div>
		<div class="sf w-tls">
			<div class="lrow"><span class="lbl">TLS</span></div>
			<div class="sf-switch tlsrow">
				<label class="swhit"><input type="checkbox" role="switch" id="f-mqtt-tls" name="mqtt.tls" value="1" checked?={ p.MQTT.TLS }/><span class="swtrack" aria-hidden="true"></span></label>
				<div class="sf-main"><div class="lrow"><label class="lbl" for="f-mqtt-tls">Use TLS</label></div></div>
			</div>
		</div>
	</div>
	if p.MQTT.HasPassword {
		<label class="ucheck sopt bkeep" data-broker-keep data-stored-host={ p.MQTT.StoredHost } data-stored-port={ p.MQTT.StoredPort }><input type="checkbox" name="reuse.MQTT_PASSWORD" value="1" checked?={ p.MQTT.KeepTicked }/><span>Broker changed: keep the stored password for the new broker</span></label>
	}
}

// sysSMTPServer is the mail server in one row: host, port and security, like the MQTT broker.
templ sysSMTPServer(rows []sysRow) {
	<div class="brow">
		for _, key := range []string{"NOTIFY_SMTP_HOST", "NOTIFY_SMTP_PORT", "NOTIFY_SMTP_SECURITY"} {
			@sysInput(sysNoReset(sysRowOf(rows, key)))
		}
	</div>
}

// sysChannelStatus is the status line of a notification channel: its last delivery or test, or why it is not set up.
templ sysChannelStatus(ch sysChannel) {
	<div class="sys-status">
		<span class={ "sys-status-dot", "t-" + ch.Tone } aria-hidden="true"></span>
		<div class="sys-status-text">
			<b>{ ch.Title }</b>
			<span>
				{ ch.Lead }
				if !ch.At.IsZero() {
					<time { ui.StampAttrs(ch.At, ui.StampStore)... }>{ storeDate(time.Now(), ch.At) }</time>
				}
				{ ch.Tail }
			</span>
		</div>
	</div>
}

// sysKeepLegacy is the keep option under the single broker URL field, which has no host and port
// to compare: always visible.
templ sysKeepLegacy(p sysPage) {
	if p.MQTT.HasPassword {
		<label class="ucheck sopt bkeep"><input type="checkbox" name="reuse.MQTT_PASSWORD" value="1" checked?={ p.MQTT.KeepTicked }/><span>Broker changed: keep the stored password for the new broker</span></label>
	}
}

// sysSumLink is a total that opens the list of what it counts (the whole tile is the link).
templ sysSumLink(label, value, href string) {
	<a class="sys-sum" href={ templ.SafeURL(href) }>
		<div class="sys-sum-label">{ label }</div>
		<div class="sys-sum-value">{ value }</div>
	</a>
}

templ sysSum(label, value string) {
	<div class="sys-sum">
		<div class="sys-sum-label">{ label }</div>
		<div class="sys-sum-value">{ value }</div>
	</div>
}

// sysOrphans lists the backups of deleted devices (kept when the device was deleted, N2):
// Download, Keep and Delete as on a device's Backups tab. The Keep buttons submit the
// bk-orph form outside the settings form; Delete opens the shared delete dialog.
templ sysOrphans(p sysPage, st sysStorage) {
	<div class="sys-orphans">
		for _, o := range st.Orphans {
			<div class="sys-orphan">
				<div class="sys-orphan-main">
					<div class="sys-orphan-title">
						<span class="sys-store-name">{ orphanName(o) }</span>
						if o.Kept {
							@ui.Badge(ui.ToneAccent, "Kept")
						}
						if o.Missing {
							@ui.Badge(ui.ToneDanger, "File missing")
						}
					</div>
					<div class="sys-orphan-detail">
						if o.MAC != "" {
							<span class="mono">{ o.MAC }</span>{ " · " }
						}
						<time { ui.StampAttrs(o.Taken, ui.StampShort)... }>{ ui.StampText(o.Taken, ui.StampShort) }</time>{ " · " + o.Size }
					</div>
				</div>
				<div class="bk-acts">
					if st.CanKeep {
						if o.Kept {
							<button type="submit" form="bk-orph" formaction={ templ.SafeURL(p.Base + "/backups/" + bkStr(o.ID) + "/keep") } name="kept" value="0" class="btn bk-keep is-kept" aria-pressed="true" title="Kept: the retention never prunes it. Click to release it.">
								<span class="bk-pin" aria-hidden="true"></span>Kept
							</button>
						} else {
							<button type="submit" form="bk-orph" formaction={ templ.SafeURL(p.Base + "/backups/" + bkStr(o.ID) + "/keep") } name="kept" value="1" class="btn bk-keep" aria-pressed="false" title="Keep this backup: the retention never prunes it.">
								<span class="bk-pin" aria-hidden="true"></span>Keep
							</button>
						}
					}
					if o.Download != "" {
						<a class="btn" href={ templ.SafeURL(o.Download) }>Download</a>
					}
					if o.DeleteText != "" {
						<a
							class="btn btn-danger bk-del"
							href={ templ.SafeURL(p.Base + "/backups/" + bkStr(o.ID) + "/delete") }
							data-dialog="dlg-bkdel"
							data-dlg-title="Delete this backup?"
							data-dlg-text={ o.DeleteText } data-dlg-at={ ui.StampISO(o.Taken) } data-dlg-ts={ ui.StampDateTimeSec.Key } data-dlg-shown={ ui.StampText(o.Taken, ui.StampDateTimeSec) }
							data-dlg-action={ p.Base + "/backups/" + bkStr(o.ID) + "/delete" }
							data-dlg-verb="Delete backup"
						>Delete</a>
					}
				</div>
			</div>
		}
	</div>
}

// sysUnreferencedFiles lists files in old backup folders that no backup entry points to
// (#205). Read-only on purpose: TasmoFleet never deletes or moves them.
templ sysUnreferencedFiles(st sysStorage) {
	<div class="sys-orphans">
		for _, f := range st.Unreferenced {
			<div class="sys-orphan sys-unref">
				<div class="sys-orphan-main">
					<div class="sys-orphan-title">
						<span class="sys-store-name mono" title={ f.Path }>{ f.Path }</span>
					</div>
					<div class="sys-orphan-detail">
						{ f.Size + " · " }<time { ui.StampAttrs(f.Modified, ui.StampShort)... }>{ ui.StampText(f.Modified, ui.StampShort) }</time>
					</div>
				</div>
			</div>
		}
	</div>
}

// sysSnapshotStatus is the schedule's note and the last scheduled snapshot under it: green when it
// worked, red with the day of the failure when it did not, a warning when a time was skipped because
// TasmoFleet was down. No status while the schedule is off.
templ sysSnapshotStatus(db sysDB) {
	<div class="sf w-full">
		@sysScheduleNote(db.Zone, db.On, db.Now, db.Status.Next)
	</div>
	if db.On {
		if !db.Missed.IsZero() {
			<div class="sys-status">
				<span class="sys-status-dot t-warn" aria-hidden="true"></span>
				<div class="sys-status-text">
					<b>A scheduled snapshot was skipped</b>
					<span>TasmoFleet was not running at the scheduled time and was back more than 60 minutes late, so the snapshot was not made up. Noticed <time { ui.StampAttrs(db.Missed, ui.StampDay)... }>{ ui.StampDayText(db.Now, db.Missed) }</time>. The next one is as scheduled.</span>
				</div>
			</div>
		}
		switch db.Status.State {
			case "fail":
				<div class="sys-status st-fail">
					<span class="sys-status-dot t-danger" aria-hidden="true"></span>
					<div class="sys-status-text">
						<b>Last attempt failed, <time { ui.StampAttrs(db.Status.Attempt, ui.StampStore)... }>{ storeDate(time.Now(), db.Status.Attempt) }</time></b>
						<span>
							if !db.Status.Taken.IsZero() {
								Last good snapshot <time { ui.StampAttrs(db.Status.Taken, ui.StampStore)... }>{ storeDate(time.Now(), db.Status.Taken) }</time>
							} else {
								No good snapshot yet
							}
						</span>
					</div>
				</div>
			case "ok":
				<div class="sys-status st-on">
					<span class="sys-status-dot t-ok" aria-hidden="true"></span>
					<div class="sys-status-text">
						<b>Last snapshot <time { ui.StampAttrs(db.Status.Taken, ui.StampStore)... }>{ storeDate(time.Now(), db.Status.Taken) }</time></b>
						<span>{ strconv.Itoa(db.Status.Count) + " of " + strconv.Itoa(db.Kept) + " kept" }</span>
					</div>
				</div>
			default:
				<div class="sys-status">
					<span class="sys-status-dot t-neutral" aria-hidden="true"></span>
					<div class="sys-status-text">
						<b>No snapshot taken yet</b>
						<span>The first one is taken at the next scheduled time.</span>
					</div>
				</div>
		}
	}
	<p class="ufield-help db-note">Stored in the data directory (<span class="mono">{ db.Dir }</span>), so the host backup of <span class="mono">{ db.DataDir }</span> covers them. They sit on the same disk as the database: they protect against a bad upgrade or a deleted row, not against a dead disk.</p>
}

// sysDownloadBlock is the "Download a snapshot" card: the download (a form outside the settings form,
// "db-dl"), what the file holds and the failure of the last scheduled snapshot.
templ sysDownloadBlock(p sysPage, db sysDB) {
	<div class="sys-test">
		<button type="submit" form="db-dl" class="btn" id="btn-dl" autofocus?={ db.FocusDownload }>Download snapshot</button>
		<label class="db-incl"><input type="checkbox" form="db-dl" name="include_key" value="1" checked?={ db.KeepKey }/> Include <span class="mono">secret.key</span> (as .tar)</label>
		<span class="sys-test-help">{ db.Hint }</span>
	</div>
	<div class="notice plain db-contents" role="note">
		<b>The file holds secrets. Keep it like a password.</b>
		<ul class="db-list">
			<li><b>Inside:</b> devices, groups, settings, users with their password hashes, sessions, audit log and the backup index.</li>
			<li><b>Encrypted inside:</b> device HTTP and MQTT passwords, the default device password, the MQTT broker password, the OIDC client secret and refresh tokens, the metrics token, the notification webhook header value and SMTP password. The key is <span class="mono">secret.key</span> and it is <b>not</b> in the database file: without it these values cannot be read, with it they can.</li>
			<li><b>Not inside:</b> device backup files (.dmp), the firmware cache, <span class="mono">secret.key</span> (unless ticked above).</li>
		</ul>
	</div>
	if db.Status.State == "fail" {
		<div class="st-fail">
			<div class="error" role="alert">
				<b>The last scheduled snapshot failed.</b>
				<time { ui.StampAttrs(db.Status.Attempt, ui.StampStore)... }>{ storeDate(time.Now(), db.Status.Attempt) }</time>: could not write <span class="mono">{ db.Dir + "/" + db.Status.File }</span> ({ db.Status.Reason }). Nothing was deleted.
				if !db.Status.Next.IsZero() {
					The next attempt is <time { ui.StampAttrs(db.Status.Next, ui.StampStore)... }>{ storeDate(time.Now(), db.Status.Next) }</time>;
				}
				<a href={ templ.SafeURL(p.Base + "/audit") }>see the audit log</a>.
			</div>
		</div>
	}
}

// sysStoredNote is the note of the "Stored snapshots" card: where they are kept.
templ sysStoredNote(db sysDB) {
	Newest first, in <span class="mono">{ db.Dir }</span>. Delete acts at once.
}

// sysCardNote is the note of a settings card that holds a link: the snapshot schedule names the place
// where the failure message is set. Nil for every other card.
func sysCardNote(p sysPage, c sysCard) templ.Component {
	if c.ID != "snapshots" {
		return nil
	}
	return sysSnapshotScheduleNote(p.Base + sysPath + "?tab=notifications")
}

templ sysSnapshotScheduleNote(href string) {
	Every scheduled snapshot is written to the audit log. The failure message is set under <a href={ templ.SafeURL(href) }>Settings → Notifications</a>.
}

// sysStoredBlock is the stored snapshots with Download and Delete.
templ sysStoredBlock(db sysDB) {
	if db.ListErr != "" {
		<div class="error" role="alert">{ db.ListErr }</div>
	} else if len(db.Files) == 0 {
		<p class="ufield-help">No snapshots yet. Choose days on the schedule on the right, or download one now. Downloads are not kept on the server.</p>
	} else {
		<div class="sys-orphans">
			for _, f := range db.Files {
				<div class="sys-orphan">
					<div class="sys-orphan-main">
						<div class="sys-orphan-title">
							<span class="sys-store-name mono">{ f.Name }</span>
							if f.Latest {
								@ui.Badge(ui.ToneOK, "Latest")
							}
						</div>
						<div class="sys-orphan-detail">
							<time { ui.StampAttrs(f.Taken, ui.StampStore)... }>{ storeDate(time.Now(), f.Taken) }</time>{ " · " + f.Size }
							if f.Schema > 0 {
								{ " · schema " + strconv.Itoa(f.Schema) }
							}
						</div>
					</div>
					<div class="bk-acts">
						<a class="btn" href={ templ.SafeURL(f.Download) }>Download</a>
						<a
							class="btn btn-danger bk-del"
							href={ templ.SafeURL(f.Delete) }
							data-dialog="dlg-bkdel"
							data-dlg-title="Delete this snapshot?"
							data-dlg-text={ snapDeleteText(f.Name) }
							data-dlg-action={ f.Delete }
							data-dlg-verb="Delete snapshot"
						>Delete</a>
					</div>
				</div>
			}
		</div>
	}
}

// sysRestoreBlock is how to restore a snapshot. There is no restore button on purpose.
templ sysRestoreBlock(db sysDB) {
	<ol class="db-restore">
		<li>Stop the container.</li>
		<li>Replace <span class="mono">{ db.DataDir + "/tasmofleet.db" }</span> with the snapshot and delete <span class="mono">tasmofleet.db-wal</span> and <span class="mono">tasmofleet.db-shm</span>.</li>
		<li>Make sure <span class="mono">{ db.DataDir + "/secret.key" }</span> is the one from the same time, then start the container.</li>
	</ol>
	<p class="ufield-help">There is no restore button on purpose. A snapshot from an older version is migrated at start; one from a newer version is refused. The <span class="mono">tasmofleet.db.pre-N</span> copies made before an upgrade are restored the same way.</p>
}

// sysResetBox is "Reset all settings" at the end of the Advanced tab (N9). The button opens
// the dialog; without JavaScript its link leads to the confirmation page.
templ sysResetBox(p sysPage) {
	<div class="sys-danger">
		<div>
			<div class="sys-danger-title">Reset all settings</div>
			<div class="sys-danger-text">Devices, backups and users are kept.</div>
		</div>
		<a class="btn btn-danger-solid" href={ templ.SafeURL(p.Base + sysPath + "/reset") } data-dialog="dlg-reset">Reset settings…</a>
	</div>
}

// sysTestRow is a test button of the form (it posts the whole form, saves nothing) with its
// result next to it. With scripts it swaps only this row, so a password typed into the form is
// still there for the save that follows (a secret is never rendered back); without scripts it
// posts the form and the page reloads. A failure in the danger tone as an alert, a success as a status.
// depends names the form control of the switch the test needs (sysDependsOn); sysform.js dims the row
// and makes it inert while that switch is off, so a channel that is off cannot be tested (#471).
templ sysTestRow(label, action, what, result, help, depends string) {
	<div class="sys-test" { sysDependsAttrs(depends)... }>
		<button type="submit" class="btn" formaction={ templ.SafeURL(action) } formnovalidate hx-post={ action } hx-include="#sysform" hx-target="closest .sys-test" hx-swap="outerHTML">{ label }</button>
		if result != "" {
			if testNote(what, result).Failed {
				<span class="sys-test-res t-danger" role="alert">{ what }: { result }</span>
			} else {
				<span class="sys-test-res t-ok" role="status">{ what }: { result }</span>
			}
		} else {
			<span class="sys-test-help">{ help }</span>
		}
	</div>
}

// sysDiscoveryCard is the status of MQTT discovery on top of the Discovery tab.
templ sysDiscoveryCard(p sysPage) {
	<div class="sys-status">
		<span class={ "sys-status-dot", "t-" + p.Discovery.Tone } aria-hidden="true"></span>
		<div class="sys-status-text">
			<b>{ p.Discovery.Title }</b>
			<span>
				{ p.Discovery.Text }
				if p.Discovery.Waiting > 0 {
					{ " · " + plural(p.Discovery.Waiting, "new device") + " waiting" }
				}
			</span>
		</div>
	</div>
}

// sysContainer lists the bootstrap settings, which only the container configuration sets: full
// width, always visible, as two tables side by side (the first half of the list on the left).
// On a phone they stack.
templ sysContainer(rows []sysconfig.Row) {
	@ui.CardStacks(1) {
	@ui.CardStack(ui.SpanAll) {
	@ui.SettingsCard(ui.SettingsCardData{ID: "card-container", Title: "Set by the container", Note: "Read-only. Change them in the container configuration.", Plain: true}) {
	<p class="ucard-sub">Bootstrap settings (listeners, TLS, keys) come from the container configuration only and are never editable here.</p>
	<div class="cset">
		@sysContainerTable(rows[:(len(rows)+1)/2])
		@sysContainerTable(rows[(len(rows)+1)/2:])
	</div>
	}
	}
	}
}

templ sysContainerTable(rows []sysconfig.Row) {
	<div class="table-scroll">
		<table class="dense">
			<thead><tr><th>Key</th><th>Value</th></tr></thead>
			<tbody>
				for _, kv := range rows {
					<tr>
						<td data-label="Key" class="p1"><code>{ kv.Key }</code></td>
						<td data-label="Value" class="s grow">
							if kv.Value != "" {
								<code>{ kv.Value }</code>
							} else {
								<span class="muted">empty</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
