package web

import (
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/hellwand/tasmofleet/internal/sysconfig"
	"github.com/hellwand/tasmofleet/internal/web/ui"
)

// sysSettingsPage is System settings: the page header, eight tabs (all in one form, shown one at a
// time), a grid of cards per tab and one save bar. The danger zone and the container list sit
// after the form. The fields are the real settings of sysconfig.
templ sysSettingsPage(p sysPage) {
	@ui.PageHeader("Settings", "Applies to the whole TasmoFleet instance")
	<label class="sys-picker" data-sys-picker hidden>
		<span>Section</span>
		<select aria-label="Settings section">
			for _, tab := range p.Tabs {
				<option value={ tab.Slug } selected?={ tab.Slug == p.Active }>{ tab.Label }</option>
			}
		</select>
	</label>
	@ui.Tabs("Settings sections", sysTabLinks(p))
	if p.Error != "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: p.Error, Alert: true})
	}
	if len(p.Pending) > 0 {
		@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Title: "Restart required.", Text: "The stored value of " + strings.Join(p.Pending, ", ") + " applies after the next restart of the container."})
	}
	if p.CannotStepUp {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Alert: true, Text: "This account cannot confirm its identity. Settings that need a confirmation (" + strings.Join(sysEnvNames(p.StepUpKeys), ", ") + ") cannot be confirmed from this session and must be set in the container configuration."})
	}
	if len(p.Skipped) > 0 {
		<div class="banner tone-warn" role="status">
			<span class="banner-dot"></span>
			<div class="banner-text">
				<b>Stored values that are ignored.</b>
				<ul class="sys-skipped">
					for _, k := range sortedKeys(p.Skipped) {
						<li><code>{ k }</code>: { p.Skipped[k] }</li>
					}
				</ul>
			</div>
		</div>
	}
	<div class="syswrap">
	<form id="sysform" class="syspage" data-keep-draft="sysconfig" method="post" action={ templ.SafeURL(p.Base + sysTabPath(p.Active)) }>
		<input type="hidden" name="csrf" value={ p.CSRF }/>
		for _, tab := range p.Tabs {
			<div class="sys-tab" id={ "sec-" + tab.Slug } data-sys-tab={ tab.Slug } hidden?={ tab.Slug != p.Active }>
				if tab.Slug == "mqtt" {
					if p.MQTT.ACLOpen {
						@ui.BrokerACLNotice()
					} else if p.MQTT.Off {
						<p class="ufield-help sys-mqtt-off">MQTT is off. Enter a broker host to turn it on.</p>
					}
				}
				@ui.CardStacks(3) {
					for si, span := range tab.Spans {
						@ui.CardStack(span) {
							for _, c := range tab.Cards {
								if c.Stack == si {
									@sysCardView(p, c)
								}
							}
						}
					}
				}
			</div>
		}
		@ui.SaveBar(ui.SaveBarData{Discard: p.Base + sysTabPath(p.Active), WhileDirty: !p.Posted})
	</form>
	<div class="sys-after" id="after-advanced" data-sys-tab="advanced" hidden?={ p.Active != "advanced" }>
		@sysContainer(p.ReadOnly)
		@sysResetBox(p)
	</div>
	</div>
	@ui.Dialog(ui.DialogData{ID: "dlg-reset", Title: "Reset all settings?", Body: sysResetText,
		Action: p.Base + sysPath + "/reset", CSRF: p.CSRF, Verb: "Reset settings", Danger: true})
	if len(p.Notify.Push.Rows) > 0 {
		@backupDeleteDialog(backupsView{CSRF: p.CSRF})
	}
	if p.PW != nil && p.PW.CanBulk {
		@pwBrokerDialog(p)
	}
	if p.NeedStepUp {
		@ui.StepUp(p.StepUp)
	}
}

// snapshotsPage is System -> Snapshots (admins): the database snapshot download, the stored snapshots,
// the schedule (saved through the page's own save bar) and how to restore. The settings are the
// snapshot tab of sysLayout, the same fields and the same save as on the Settings page.
templ snapshotsPage(p sysPage) {
	@ui.PageHeader("Snapshots", "Copies of TasmoFleet’s own database. Device backups are a separate thing.")
	if p.Error != "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: p.Error, Alert: true})
	}
	if p.DB != nil && p.DB.Warn != "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Text: p.DB.Warn, Alert: true})
	}
	<div class="syswrap">
		<form id="sysform" class="syspage" data-keep-draft="snapshots" method="post" action={ templ.SafeURL(p.Base + snapPath) }>
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			for _, tab := range p.Tabs {
				<div class="sys-tab" id={ "sec-" + tab.Slug } data-sys-tab={ tab.Slug }>
					@ui.CardStacks(3) {
						for si, span := range tab.Spans {
							@ui.CardStack(span) {
								for _, c := range tab.Cards {
									if c.Stack == si {
										@sysCardView(p, c)
									}
								}
							}
						}
					}
				</div>
			}
			@ui.SaveBar(ui.SaveBarData{Discard: p.Base + snapPath, WhileDirty: !p.Posted})
		</form>
	</div>
	<form id="db-dl" data-no-busy method="post" action={ templ.SafeURL(p.Base + sysPath + "/snapshot") }>
		<input type="hidden" name="csrf" value={ p.CSRF }/>
	</form>
	if p.DB.CanCreate {
		<form id="db-snap" method="post" action={ templ.SafeURL(p.Base + snapPath + "/create") }>
			<input type="hidden" name="csrf" value={ p.CSRF }/>
		</form>
	}
	if len(p.DB.Files) > 0 {
		@backupDeleteDialog(backupsView{CSRF: p.CSRF})
	}
	if p.NeedStepUp {
		@ui.StepUp(p.StepUp)
	}
}

// sysCardView is one card of a tab's grid. The Backups storage and deleted-device cards hold
// read-only data; every other card holds the fields its definition names.
templ sysCardView(p sysPage, c sysCard) {
	switch c.ID {
		case "lastrun":
			if p.Fleet != nil {
				@fleetLastRun(p, c)
			}
		case "devices":
			if p.Fleet != nil {
				@fleetDevices(p, c)
			}
		case "storage":
			if p.Fleet != nil {
				@fleetStorage(p, c)
			}
		case "orphans":
			if p.Storage != nil {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Class: ui.StackRank(c.Phone), Plain: true}) {
					if len(p.Storage.Orphans) == 0 {
						<p class="ufield-help">No backups of deleted devices.</p>
					} else {
						<div class="bk-bar">
							<div class="bk-retention"><b>{ orphanSummary(*p.Storage) + "." }</b>
								if p.Fleet != nil && !p.Fleet.Admin {
									{ " Kept when their device was deleted. You can keep or release them; admins download or delete them." }
								} else {
									{ " Kept when their device was deleted. Download one to restore it on a device by hand." }
								}
							</div>
						</div>
						<details class="fold">
							<summary>Backups <span class="meta">{ strconv.Itoa(len(p.Storage.Orphans)) + " · " + p.Storage.OrphanSize }</span></summary>
							@sysOrphans(p, *p.Storage)
						</details>
					}
				}
			}
		case "unreferenced":
			if p.Storage != nil && len(p.Storage.Unreferenced) > 0 {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Class: ui.StackRank(c.Phone), Plain: true}) {
					<div class="bk-bar">
						<div class="bk-retention">
							{ plural(len(p.Storage.Unreferenced), "file") + " · " + p.Storage.UnrefSize + " in old backup folders that no backup entry points to. No backup and no restore point uses them." }
							if !p.Storage.CanBulk {
								{ " TasmoFleet leaves them alone; admins can delete them." }
							}
						</div>
						if p.Storage.CanBulk {
							<a class="btn" href={ templ.SafeURL(p.Base + unrefDeletePath) } data-dialog="dlg-unref">Delete all…</a>
						}
					</div>
					<details class="fold">
						<summary>Files <span class="meta">{ strconv.Itoa(len(p.Storage.Unreferenced)) }</span></summary>
						@sysUnreferencedFiles(*p.Storage)
					</details>
				}
			}
		case "topiccheck":
			if p.Topics != nil {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: c.Note, Class: ui.StackRank(c.Phone), Plain: true}) {
					@sysTopicCheck(*p.Topics)
				}
			}
		case "download":
			if p.DB != nil {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: "Acts at once, outside the schedule form. Every download is written to the audit log.", Class: ui.StackRank(c.Phone), Plain: true}) {
					@sysDownloadBlock(p, *p.DB)
				}
			}
		case "stored":
			if p.DB != nil {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, NoteHTML: sysStoredNote(*p.DB), Class: ui.StackRank(c.Phone), Plain: true}) {
					@sysStoredBlock(*p.DB)
				}
			}
		case "restore":
			if p.DB != nil {
				@ui.SettingsCard(ui.SettingsCardData{ID: "card-" + c.ID, Title: c.Title, Note: c.Note, Class: ui.StackRank(c.Phone), Plain: true}) {
					@sysRestoreBlock(*p.DB)
				}
			}
		default:
			if len(c.Rows) > 0 || c.ID == "mqttdiscovery" || c.ID == "notify-message" || c.ID == "notify-browser" || (c.ID == "notify-push" && p.Notify.Push.On) {
				@ui.SettingsCard(sysCardData(p, c)) {
					if c.ID == "mqttdiscovery" {
						@sysDiscoveryCard(p)
					}
					if c.ID == "credentials" {
						<div class="sf w-xs">
							<div class="lrow"><span class="lbl">Web user</span></div>
							<div class="in ro mono">admin</div>
							<small class="ufield-help">Fixed by Tasmota.</small>
						</div>
					}
					for _, row := range c.Rows {
						@sysRowView(p, row)
						if c.ID == "idp" && row.Key == "OIDC_ISSUER" {
							@sysTestRow("Test discovery", p.Base+sysPath+"/sso-test"+sysTabQuery("signin"), "SSO check", p.SSOResult, "Saves nothing.", "")
						}
					}
					if c.ID == "snapshots" && p.DB != nil {
						@sysSnapshotStatus(*p.DB)
					}
					if c.ID == "devicepasswords" && p.PW != nil {
						@sysPasswordsCard(p)
					}
					if c.ID == "mode" {
						<p class="ufield-help">Needs { sysEnvName("PUBLIC_URL") } in the container configuration. The local admin always works as a fallback.</p>
					}
					if c.ID == "mqttdiscovery" && p.Discovery.Link {
						<div class="sys-card-foot">
							@ui.Button(ui.Btn{Label: "Open Discovered", Href: p.Base + "/devices/new#card-discovered"})
						</div>
					}
					if c.ID == "scan" {
						<p class="ufield-help scan-nets">Scans only inside the <a href={ templ.SafeURL(p.Base + sysTabPath("network") + "#card-networks") } data-sys-goto="network">device networks</a> (Network & devices).</p>
					}
					if c.ID == "broker" && p.MQTT.Legacy == "" {
						@sysTestRow("Test connection", p.Base+sysPath+"/mqtt-test"+sysTabQuery("mqtt"), "MQTT connection test", p.MQTTResult, "Saves nothing.", "")
					}
					if c.ID == "notify-browser" {
						@sysBrowserNotify()
					}
					if c.ID == "notify-push" {
						@sysPushBlock(p.Notify.Push)
					}
					if c.ID == "notify-message" {
						<div class="sf w-full">
							<div class="sf-main">
								<pre class="sys-pre">{ p.Notify.Preview }</pre>
								<small class="ufield-help">The whole webhook request: request line, headers and body (the secret header is not shown). The e-mail uses the title as subject and the text as body, with the link when TASMOFLEET_PUBLIC_URL is set. Browser notifications and Web Push show the title and the text; a click opens the page in TasmoFleet.</small>
							</div>
						</div>
					}
					if c.ID == "notify-webhook" && p.Notify.On {
						@sysChannelStatus(p.Notify.Webhook)
						@sysTestRow("Send test", p.Base+sysPath+"/notify-test/webhook"+sysTabQuery("notifications"), "Webhook test", p.Notify.WebhookResult, webhookTestHelp, sysDependsOn("NOTIFY_WEBHOOK"))
					}
					if c.ID == "notify-email" && p.Notify.On {
						@sysChannelStatus(p.Notify.Email)
						@sysTestRow("Send test", p.Base+sysPath+"/notify-test/email"+sysTabQuery("notifications"), "E-mail test", p.Notify.EmailResult, emailTestHelp, sysDependsOn("NOTIFY_SMTP"))
					}
				}
			}
	}
}

// sysBrowserNotify is the browser-notification control (#540). The state is the browser's, so the
// server draws a neutral frame and notify.js fills in the status and shows the buttons that fit.
// Without scripts the frame stays as it is.
templ sysBrowserNotify() {
	<div class="sf w-full" data-bn>
		<div class="sys-status">
			<span class="sys-status-dot t-neutral" aria-hidden="true" data-bn-dot></span>
			<div class="sys-status-text">
				<b data-bn-title>Needs JavaScript</b>
				<span data-bn-text>Browser notifications are set up on this page with scripts on.</span>
			</div>
		</div>
		<div class="sys-test">
			<button type="button" class="btn" data-bn-enable hidden>Enable browser notifications</button>
			<button type="button" class="btn" data-bn-test hidden>Send test</button>
			<button type="button" class="btn" data-bn-disable hidden>Turn off</button>
		</div>
	</div>
}

// sysPushBlock is the Web Push card (#611): this browser's state, drawn by push.js (the state is the
// browser's), and the list of every subscribed browser, which is the server's and works without scripts.
// push.js reads the card's data-push-* attributes: the VAPID public key (not a secret), where to subscribe
// and where the service worker is (sw.js at the base path, so its scope is the whole app).
templ sysPushBlock(l sysPushList) {
	<div class="sf w-full" data-push data-push-key={ l.Key } data-push-sw={ l.Base + "/sw.js" } data-push-subscribe={ l.Base + sysPath + "/push/subscription" }>
		<div class="sys-status">
			<span class="sys-status-dot t-neutral" aria-hidden="true" data-push-dot></span>
			<div class="sys-status-text">
				<b data-push-title>Needs JavaScript</b>
				<span data-push-text>Subscribing this browser to Web Push is done on this page with scripts on. The list below works without them.</span>
			</div>
		</div>
		<div class="sys-test">
			<button type="button" class="btn" data-push-subscribe hidden>Subscribe this browser</button>
			<button type="button" class="btn" data-push-again hidden>Subscribe again</button>
			<button type="button" class="btn" data-push-test hidden>Send test</button>
			<span class="sys-test-help" role="status" data-push-result></span>
		</div>
	</div>
	<div class="sf w-full">
		<div class="lrow"><span class="lbl">Subscribed browsers ({ strconv.Itoa(len(l.Rows)) })</span></div>
		if l.Err != "" {
			<div class="error" role="alert">{ l.Err }</div>
		} else if len(l.Rows) == 0 {
			<p class="ufield-help">No browser is subscribed yet.</p>
		} else {
			<div class="sys-orphans" data-push-list>
				for _, row := range l.Rows {
					@sysPushRowView(row)
				}
			</div>
		}
		<small class="ufield-help">Every subscribed browser gets the events selected under Events, like the webhook and e-mail. Each push is sent encrypted through the push service of the browser's maker (Google, Mozilla, Apple or Microsoft) and carries only the title, the text and the page to open; no device data and no secrets. Any admin can test or remove any browser here.</small>
	</div>
}

// sysPushRowView is one subscribed browser: what it is, who subscribed it, its push service and its last
// delivery, with Send test and Remove. The Send test button posts the form without scripts (the page
// comes back with the result) and swaps the row with them; Remove opens the shared delete dialog, or the
// confirmation page without scripts. push.js marks the row of this browser (data-push-id).
templ sysPushRowView(row sysPushRow) {
	<div class="sys-orphan" id={ "push-" + row.ID } data-push-id={ row.ID }>
		<div class="sys-orphan-main">
			<div class="sys-orphan-title">
				<span>{ row.Label }</span>
				<span class="bdg t-accent" data-push-this hidden>This browser</span>
				if row.LastError != "" {
					@ui.Badge(ui.ToneDanger, "Last delivery failed")
				}
			</div>
			<div class="sys-orphan-detail">
				{ row.Owner } · { row.Host } · subscribed <time { ui.StampAttrs(row.Created, ui.StampStore)... }>{ storeDate(time.Now(), row.Created) }</time>
				if row.LastError != "" {
					{ " · " + row.LastError + ". The next event tries again." }
				} else if !row.LastOK.IsZero() {
					{ " · last delivery " }<time { ui.StampAttrs(row.LastOK, ui.StampStore)... }>{ storeDate(time.Now(), row.LastOK) }</time>
				} else {
					{ " · nothing sent yet" }
				}
			</div>
			if row.Result != "" {
				if testNote("Push test", row.Result).Failed {
					<div class="sys-test-res t-danger" role="alert">Push test: { row.Result }</div>
				} else {
					<div class="sys-test-res t-ok" role="status">Push test: { row.Result }</div>
				}
			}
		</div>
		<div class="bk-acts">
			if row.TestURL != "" {
				<button type="submit" class="btn" data-push-row-test formaction={ templ.SafeURL(row.TestURL) } formnovalidate hx-post={ row.TestURL } hx-params="none" hx-target="closest .sys-orphan" hx-swap="outerHTML">Send test</button>
			}
			<a
				class="btn btn-danger bk-del"
				href={ templ.SafeURL(row.RemoveURL) }
				data-dialog="dlg-bkdel"
				data-dlg-title={ "Remove " + row.Label + "?" }
				data-dlg-text={ row.RemoveText }
				data-dlg-action={ row.RemoveURL }
				data-dlg-verb="Remove"
			>Remove</a>
		</div>
	</div>
}

// sysPushGone replaces a row whose test removed it (the push service no longer knew the browser, or its
// admin is no longer one): the reason, in the place of the row.
templ sysPushGone(msg string) {
	<div class="sys-orphan">
		<div class="sys-orphan-main">
			<div class="sys-test-res t-danger" role="alert">Push test: { msg }</div>
		</div>
	</div>
}

// sysRowView draws one setting in the control its kind calls for, then the settings that depend
// on it, together in one group that is marked is-off and inert while the switch is off.
templ sysRowView(p sysPage, row sysRow) {
	switch {
		case row.Locked:
			@sysLocked(row)
		case row.Key == "MQTT_URL" && p.MQTT.Legacy == "":
			@sysBroker(p, row)
		case row.Key == "MQTT_ACL_WARNING_HIDDEN":
			@sysACLHide(p, row)
		case row.Bool:
			@sysSwitch(row)
		default:
			@sysInput(row)
	}
	if row.Key == "MQTT_URL" && p.MQTT.Legacy != "" {
		@sysKeepLegacy(p)
	}
	if len(row.Deps) > 0 {
		<div class="dep" data-depends={ sysDependsOn(row.Key) }>
			for _, d := range row.Deps {
				switch d.Key {
					case "NOTIFY_SMTP_HOST":
						@sysSMTPServer(row.Deps)
					case "NOTIFY_SMTP_PORT", "NOTIFY_SMTP_SECURITY":
						// drawn with the host
					default:
						@sysRowView(p, d)
				}
			}
		</div>
	}
}

// sysFieldData is the label row and help of a setting; the card's restart badge replaces the
// field's own.
func sysFieldData(row sysRow) ui.SettingFieldData {
	c := sysFieldCopy(row.Key)
	return ui.SettingFieldData{Key: row.Key, Label: sysLabel(row), Width: c.Width, Help: c.Help, Info: c.Info, Err: row.Err,
		Notice: sysNotice(row), Pending: row.PendingRestart,
		Restart: row.Apply != sysconfig.Live && !row.InRestartCard, CanReset: sysCanReset(row), Default: sysDefault(row), Locked: row.Locked}
}

// sysInput is a text, number, password, list or choice setting.
templ sysInput(row sysRow) {
	@ui.SettingField(sysFieldDataGroup(row)) {
		switch {
			case row.Key == "LOG_LEVEL":
				@ui.Segmented(row.Label, row.InputName(), sysLevelOptions(row.Posted))
			case row.Key == "AUTH_MODE":
				@ui.RadioCards(row.Label, row.InputName(), sysAuthOptions(row.Posted))
			case sysSegmentedEnum(row.Key):
				@ui.Segmented(row.Label, row.InputName(), sysEnumOptions(row))
			case row.Key == "BACKUP_DAYS":
				@sysDayChips(row, "Backup days")
			case row.Key == "SNAPSHOT_DAYS":
				@sysDayChips(row, "Snapshot days")
			case len(row.Choices) > 0:
				<div class="cks" role="group" aria-label={ row.Label }>
					<input type="hidden" name={ "m." + row.Key } value="1"/>
					for _, c := range row.Choices {
						<label class="ucheck"><input type="checkbox" name={ row.InputName() } value={ c } checked?={ slices.Contains(sysChecked(row), c) }/><span>{ c }</span></label>
					}
				</div>
			case row.Key == "BACKUP_TIME" || row.Key == "SNAPSHOT_TIME":
				<input type="time" name={ row.InputName() } id={ ui.SettingControlID(row.Key) } class="mono" value={ row.Posted } step="60" required { sysDescribe(row)... }/>
			case row.Secret:
				<input type="password" name={ row.InputName() } id={ ui.SettingControlID(row.Key) } class="mono" autocomplete="new-password" maxlength={ sysSecretMax(row) } placeholder={ sysSecretHint(row) } { sysDescribe(row)... }/>
			case len(row.Enum) > 0:
				<select name={ row.InputName() } id={ ui.SettingControlID(row.Key) } { sysDescribe(row)... }>
					for _, o := range row.Enum {
						<option value={ o } selected?={ o == row.Posted }>{ sysEnumLabel(row.Key, o) }</option>
					}
				</select>
			case row.Multiline:
				<textarea name={ row.InputName() } id={ ui.SettingControlID(row.Key) } class="mono" rows="3" maxlength="2048" placeholder={ sysPlaceholder(row) } { sysDescribe(row)... }>{ row.Posted }</textarea>
			default:
				<input name={ row.InputName() } id={ ui.SettingControlID(row.Key) } class="mono" value={ row.Posted } maxlength="512" placeholder={ sysPlaceholder(row) } { sysDescribe(row)... }/>
		}
	}
}

// sysSwitch is an on/off setting. The b.KEY marker says the switch was on the page, so "off" is saved.
templ sysSwitch(row sysRow) {
	@ui.SettingField(sysSwitchData(row)) {
		<input type="hidden" name={ "b." + row.Key } value="1"/>
		<label class="swhit"><input type="checkbox" role="switch" id={ ui.SettingControlID(row.Key) } name={ row.InputName() } value="true" checked?={ row.Posted == "true" } { sysDescribe(row)... }/><span class="swtrack" aria-hidden="true"></span></label>
	}
}

// sysDayChips is the weekday choice of a schedule (label: the group's name for a screen reader): one chip
// per day, Monday first. The chips are plain checkboxes in a group, so they work without JavaScript and by
// keyboard; none ticked is manual only (backups) or off (snapshots).
templ sysDayChips(row sysRow, label string) {
	<div class="cks chips" role="group" aria-label={ label }>
		<input type="hidden" name={ "m." + row.Key } value="1"/>
		for _, c := range row.Choices {
			<label class="ucheck chip"><input type="checkbox" name={ row.InputName() } value={ c } checked?={ slices.Contains(sysChecked(row), c) }/><span>{ dayLabels[c] }<span class="sr-only">{ " " + dayFull[c] }</span></span></label>
		}
	</div>
}

// sysLocked is a setting the container configuration fixes: no control, the Environment badge and
// the key to change it by. Secrets show only whether a value is set.
templ sysLocked(row sysRow) {
	@ui.SettingField(ui.SettingFieldData{Key: row.Key, Label: sysLabel(row), Width: sysFieldCopy(row.Key).Width, Info: sysFieldCopy(row.Key).Info,
		Help: sysLockedHelp(row), Locked: true, Switch: false}) {
		if row.Secret {
			<div class="in ro mono">{ sysSetWord(row.HasValue) }</div>
		} else if row.Key == "AUTH_MODE" {
			<div class="in ro">{ sysAuthModeWords(row.Value) }</div>
		} else {
			<div class="in ro mono">{ row.Value }</div>
		}
	}
}

// sysBroker is MQTT_URL as the Broker host, port and TLS in one row (N18).
templ sysBroker(p sysPage, row sysRow) {
	<div class="brow">
		@ui.SettingField(ui.SettingFieldData{Key: row.Key, Label: "Host", Width: "grow", Err: row.Err, CanReset: row.Source == "stored"}) {
			<input name="mqtt.host" id={ ui.SettingControlID(row.Key) } class="mono" value={ p.MQTT.Host } maxlength="255" placeholder="empty: MQTT off" { sysDescribe(row)... }/>
		}
		<div class="sf w-port">
			<div class="lrow"><label class="lbl" for="f-mqtt-port">Port</label></div>
			<input name="mqtt.port" id="f-mqtt-port" class="mono" value={ p.MQTT.Port } inputmode="numeric" maxlength="5" placeholder="1883"/>
		</div>
		<div class="sf w-tls">
			<div class="lrow"><span class="lbl">TLS</span></div>
			<div class="sf-switch tlsrow">
				<label class="swhit"><input type="checkbox" role="switch" id="f-mqtt-tls" name="mqtt.tls" value="1" checked?={ p.MQTT.TLS }/><span class="swtrack" aria-hidden="true"></span></label>
				<div class="sf-main"><div class="lrow"><label class="lbl" for="f-mqtt-tls">Use TLS</label></div></div>
			</div>
		</div>
	</div>
	if p.MQTT.HasPassword {
		<label class="ucheck sopt bkeep" data-broker-keep data-stored-host={ p.MQTT.StoredHost } data-stored-port={ p.MQTT.StoredPort }><input type="checkbox" name="reuse.MQTT_PASSWORD" value="1" checked?={ p.MQTT.KeepTicked }/><span>Broker changed: keep the stored password for the new broker</span></label>
	}
}

// aclHelp is the plain help line about the broker ACL where the notice itself does not stand (#1078): the setup's
// broker fields and the device's MQTT password source. Sentence says what the place risks; the link is the guide.
templ aclHelp(sentence string) {
	<small class="ufield-help acl-help">{ sentence } <a href={ templ.SafeURL(ui.BrokerACLDocURL) } target="_blank" rel="noopener noreferrer">{ ui.BrokerACLAction }<span class="sr-only">{ " (opens in a new tab)" }</span></a></small>
}

// sysACLHide is the admin's switch that hides the broker ACL warning (#880, #962), drawn like the keep-password
// option. It is bound to the broker in use when saved: a changed host, port or user brings the warning back. The hint
// is the field's help, whole, indented to the label's text (#1078).
templ sysACLHide(p sysPage, row sysRow) {
	if p.MQTT.ACLReady {
		<input type="hidden" name="mqtt.aclhide.seen" value="1"/>
		<label class="ucheck sopt" id={ aclHideID }><input type="checkbox" name="mqtt.aclhide" value="1" checked?={ p.MQTT.ACLHidden }/><span>{ sysLabel(row) }</span></label>
		<small class="ufield-help">{ row.Help }</small>
	} else {
		<small class="ufield-help" id={ aclHideID }>Save a valid broker first: hiding the warning is done for a broker host and port.</small>
	}
	if row.Err != "" {
		<small class="ufield-err">{ row.Err }</small>
	}
}

// sysSMTPServer is the mail server in one row: host, port and security, like the MQTT broker.
templ sysSMTPServer(rows []sysRow) {
	<div class="brow">
		for _, key := range []string{"NOTIFY_SMTP_HOST", "NOTIFY_SMTP_PORT", "NOTIFY_SMTP_SECURITY"} {
			@sysInput(sysNoReset(sysRowOf(rows, key)))
		}
	</div>
}

// sysChannelStatus is the status line of a notification channel: its last delivery or test, or why it is not set up.
templ sysChannelStatus(ch sysChannel) {
	<div class="sys-status">
		<span class={ "sys-status-dot", "t-" + ch.Tone } aria-hidden="true"></span>
		<div class="sys-status-text">
			<b>{ ch.Title }</b>
			<span>
				{ ch.Lead }
				if !ch.At.IsZero() {
					<time { ui.StampAttrs(ch.At, ui.StampStore)... }>{ storeDate(time.Now(), ch.At) }</time>
				}
				{ ch.Tail }
			</span>
		</div>
	</div>
}

// sysKeepLegacy is the keep option under the single broker URL field, which has no host and port
// to compare: always visible.
templ sysKeepLegacy(p sysPage) {
	if p.MQTT.HasPassword {
		<label class="ucheck sopt bkeep"><input type="checkbox" name="reuse.MQTT_PASSWORD" value="1" checked?={ p.MQTT.KeepTicked }/><span>Broker changed: keep the stored password for the new broker</span></label>
	}
}

// sysSumLink is a total that opens the list of what it counts (the whole tile is the link). Children, if
// any, follow the value inside the tile (a note on what the count means).
templ sysSumLink(label, value, href string) {
	<a class="sys-sum" href={ templ.SafeURL(href) }>
		<div class="sys-sum-label">{ label }</div>
		<div class="sys-sum-value">{ value }</div>
		{ children... }
	</a>
}

templ sysSum(label, value string) {
	<div class="sys-sum">
		<div class="sys-sum-label">{ label }</div>
		<div class="sys-sum-value">{ value }</div>
	</div>
}

// sysOrphans lists the backups of deleted devices (kept when the device was deleted, N2) per device, as a
// device's Backups tab lists its own: Download, Keep and Delete per run. An admin also gets a box per run
// that a bulk delete may take and the selection bar of the tab (#622): "Delete selected" opens the page that
// names count and size. The Keep buttons submit the bk-orph form outside the settings form, the boxes and
// the bar belong to bk-orph-sel; the list is its own selection (data-select-scope), apart from the device table.
templ sysOrphans(p sysPage, st sysStorage) {
	<div data-select-scope?={ st.CanBulk }>
		if st.CanBulk {
			if n := st.Selectable(); n > 0 {
				<label class="ucheck bk-orph-tools" data-select-all-row hidden><input type="checkbox" data-select-all/><span>{ st.SelectAllText() }</span></label>
			}
			<div class="bk-selbar" data-bulkbar hidden role="region" aria-label="Selected backups">
				<span class="bk-selcount"><span data-bar-count>0</span> selected</span>
				<button type="submit" form="bk-orph-sel" class="btn btn-sm bk-seldel">Delete selected…</button>
			</div>
			<noscript>
				<div class="bk-selbar" role="region" aria-label="Selected backups">
					<span class="bk-selcount">Tick the backups to delete</span>
					<button type="submit" form="bk-orph-sel" class="btn btn-sm bk-seldel">Delete selected…</button>
				</div>
			</noscript>
		}
		for _, g := range st.OrphanGroups() {
			<h3 class="sys-subhead">{ orphanName(g.Runs[0]) }
				if g.MAC != "" {
					<span class="mono bk-mac">{ g.MAC }</span>
				}
			</h3>
			<section class="bk-list" aria-label={ "Backups of " + orphanName(g.Runs[0]) }>
				for _, o := range g.Runs {
					@sysOrphanRow(p, st, o)
				}
			</section>
		}
	</div>
}

// sysOrphanRow is one run of a deleted device.
templ sysOrphanRow(p sysPage, st sysStorage, o sysOrphan) {
	<div class="bk-row">
		if st.CanBulk {
			<label class="bk-check" if o.Kept { title="Kept: release it to delete it" }>
				if o.Kept {
					<input type="checkbox" disabled aria-label={ "Kept backup of " + orphanName(o) + ", " + shortDate(o.Taken) + ": release it to delete it" }/>
				} else {
					<input type="checkbox" form="bk-orph-sel" name="id" value={ bkStr(o.ID) } aria-label={ "Select the backup of " + orphanName(o) + ", " + shortDate(o.Taken) }/>
				}
			</label>
		}
		<div class="bk-main">
			<div class="bk-title">
				<time { ui.StampAttrs(o.Taken, ui.StampShort)... }>{ ui.StampText(o.Taken, ui.StampShort) }</time>
				if o.Kept {
					@ui.Badge(ui.ToneAccent, "Kept")
				}
				if o.Missing {
					@ui.Badge(ui.ToneDanger, "File missing")
				}
			</div>
			<div class="bk-detail">{ o.Size }</div>
		</div>
		<div class="bk-acts">
			if st.CanKeep {
				if o.Kept {
					<button type="submit" form="bk-orph" formaction={ templ.SafeURL(p.Base + "/backups/" + bkStr(o.ID) + "/keep") } name="kept" value="0" class="btn bk-keep is-kept" aria-pressed="true" title="Kept: the retention never prunes it and a bulk delete leaves it. Click to release it.">
						<span class="bk-pin" aria-hidden="true"></span>Kept
					</button>
				} else {
					<button type="submit" form="bk-orph" formaction={ templ.SafeURL(p.Base + "/backups/" + bkStr(o.ID) + "/keep") } name="kept" value="1" class="btn bk-keep" aria-pressed="false" title="Keep this backup: the retention never prunes it.">
						<span class="bk-pin" aria-hidden="true"></span>Keep
					</button>
				}
			}
			if o.Download != "" {
				<a class="btn" href={ templ.SafeURL(o.Download) }>Download</a>
			}
			if o.DeleteText != "" {
				<a
					class="btn btn-danger bk-del"
					href={ templ.SafeURL(p.Base + "/backups/" + bkStr(o.ID) + "/delete") }
					data-dialog="dlg-bkdel"
					data-dlg-title="Delete this backup?"
					data-dlg-text={ o.DeleteText } data-dlg-at={ ui.StampISO(o.Taken) } data-dlg-ts={ ui.StampDateTimeSec.Key } data-dlg-shown={ ui.StampText(o.Taken, ui.StampDateTimeSec) }
					data-dlg-action={ p.Base + "/backups/" + bkStr(o.ID) + "/delete" }
					data-dlg-verb="Delete backup"
				>Delete</a>
			}
		</div>
	</div>
}

// sysUnreferencedFiles lists files in old backup folders that no backup entry points to
// (#205). TasmoFleet never moves them; an admin deletes them all at once (#622).
templ sysUnreferencedFiles(st sysStorage) {
	<div class="sys-orphans">
		for _, f := range st.Unreferenced {
			<div class="sys-orphan sys-unref">
				<div class="sys-orphan-main">
					<div class="sys-orphan-title">
						<span class="sys-store-name mono" title={ f.Path }>{ f.Path }</span>
					</div>
					<div class="sys-orphan-detail">
						{ f.Size + " · " }<time { ui.StampAttrs(f.Modified, ui.StampShort)... }>{ ui.StampText(f.Modified, ui.StampShort) }</time>
					</div>
				</div>
			</div>
		}
	</div>
}

// sysSnapshotStatus is the schedule's note and the last scheduled snapshot under it: green when it
// worked, red with the day of the failure when it did not, a warning when a time was skipped because
// TasmoFleet was down. No status while the schedule is off.
templ sysSnapshotStatus(db sysDB) {
	<div class="sf w-full">
		@sysScheduleNote(db.Zone, db.On, db.Now, db.Status.Next)
	</div>
	if db.On {
		if !db.Missed.IsZero() {
			<div class="sys-status">
				<span class="sys-status-dot t-warn" aria-hidden="true"></span>
				<div class="sys-status-text">
					<b>A scheduled snapshot was skipped</b>
					<span>TasmoFleet was not running at the scheduled time and was back more than 60 minutes late, so the snapshot was not made up. Noticed <time { ui.StampAttrs(db.Missed, ui.StampDay)... }>{ ui.StampDayText(db.Now, db.Missed) }</time>. The next one is as scheduled.</span>
				</div>
			</div>
		}
		switch db.Status.State {
			case "fail":
				<div class="sys-status st-fail">
					<span class="sys-status-dot t-danger" aria-hidden="true"></span>
					<div class="sys-status-text">
						<b>Last attempt failed, <time { ui.StampAttrs(db.Status.Attempt, ui.StampStore)... }>{ storeDate(time.Now(), db.Status.Attempt) }</time></b>
						<span>
							if !db.Status.Taken.IsZero() {
								Last good snapshot <time { ui.StampAttrs(db.Status.Taken, ui.StampStore)... }>{ storeDate(time.Now(), db.Status.Taken) }</time>
							} else {
								No good snapshot yet
							}
						</span>
					</div>
				</div>
			case "ok":
				<div class="sys-status st-on">
					<span class="sys-status-dot t-ok" aria-hidden="true"></span>
					<div class="sys-status-text">
						<b>Last snapshot <time { ui.StampAttrs(db.Status.Taken, ui.StampStore)... }>{ storeDate(time.Now(), db.Status.Taken) }</time></b>
						<span>{ strconv.Itoa(db.Status.Count) + " of " + strconv.Itoa(db.Kept) + " kept" }</span>
					</div>
				</div>
			default:
				<div class="sys-status">
					<span class="sys-status-dot t-neutral" aria-hidden="true"></span>
					<div class="sys-status-text">
						<b>No snapshot taken yet</b>
						<span>The first one is taken at the next scheduled time.</span>
					</div>
				</div>
		}
	}
	<p class="ufield-help db-note">Stored in the data directory (<span class="mono">{ db.Dir }</span>), so the host backup of <span class="mono">{ db.DataDir }</span> covers them. They sit on the same disk as the database: they protect against a bad upgrade or a deleted row, not against a dead disk.</p>
}

// sysDownloadBlock is the "Download a snapshot" card: the download (a form outside the settings form,
// "db-dl"), what the file holds and the failure of the last scheduled snapshot.
templ sysDownloadBlock(p sysPage, db sysDB) {
	<div class="sys-test">
		<button type="submit" form="db-dl" class="btn" id="btn-dl" autofocus?={ db.FocusDownload }>Download snapshot</button>
		<label class="db-incl"><input type="checkbox" form="db-dl" name="include_key" value="1" checked?={ db.KeepKey }/> Include <span class="mono">secret.key</span> (as .tar)</label>
		<span class="sys-test-help">{ db.Hint }</span>
	</div>
	<div class="notice plain db-contents" role="note">
		<b>The file holds secrets. Keep it like a password.</b>
		<ul class="db-list">
			<li><b>Inside:</b> devices, groups, settings, users with their password hashes, sessions, audit log and the backup index.</li>
			<li><b>Encrypted inside:</b> device HTTP and MQTT passwords, the default device password, the MQTT broker password, the OIDC client secret and refresh tokens, the metrics token, the notification webhook header value and SMTP password. The key is <span class="mono">secret.key</span> and it is <b>not</b> in the database file: without it these values cannot be read, with it they can.</li>
			<li><b>Not inside:</b> device backup files (.dmp), the firmware cache, <span class="mono">secret.key</span> (unless ticked above).</li>
		</ul>
	</div>
	if db.Status.State == "fail" {
		<div class="st-fail">
			<div class="error" role="alert">
				<b>The last scheduled snapshot failed.</b>
				<time { ui.StampAttrs(db.Status.Attempt, ui.StampStore)... }>{ storeDate(time.Now(), db.Status.Attempt) }</time>: could not write <span class="mono">{ db.Dir + "/" + db.Status.File }</span> ({ db.Status.Reason }). Nothing was deleted.
				if !db.Status.Next.IsZero() {
					The next attempt is <time { ui.StampAttrs(db.Status.Next, ui.StampStore)... }>{ storeDate(time.Now(), db.Status.Next) }</time>;
				}
				<a href={ templ.SafeURL(p.Base + "/audit") }>see the audit log</a>.
			</div>
		</div>
	}
}

// sysStoredNote is the note of the "Stored snapshots" card: where they are kept and whose clock the file
// names and the listed times are on (#683: the names are UTC, the times follow the viewer).
templ sysStoredNote(db sysDB) {
	Newest first, in <span class="mono">{ db.Dir }</span>. Delete acts at once. File names are in UTC (the <span class="mono">Z</span>): <span class="mono nowrap">tasmofleet-20261106-0800Z.db</span> was taken at 09:00 in Central European Time (10:00 in summer time). The times in this list follow your browser's clock.
}

// sysCardNote is the note of a settings card that holds a link: the snapshot schedule names the place
// where the failure message is set. Nil for every other card.
func sysCardNote(p sysPage, c sysCard) templ.Component {
	if c.ID != "snapshots" {
		return nil
	}
	return sysSnapshotScheduleNote(p.Base + sysTabPath("notifications"))
}

templ sysSnapshotScheduleNote(href string) {
	Every scheduled snapshot is written to the audit log. The failure message is set under <a href={ templ.SafeURL(href) }>Settings → Notifications</a>.
}

// sysStoredBlock is the stored snapshots with Download and Delete.
templ sysStoredBlock(db sysDB) {
	if db.CanCreate && db.ListErr == "" {
		<div class="sys-test">
			<button type="submit" form="db-snap" class="btn" id="btn-snap">Create snapshot now</button>
			<span class="sys-test-help">{ sysCreateHelp(db) }</span>
		</div>
	}
	if db.ListErr != "" {
		<div class="error" role="alert">{ db.ListErr }</div>
	} else if len(db.Files) == 0 {
		<p class="ufield-help">
			No snapshots yet.
			if db.CanCreate {
				Create one now with the button above, or choose days on the schedule on the right.
			} else {
				Choose days on the schedule on the right.
			}
			Downloads are not kept on the server.
		</p>
	} else {
		<div class="sys-orphans">
			for _, f := range db.Files {
				<div class="sys-orphan">
					<div class="sys-orphan-main">
						<div class="sys-orphan-title">
							<span class="sys-store-name mono">{ f.Name }</span>
							if f.Latest {
								@ui.Badge(ui.ToneOK, "Latest")
							}
						</div>
						<div class="sys-orphan-detail">
							<time { ui.StampAttrs(f.Taken, ui.StampStore)... }>{ storeDate(time.Now(), f.Taken) }</time>{ " · " + f.Size }
							if f.Schema > 0 {
								{ " · schema " + strconv.Itoa(f.Schema) }
							}
						</div>
					</div>
					<div class="bk-acts">
						<a class="btn" href={ templ.SafeURL(f.Download) }>Download</a>
						<a
							class="btn btn-danger bk-del"
							href={ templ.SafeURL(f.Delete) }
							data-dialog="dlg-bkdel"
							data-dlg-title="Delete this snapshot?"
							data-dlg-text={ snapDeleteText(f.Name) }
							data-dlg-action={ f.Delete }
							data-dlg-verb="Delete snapshot"
						>Delete</a>
					</div>
				</div>
			}
		</div>
	}
}

// sysRestoreBlock is how to restore a snapshot. There is no restore button on purpose.
templ sysRestoreBlock(db sysDB) {
	<ol class="db-restore">
		<li>Stop the container.</li>
		<li>Replace <span class="mono">{ db.DataDir + "/tasmofleet.db" }</span> with the snapshot and delete <span class="mono">tasmofleet.db-wal</span> and <span class="mono">tasmofleet.db-shm</span>.</li>
		<li>Make sure <span class="mono">{ db.DataDir + "/secret.key" }</span> is the one from the same time, then start the container.</li>
	</ol>
	<p class="ufield-help">There is no restore button on purpose. A snapshot from an older version is migrated at start; one from a newer version is refused. The <span class="mono">tasmofleet.db.pre-N</span> copies made before an upgrade are restored the same way.</p>
}

// sysResetBox is "Reset all settings" at the end of the Advanced tab (N9). The button opens
// the dialog; without JavaScript its link leads to the confirmation page.
templ sysResetBox(p sysPage) {
	<div class="sys-danger">
		<div>
			<div class="sys-danger-title">Reset all settings</div>
			<div class="sys-danger-text">Devices, backups and users are kept.</div>
		</div>
		<a class="btn btn-danger-solid" href={ templ.SafeURL(p.Base + sysPath + "/reset") } data-dialog="dlg-reset">Reset settings…</a>
	</div>
}

// sysTestRow is a test button of the form (it posts the whole form, saves nothing) with its
// result next to it. With scripts it swaps only this row, so a password typed into the form is
// still there for the save that follows (a secret is never rendered back); without scripts it
// posts the form and the page reloads. A failure in the danger tone as an alert, a success as a status.
// depends names the form control of the switch the test needs (sysDependsOn); sysform.js marks the row is-off (its button is faded)
// and makes it inert while that switch is off, so a channel that is off cannot be tested (#471).
templ sysTestRow(label, action, what, result, help, depends string) {
	<div class="sys-test" { sysDependsAttrs(depends)... }>
		<button type="submit" class="btn" formaction={ templ.SafeURL(action) } formnovalidate hx-post={ action } hx-include="#sysform" hx-target="closest .sys-test" hx-swap="outerHTML">{ label }</button>
		if result != "" {
			if testNote(what, result).Failed {
				<span class="sys-test-res t-danger" role="alert">{ what }: { result }</span>
			} else {
				<span class="sys-test-res t-ok" role="status">{ what }: { result }</span>
			}
		} else {
			<span class="sys-test-help">{ help }</span>
		}
	</div>
}

// sysDiscoveryCard is the status of MQTT discovery on top of the Discovery tab.
templ sysDiscoveryCard(p sysPage) {
	<div class="sys-status">
		<span class={ "sys-status-dot", "t-" + p.Discovery.Tone } aria-hidden="true"></span>
		<div class="sys-status-text">
			<b>{ p.Discovery.Title }</b>
			<span>
				{ p.Discovery.Text }
				if p.Discovery.Waiting > 0 {
					{ " · " + plural(p.Discovery.Waiting, "new device") + " waiting" }
				}
			</span>
		</div>
	</div>
}

// sysContainer lists the bootstrap settings, which only the container configuration sets: full
// width, always visible, as two tables side by side (the first half of the list on the left).
// On a phone they stack.
templ sysContainer(rows []sysconfig.Row) {
	@ui.CardStacks(1) {
	@ui.CardStack(ui.SpanAll) {
	@ui.SettingsCard(ui.SettingsCardData{ID: "card-container", Title: "Set by the container", Note: "Read-only. Change them in the container configuration.", Plain: true}) {
	<p class="ucard-sub">Bootstrap settings (listeners, TLS, keys) come from the container configuration only and are never editable here.</p>
	<div class="cset">
		@sysContainerTable(rows[:(len(rows)+1)/2])
		@sysContainerTable(rows[(len(rows)+1)/2:])
	</div>
	}
	}
	}
}

templ sysContainerTable(rows []sysconfig.Row) {
	<div class="table-scroll">
		<table class="dense">
			<thead><tr><th>Key</th><th>Value</th></tr></thead>
			<tbody>
				for _, kv := range rows {
					<tr>
						<td data-label="Key" class="p1"><code>{ sysEnvName(kv.Key) }</code></td>
						<td data-label="Value" class="s grow">
							if kv.Value != "" {
								<code>{ kv.Value }</code>
							} else {
								<span class="muted">empty</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// sysPasswordsCard is what the card of the devices' MQTT passwords shows under its switch (#609): the counts, the
// devices without a password with the reason and Set…, and the one step for the rest, "Use the broker password for
// these…". No value is shown, ever: the card knows words, dates and reasons only. The button opens a dialog posted
// outside the settings form; without scripts its link is the page that asks the same question.
templ sysPasswordsCard(p sysPage) {
	{{ c := p.PW }}
	<div class="sys-sums">
		@sysSum("On this broker", strconv.Itoa(c.OnBroker))
		@sysSum("From backups", strconv.Itoa(c.FromBackups))
		@sysSum("Entered", strconv.Itoa(c.Entered))
		@sysSum("Not known", strconv.Itoa(c.NotKnown()))
	</div>
	if c.Testing > 0 {
		<div class="sys-status">
			<span class="sys-status-dot t-neutral" aria-hidden="true"></span>
			<div class="sys-status-text">
				<b>{ "Testing " + plural(c.Testing, "device") }</b>
				<span>Each test takes about a second. The device page shows the result.</span>
			</div>
		</div>
	}
	if c.Refused > 0 || c.NotTested > 0 {
		<p class="cnote">{ pwCardNote(c) }</p>
	}
	if len(c.Rows) > 0 {
		<h3 class="sys-subhead">{ "Not known (" + strconv.Itoa(len(c.Rows)) + ")" }</h3>
		<div class="sys-orphans">
			for _, row := range c.Rows {
				<div class="sys-orphan">
					<div class="sys-orphan-main">
						<div class="sys-orphan-title">
							<a href={ templ.SafeURL(row.Href) } class="sys-store-name">{ row.Name }</a>
							@ui.Badge(row.Tone, row.Word)
						</div>
						<div class="sys-orphan-detail">{ row.Reason }</div>
					</div>
					<div class="sys-orphan-acts"><a class="btn btn-link" href={ templ.SafeURL(row.SetHref) } aria-label={ "Set the password of " + row.Name }>Set…</a></div>
				</div>
			}
		</div>
		<div class="sys-test">
			if c.CanBulk {
				<a class="btn" href={ templ.SafeURL(c.Base + sysPath + pwBrokerPath) } data-dialog="dlg-pwbroker">{ "Use the broker password for " + plural(len(c.Rows), "device") + "…" }</a>
			} else {
				<button type="button" class="btn" disabled aria-describedby="pw-broker-why">Use the broker password…</button>
				<span class="sys-test-help" id="pw-broker-why">Set the broker password above first: it is what TasmoFleet would send.</span>
			}
		</div>
	}
	<p class="cnote">Updated after every backup. A password you enter is kept until a newer backup holds a different one.</p>
}

// sysTopicCheck is the Topic check card (#1047): the status line, the collisions with every device involved and how
// it uses the topic, then the devices TasmoFleet does not fully know. Long lists start folded.
templ sysTopicCheck(t topicsCard) {
	<div class="sys-status" id="topiccheck-status">
		<span class={ "sys-status-dot", "t-" + t.Tone } aria-hidden="true"></span>
		<div class="sys-status-text">
			<b>{ t.Title }</b>
			<span>{ t.Text }</span>
		</div>
	</div>
	if !t.Failed {
		if len(t.Collisions) > 0 {
			<details class="fold" open?={ len(t.Collisions) <= foldOpen }>
				<summary>Collisions <span class="meta">{ strconv.Itoa(len(t.Collisions)) }</span></summary>
				<div class="sys-orphans" id="topiccheck-collisions">
					for _, col := range t.Collisions {
						<div class="sys-orphan">
							<div class="sys-orphan-main">
								<div class="sys-orphan-title"><span class="sys-store-name mono topic-name">{ col.Topic }</span></div>
								if col.Note != "" {
									<div class="sys-orphan-detail">{ col.Note }</div>
								}
								<ul class="topic-members">
									for _, m := range col.Members {
										<li><a href={ templ.SafeURL(m.Href) } class="sys-store-name">{ m.Name }</a> <span class="meta">{ m.Use }</span></li>
									}
								</ul>
							</div>
						</div>
					}
				</div>
			</details>
		}
		if len(t.Unknown) > 0 {
			<details class="fold" open?={ len(t.Unknown) <= foldOpen }>
				<summary>Not fully known <span class="meta">{ strconv.Itoa(len(t.Unknown)) }</span></summary>
				<div class="sys-orphans" id="topiccheck-unknown">
					for _, u := range t.Unknown {
						<div class="sys-orphan">
							<div class="sys-orphan-main">
								<div class="sys-orphan-title"><a href={ templ.SafeURL(u.Href) } class="sys-store-name">{ u.Name }</a></div>
								<div class="sys-orphan-detail">{ u.Reason }</div>
								if u.Muted != "" {
									<div class="topic-muted">{ u.Muted }</div>
								}
							</div>
						</div>
					}
				</div>
			</details>
		}
		<p class="cnote">TasmoFleet only knows what it has read from the devices: right after a start or a GroupTopic change, devices show as not fully read yet for a short while (the reader asks one device every 2 seconds).</p>
	}
}

// pwBrokerFields are the insides of "Use the broker password": the devices, all ticked, and the box for the tests.
// The boxes are named id like the device pickers', so select.js keeps the count, Select all and the button's number.
templ pwBrokerFields(d pwBrokerData) {
	<div class="pw-pick-tools">
		<label class="ucheck"><input type="checkbox" data-select-all checked/><span>{ "All " + plural(len(d.Rows), "device") + " without a password" }</span></label>
		<span class="pw-pick-count" data-select-n>{ strconv.Itoa(len(d.Rows)) + " selected" }</span>
	</div>
	<div class="pw-pick-list">
		for _, row := range d.Rows {
			<label class="pw-pick">
				<input type="checkbox" name="id" value={ strconv.FormatInt(int64(row.ID), 10) } checked/>
				<span class="pw-pick-name">{ row.Name }</span>
				<span class="pw-pick-meta">{ row.Meta }</span>
			</label>
		}
	</div>
	<label class="ucheck pw-test"><input type="checkbox" name="test" value="1" checked/><span>Test each device afterwards</span></label>
	<p class="cnote">The test starts a settings download over MQTT and stops it at once: it shows whether the device accepts the password and changes nothing on it. About a second per device, one at a time, in the background.</p>
}

// pwBrokerDialog is "Use the broker password for these…" for scripts; pwBrokerPage is the same question as a page.
templ pwBrokerDialog(p sysPage) {
	{{ d := pwBrokerData{Base: p.Base, CSRF: p.CSRF, Rows: p.PW.Rows} }}
	<dialog id="dlg-pwbroker" class="udlg udlg-wide" aria-labelledby="dlg-pwbroker-h">
		<form method="post" action={ templ.SafeURL(p.Base + sysPath + pwBrokerPath) } class="udlg-in">
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<input type="hidden" name="confirm" value="1"/>
			<h2 id="dlg-pwbroker-h">Use the broker password?</h2>
			<p class="udlg-body">For every device you tick, TasmoFleet sends its own broker password with backups and restores over MQTT. Untick devices that log in with a password of their own. The password is never shown. { pwBrokerTestWarning }</p>
			@pwBrokerFields(d)
			<div class="udlg-foot">
				<button type="button" class="btn" data-close>Cancel</button>
				<button type="submit" class="btn btn-primary">Use the broker password<span data-select-suffix></span></button>
			</div>
		</form>
	</dialog>
}

templ pwBrokerPage(d pwBrokerData) {
	@ui.PageHeader("Use the broker password", "")
	<section class="ucard confirm-card" aria-labelledby="confirm-h">
		<h2 id="confirm-h">{ "Use the broker password for " + plural(len(d.Rows), "device") }</h2>
		<p class="udlg-body">For every device you tick, TasmoFleet sends its own broker password with backups and restores over MQTT. Untick devices that log in with a password of their own. The password is never shown. { pwBrokerTestWarning }</p>
		if d.ACL {
			@ui.BrokerACLNotice()
		}
		<form method="post" action={ templ.SafeURL(d.Base + sysPath + pwBrokerPath) } class="udlg-in">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			<input type="hidden" name="confirm" value="1"/>
			@pwBrokerFields(d)
			<div class="udlg-foot">
				<a class="btn" href={ templ.SafeURL(d.Base + sysTabPath("mqtt")) }>Cancel</a>
				<button type="submit" class="btn btn-primary">Use the broker password<span data-select-suffix></span></button>
			</div>
		</form>
	</section>
}
