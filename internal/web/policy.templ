package web

import (
	"strconv"
	"strings"

	"github.com/nofuturekid/tasmofleet/internal/tasmotacmd"
	"github.com/nofuturekid/tasmofleet/internal/web/ui"
)

// Design v2 screens "policyio" and the Make compliant pages (N3, N21), the shared command and
// value inputs of the rule page. The overview is policy_overview.templ.

func vstr(n int64) string { return strconv.FormatInt(n, 10) }

// commandField is the command input with its suggestions, help and, after a refused save, the
// reason. The reason describes the command that was saved: changing the command clears it (the
// value-control answer replaces #err-command out of band, policy.js drops aria-invalid). For a
// command with an index range the input is a name with a number box (SetOption [19]); policy.js
// keeps the hidden command in step with the box. oob: the answer of a change that switches
// between the two forms replaces the whole field.
templ commandField(base string, cv commandView, invalid bool, errMsg string, oob bool) {
	<div class="ufield cmd-rel" id="command-field" if oob { hx-swap-oob="true" }>
		if cv.Indexed {
			<span class="ufield-label" id="cmd-l">Command</span>
			<div class="cmd-idx" role="group" aria-labelledby="cmd-l">
				<span class="cmd-idx-base mono">{ cv.Base }</span>
				<input
					id="rule-index"
					name="index"
					form="cmd-index-none"
					class="mono"
					type="number"
					inputmode="numeric"
					min={ itoa(cv.Lo) }
					max={ itoa(cv.Hi) }
					step="1"
					value={ cv.Index }
					data-cmd-base={ cv.Base }
					aria-label={ cv.Base + " index, " + itoa(cv.Lo) + " to " + itoa(cv.Hi) }
					aria-describedby="help-command cmd-sends"
					hx-get={ base + rulesPath + "/value-control?base=" + cv.Base }
					hx-trigger="change consume"
					hx-target="#want-control"
					hx-swap="innerHTML"
					hx-include="[name='want']"
					if cv.Index == "" || invalid {
						autofocus
					}
					if invalid {
						aria-invalid="true"
					}
				/>
				<span class="cmd-idx-range">{ itoa(cv.Lo) } to { itoa(cv.Hi) }</span>
				<button
					type="button"
					class="cmd-idx-x"
					aria-label="Change command"
					hx-get={ base + rulesPath + "/value-control?edit=1&base=" + cv.Base }
					hx-include="#rule-index, [name='want']"
					hx-target="#want-control"
					hx-swap="innerHTML"
				>Change</button>
			</div>
			<input type="hidden" id="rule-command" name="command" value={ cv.Command }/>
			@commandSends(cv, false)
		} else {
			<label class="ufield-label" for="rule-command">Command</label>
			<input
				id="rule-command"
				name="command"
				class="mono"
				value={ cv.Command }
				maxlength="32"
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
				placeholder="e.g. PowerOnState, Sleep, SetOption19"
				role="combobox"
				aria-expanded="false"
				aria-controls="cmd-sug"
				aria-autocomplete="list"
				aria-describedby={ commandDescribedBy(invalid) }
				data-cmd-suggest={ base + rulesPath + "/command-suggest" }
				hx-get={ base + rulesPath + "/value-control" }
				hx-trigger="change consume"
				hx-target="#want-control"
				hx-swap="innerHTML"
				hx-include="[name='want']"
				if invalid {
					aria-invalid="true"
					autofocus
				}
			/>
			<div class="cmd-sug" id="cmd-sug" role="listbox" aria-label="Command suggestions" hidden></div>
		}
		@commandHelp(cv, false)
		if invalid {
			@commandErr(errMsg, false)
		} else {
			@commandErr("", false)
		}
	</div>
}

// commandSends says which command the index box sends.
templ commandSends(cv commandView, oob bool) {
	<span class="ufield-help" id="cmd-sends" if oob { hx-swap-oob="true" }>
		if cv.Index != "" {
			Sends <b class="mono">{ cv.Command }</b>. Index { itoa(cv.Lo) } to { itoa(cv.Hi) }.
		} else {
			Type the index, { itoa(cv.Lo) } to { itoa(cv.Hi) }.
		}
	</span>
}

// commandHelp is the line under the command: our own one-line description and the link to the
// Tasmota docs when the catalogue knows the command, a pointer to the suggestions otherwise.
templ commandHelp(cv commandView, oob bool) {
	<p class="ufield-help cmd-help" id="help-command" if oob { hx-swap-oob="true" }>
		if cv.Desc == "" && cv.DocsURL == "" {
			Type a command name. Suggestions come from the Tasmota versions in your fleet. Status commands, secrets and commands that act when sent without a value are refused.
		} else {
			if cv.Desc != "" {
				{ cv.Desc }
				{ " " }
			}
			if cv.DocsURL != "" {
				<a class="cmd-doc" href={ templ.SafeURL(cv.DocsURL) } target="_blank" rel="noopener">Tasmota docs<svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M4 2h6v6M10 2L3 9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg></a>
			}
		}
	</p>
}

// wantCheck is the warning under the value field; the preview swaps it as the value is typed.
templ wantCheck(c *checkView, oob bool) {
	<div id="want-check" if oob { hx-swap-oob="true" }>
		if c != nil {
			<div class={ "banner", "tone-" + string(c.Tone), "cmd-check" } role="status">
				<span class="banner-dot"></span>
				<div class="banner-text">
					<b>{ c.Title }</b>
					<span class="cmd-foot">{ c.Foot }</span>
				</div>
			</div>
		}
	</div>
}

// commandCheck is the banner under the command and value: which Tasmota versions of the fleet know
// the command and which devices lack a feature. It warns; only a command no fleet version has
// cannot be saved.
templ commandCheck(c *checkView, oob bool) {
	<div id="command-check" if oob { hx-swap-oob="true" }>
		if c != nil {
			<div class={ "banner", "tone-" + string(c.Tone), "cmd-check" } role="status">
				<span class="banner-dot"></span>
				<div class="banner-text">
					<b>{ c.Title }</b>
					if len(c.Rows) > 0 {
						<ul class="cmd-vers" aria-label="Result per Tasmota version in the fleet">
							for _, r := range c.Rows {
								<li class={ "cmd-v", templ.KV("ok", r.OK), templ.KV("no", !r.OK) }>
									<span class="cmd-vn mono">{ r.Version }</span>
									<span class="cmd-vd">{ r.Devices }</span>
									<span class="cmd-vr">
										if r.Neutral {
											<span class="cmd-i" aria-hidden="true">–</span>
										} else if r.OK {
											<svg class="cmd-i ok" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
										} else {
											<svg class="cmd-i no" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
										}
										{ r.Result }
									</span>
								</li>
							}
						</ul>
					}
					<span class="cmd-foot">{ c.Foot }</span>
				</div>
			</div>
		}
	</div>
}

// commandSuggestList is the content of the suggestion listbox for the typed text.
templ commandSuggestList(v suggestView) {
	if v.Shown == 0 {
		<div class="cmd-sug-g">No command “{ v.Query }” in Tasmota { strings.Join(v.Versions, ", ") }</div>
	} else {
		if len(v.Starts) > 0 {
			<div class="cmd-sug-g">Starts with “{ v.Query }”</div>
			for _, s := range v.Starts {
				@suggestOption(s)
			}
		}
		if len(v.Contains) > 0 {
			<div class="cmd-sug-g">Contains “{ v.Query }”</div>
			for _, s := range v.Contains {
				@suggestOption(s)
			}
		}
	}
	<div class="cmd-sug-f">
		{ itoa(v.Shown) } of { itoa(v.Total) } commands in Tasmota { strings.Join(v.Versions, ", ") }
		<span class="cmd-sug-keys" aria-hidden="true">· <kbd>↑</kbd><kbd>↓</kbd> move, <kbd>Enter</kbd> pick, <kbd>Esc</kbd> close</span>
	</div>
}

// indexMark is the <n> after the name of a command that takes an index.
templ indexMark(indexed bool) {
	if indexed {
		<i>&lt;n&gt;</i>
	}
}

templ suggestOption(s tasmotacmd.Suggestion) {
	<div class="cmd-opt" role="option" aria-selected="false" data-name={ s.Name }>
		<span class="cmd-opt-n mono">{ s.Name }@indexMark(s.Indexed)</span>
		if s.Indexed {
			<span class="cmd-opt-r mono">{ itoa(s.Lo) + ".." + itoa(s.Hi) }</span>
		} else if s.Needs != "" {
			<span class="cmd-opt-r">needs { s.Needs }</span>
		}
		if s.Desc != "" {
			<span class="cmd-opt-d">{ s.Desc }</span>
		}
	</div>
}

// commandErr is the reason a command was refused; empty and hidden when there is none. With oob it
// replaces the shown one.
templ commandErr(msg string, oob bool) {
	<span class="ufield-err" id="err-command" if msg != "" { role="alert" } if msg == "" { hidden } if oob { hx-swap-oob="true" }>{ msg }</span>
}

// ruleValueSwap answers a change of the command: the value control, no reason any more, the help
// and the fleet check of the new command, and the field itself when it changes form.
templ ruleValueSwap(vc valueControl, cv commandView, base string, swapField bool) {
	@ruleValue(vc)
	@commandErr("", true)
	@commandCheck(cv.Check, true)
	@wantCheck(nil, true)
	if swapField {
		@commandField(base, cv, false, "", true)
	} else {
		@commandHelp(cv, true)
		if cv.Indexed {
			@commandSends(cv, true)
		}
	}
}

// ruleValue is the expected-value input; its kind follows the setting (htmx swaps it when the
// setting changes). A small label names the kind.
templ ruleValue(vc valueControl) {
	<span class="cmd-lrow">
		<label class="ufield-label" for="want">Expected value</label>
		if b := kindBadge(vc.Kind); b != "" {
			<span class="cmd-kind">{ b }</span>
		}
	</span>
	switch vc.Kind {
		case "select":
			<select id="want" name="want" class="mono" required if vc.Invalid {
	aria-invalid="true"
	aria-describedby="err-want"
	autofocus
}>
				<option value="">Choose a value…</option>
				for _, o := range vc.Options {
					<option value={ o.Value } selected?={ o.Value == vc.Want }>{ o.Label }</option>
				}
			</select>
		case "toggle":
			<span class="useg" role="radiogroup" aria-label="Expected value">
				<label><input type="radio" name="want" value="1" checked?={ vc.Want == "1" } required/><span>On</span></label>
				<label><input type="radio" name="want" value="0" checked?={ vc.Want == "0" } required/><span>Off</span></label>
			</span>
		case "state":
			<span class="useg" role="radiogroup" aria-label="Expected state">
				<label><input type="radio" name="want" value="1" checked?={ stateIsOn(vc.Want) } required/><span>On</span></label>
				<label><input type="radio" name="want" value="0" checked?={ stateIsOff(vc.Want) } required/><span>Off</span></label>
			</span>
		case "number":
			if vc.HasRange {
				<input id="want" name="want" type="number" step={ numberStep(vc.Decimal) } class="mono" required min={ itoa(vc.Min) } max={ itoa(vc.Max) } value={ vc.Want } if vc.Invalid {
	aria-invalid="true"
	aria-describedby="err-want"
	autofocus
}/>
			} else {
				<input id="want" name="want" type="number" step={ numberStep(vc.Decimal) } class="mono" required value={ vc.Want } if vc.Invalid {
	aria-invalid="true"
	aria-describedby="err-want"
	autofocus
}/>
			}
		case "none":
			<input id="want" name="want" type="text" class="mono" disabled placeholder="Pick a command first"/>
		default:
			<input id="want" name="want" type="text" class="mono" maxlength="64" required value={ vc.Want } if vc.Invalid {
	aria-invalid="true"
	aria-describedby="err-want"
	autofocus
}/>
	}
	if vc.Hint != "" {
		<span class="ufield-help">{ vc.Hint }</span>
	}
}

func numberStep(decimal bool) string {
	if decimal {
		return "any"
	}
	return "1"
}

func stateIsOn(w string) bool  { return w == "1" || strings.EqualFold(w, "on") }
func stateIsOff(w string) bool { return w == "0" || strings.EqualFold(w, "off") }

// policyIOPage is GET /policy/io: Export (the rules as JSON) and Import (paste, check, save).
templ policyIOPage(p policyIOView) {
	<div class="pol-page">
		@ui.PageHeader("Import / export rules", "JSON, one file for all rules. Importing never changes devices.") {
			<a class="btn" href={ templ.SafeURL(p.Base + policyPath) }>Back to policy</a>
		}
		if p.Admin {
			@ui.Tabs("Import or export", []ui.Tab{
				{Label: "Export", Href: p.Base + policyIOPath, Current: !p.Import},
				{Label: "Import", Href: p.Base + policyIOPath + "?tab=import", Current: p.Import},
			})
		} else {
			@ui.Tabs("Export", []ui.Tab{{Label: "Export", Href: p.Base + policyIOPath, Current: true}})
		}
		if !p.Import {
			<div class="pio-export">
				<div class="pio-acts">
					<button type="button" class="btn" data-copy-text={ p.JSON } hidden>Copy</button>
					<a class="btn btn-primary" href={ templ.SafeURL(p.Base + policyIOPath + "/export") } download="policy-rules.json">Download .json</a>
				</div>
				<pre class="pio-json">{ p.JSON }</pre>
			</div>
		} else {
			<div class="pio-import">
				<form method="post" action={ templ.SafeURL(p.Base + policyIOPath + "/import") } class="pio-form" id="pio-form">
					<input type="hidden" name="csrf" value={ p.CSRF }/>
					<label class="ufield">
						<span class="ufield-label">Paste JSON</span>
						<textarea name="json" rows="14" maxlength="262144" class="mono" if p.Error != "" {
	aria-invalid="true"
	aria-describedby="pio-err"
}>{ p.Text }</textarea>
						if p.Error != "" {
							<span class="ufield-err" id="pio-err" role="alert">{ p.Error }</span>
						}
					</label>
					<div class="pio-check">
						<button type="submit" class="btn">Check import</button>
					</div>
				</form>
				<section class="pio-preview" aria-labelledby="pio-h">
					<div class="pio-pv-head">
						<h2 id="pio-h">Preview</h2>
						<span class="pio-counts">
							for _, c := range p.Counts {
								@ui.Badge(countTone(c.Key), c.Value)
							}
						</span>
					</div>
					if !p.Checked {
						<p class="pio-none">Paste the rules and check them: the preview lists what changes before anything is saved.</p>
					} else if len(p.Rows) == 0 {
						<p class="pio-none">No difference: the file holds the rules that are saved now.</p>
					} else {
						for _, r := range p.Rows {
							<div class="pio-row">
								@ui.Badge(r.Tone, r.Kind)
								<div class="pio-row-t">
									<span>{ r.Rule }</span>
									if r.Detail != "" {
										<span class="pio-row-d">{ r.Detail }</span>
									}
								</div>
							</div>
						}
					}
					if p.Checked {
						<div class="pio-foot">
							<span>The file replaces all current rules. The import is saved as a new rule version.</span>
							<button type="submit" form="pio-form" class="btn btn-primary" name="confirm" value="1">Import { plural(p.Count, "rule") }</button>
						</div>
					}
				</section>
			</div>
		}
	</div>
}

// fixPreviewPage is the Make compliant plan as a page (no JavaScript, or values that changed).
templ fixPreviewPage(base, csrf string, p fixPage) {
	<div class="pol-page">
		@ui.PageHeader("Make "+plural(p.Ready, "device")+" compliant", "Nothing has been changed on any device yet. These are the exact commands, sent to each device in one batch and saved to the device once, at the end. Required deviations are included. An Advisory deviation is included only when you tick it.")
		if p.Stale {
			@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Text: "The values changed since you looked. Nothing was sent; review the commands below again.", Alert: true})
		}
		if len(p.Rows) == 0 {
			@ui.Empty("No device selected", "Pick a rule that flags devices on the policy page.") {
				<a class="btn" href={ templ.SafeURL(base + policyPath) }>Back to policy</a>
			}
		} else {
			<div class="pol-fix-grid">
				for _, row := range p.Rows {
					<section class="ucard pol-fix-card">
						<h2><a href={ templ.SafeURL(base + "/devices/" + devStr(row.Device.ID)) }>{ row.Device.Name }</a></h2>
						for _, c := range row.Cmds {
							<div class="pol-fix-cmd">
								<span><span class="mono">{ c.Text }</span>
									if c.Advisory {
										{ " " }
										@ui.Badge(ui.ToneAccent, "Advisory")
									}
								</span>
								<span class="pol-fix-note">{ fixNote(c) }</span>
							</div>
						}
						if row.CRWarn != "" && row.Blocked == "" {
							<p class="pol-fix-skip" role="alert">{ row.CRWarn }</p>
						}
						if row.Blocked != "" {
							<p class="pol-fix-skip">{ row.Blocked }</p>
						}
						for _, s := range row.Skipped {
							<p class="pol-fix-skip">Not changed: { s.Label }: { s.Reason }</p>
						}
						if len(row.Options) > 0 {
							<fieldset class="pol-fix-adv">
								<legend>Advisory deviations <small>(a hint; included only when ticked, then choose Update plan)</small></legend>
								for _, o := range row.Options {
									<label class="pol-pickc"><input type="checkbox" form="fix-select" name="pick" value={ o.Pair } checked?={ o.Picked }/><span>{ o.Name }: has <span class="mono">{ o.Have }</span>, wants <span class="mono">{ o.Want }</span></span></label>
								}
							</fieldset>
						}
					</section>
				}
			</div>
			if hasFixOptions(p) {
				<form id="fix-select" method="post" action={ templ.SafeURL(base + "/policy/fix") } hidden>
					<input type="hidden" name="csrf" value={ csrf }/>
					for _, f := range p.Select {
						if f.Key == "device" {
							<input type="hidden" name="device" value={ f.Value }/>
						}
					}
				</form>
			}
			<form method="post" action={ templ.SafeURL(base + "/policy/fix/apply") } class="pol-fix-foot">
				<input type="hidden" name="csrf" value={ csrf }/>
				<input type="hidden" name="digest" value={ p.Digest }/>
				for _, f := range p.Fields {
					<input type="hidden" name={ f.Key } value={ f.Value }/>
				}
				if p.ByPick {
					<a class="btn" href={ templ.SafeURL(base + policyPath + "/deviations") }>Cancel</a>
				} else {
					<a class="btn" href={ templ.SafeURL(base + policyPath) }>Cancel</a>
				}
				if hasFixOptions(p) {
					<span class="pol-none" data-plan-stale hidden>Update plan to include ticked rows</span>
					<button type="submit" class="btn" form="fix-select">Update plan</button>
				}
				if len(p.IDs) > 0 {
					<button type="submit" class="btn btn-primary" data-plan-run>Run { plural(p.Commands, "change") }</button>
				}
			</form>
		}
	</div>
	<script src={ base + "/static/" + asset("policy.js") } defer></script>
}

// fixStartedPage answers Make compliant when the server left devices out; otherwise the answer
// is the transaction page.
templ fixStartedPage(base string, s fixStarted) {
	<div class="pol-page">
		@ui.PageHeader("Make compliant", "Transaction #"+vstr(int64(s.Batch))+" was started.") {
			<a class="btn btn-primary" href={ templ.SafeURL(base + "/transactions/" + vstr(int64(s.Batch))) }>Open the transaction</a>
			<a class="btn" href={ templ.SafeURL(base + policyPath) }>Back to policy</a>
		}
		if len(s.Skipped) > 0 {
			@ui.Card("Left out", "These devices were not included.") {
				<ul class="pol-fix-left">
					for _, x := range s.Skipped {
						<li>{ x.Label }: { x.Reason }</li>
					}
				</ul>
			}
		}
	</div>
}

// commandDescribedBy names the elements that describe the command field: the help, and
// the error when the field is invalid.
func commandDescribedBy(invalid bool) string {
	if invalid {
		return "err-command help-command"
	}
	return "help-command"
}

// hasFixOptions says whether some device of the plan has Advisory deviations to tick.
func hasFixOptions(p fixPage) bool {
	for _, r := range p.Rows {
		if len(r.Options) > 0 {
			return true
		}
	}
	return false
}
