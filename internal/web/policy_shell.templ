package web

import "github.com/hellwand/tasmofleet/internal/web/ui"

// policyShell is the header the policy tabs share: New rule, on Rules and Deviating devices the summary line
// (fleet counts and live check) and the tab row. The tab's own content is the child. Import / export is a tab;
// only the empty state, which has no tab row, keeps its Import… and Export buttons (#1088).
templ policyShell(h policyHead) {
	@ui.PageHeader("Policy", policySub) {
		if !h.Show {
			if h.Admin {
				@ui.Button(ui.Btn{Label: "Import…", Href: h.Base + policyIOPath + "?tab=import"})
			}
			@ui.Button(ui.Btn{Label: "Export", Href: h.Base + policyIOPath})
		}
		if h.Admin {
			@ui.Button(ui.Btn{Label: "New rule", Kind: "primary", Href: h.Base + rulesPath + "/new"})
		}
	}
	if h.Show {
		if h.Counts {
			@policySummary(h)
		}
		if len(h.Cooldown) > 0 {
			@policyCooldownNote(h)
		}
		@ui.Tabs("Policy views", h.Tabs)
	}
	{ children... }
}

// policyCooldownNote says which devices Run now left alone because they were read recently, and from when each
// can be read again (#989): without it a rule on such a device looks like the check did nothing.
templ policyCooldownNote(h policyHead) {
	@ui.Banner(ui.BannerData{Tone: ui.ToneAccent, Text: "Read less than " + liveCooldownText() + " ago, not read again: ", Attrs: templ.Attributes{"data-cooldown": true}}) {
		for _, c := range h.Cooldown {
			{ c.Name + " (from " }<time { ui.StampAttrs(c.Until, ui.StampDay)... }>{ ui.StampDayText(h.Now, c.Until) }</time>{ ")" + c.Sep }
		}
		if h.CooldownMore > 0 {
			{ "and " + plural(h.CooldownMore, "more device") }
		}
	}
}

// policySummary is the one block under the title of Rules and Deviating devices: the fleet counts
// as a sentence ("52 of 60 compliant · 3 deviating · 6 not judged", left out when the live check failed:
// no count pretends to be current) and the live check: its state, when it last ran, Run now and Pause /
// Resume (or Retry now after a failure).
templ policySummary(h policyHead) {
	<div class="pol-sum">
		if h.Sum != nil {
			<p class="pol-sum-line" data-sum>
				<span class="t-ok">{ h.Sum.Compliant } compliant</span>
				{ " · " }<span class={ toneClass(h.Sum.DeviatingTone) }>{ h.Sum.Deviating } deviating</span>
				if h.Line.State == "paused" && !h.Line.Shown.IsZero() {
					{ " (values from " }<time { ui.StampAttrs(h.Line.Shown, ui.StampClock)... }>{ ui.StampText(h.Line.Shown, ui.StampClock) }</time>{ ")" }
				}
				{ " · " + h.Sum.NotJudged + " not judged" }
			</p>
		}
		<div class="pol-sum-live" id="live-tile">
			<p class="pol-sum-state">
				if h.Line.State == "idle" {
					{ "Live check " }
				}
				<span class={ "pol-sum-v", toneClass(h.Line.Tone) }>{ h.Line.Value }</span>
				{ " · " }
				<span role="status">
					if h.Line.State == "paused" {
						Live check paused by { h.Line.PausedBy } at <time { ui.StampAttrs(h.Line.PausedAt, ui.StampClock)... }>{ ui.StampText(h.Line.PausedAt, ui.StampClock) }</time>
					} else {
						{ h.Line.Sub }
					}
				</span>
			</p>
			<div class="pol-line-acts">
				switch h.Line.State {
					case "failed":
						@policyLiveForm(h, "/policy/live", "Retry now")
					case "paused":
						if h.Line.CanPause {
							@policyLiveForm(h, "/policy/live/resume", "Resume")
						}
						@policyLiveForm(h, "/policy/live", "Run now")
					default:
						@policyLiveForm(h, "/policy/live", "Run now")
						if h.Line.CanPause {
							@policyLiveForm(h, "/policy/live/pause", "Pause")
						}
				}
			</div>
		</div>
	</div>
}

templ policyLiveForm(h policyHead, action, label string) {
	<form
		method="post"
		action={ templ.SafeURL(h.Base + action) }
		class="pol-inline"
		if action == "/policy/live" {
			id="live-check"
		}
	>
		<input type="hidden" name="csrf" value={ h.CSRF }/>
		if h.Back != "" && action == "/policy/live" {
			<input type="hidden" name="back" value={ h.Back }/>
		}
		@ui.Button(ui.Btn{Label: label, Small: true, Type: "submit"})
	</form>
}
