package web

import (
	"strconv"

	"github.com/nofuturekid/tasmofleet/internal/web/ui"
)

// What's new (design v2 screen "whatsnew", N5): this binary's changelog, newest first, with the
// installed release and the releases new since the user's last visit marked.

templ whatsNewPage(p whatsNewView) {
	<div class="page-whatsnew">
		@ui.PageHeader("What’s new in TasmoFleet", whatsNewSub(p))
		<div class="wn-stacks">
		@ui.CardStacks(3) {
		@ui.CardStack(2) {
			for _, r := range p.Releases {
				<section class="wn-rel r3" id={ "v" + r.Version } aria-labelledby={ "wn-h-" + r.Version }>
					<div class="wn-head">
						<h2 class="wn-v" id={ "wn-h-" + r.Version }>{ r.Version }</h2>
						if r.Name != "" {
							<span class="wn-name">“{ r.Name }”</span>
						}
						if r.Date != "" {
							<time class="wn-d" datetime={ r.Date }>{ isoDay(r.Date) }</time>
						}
						if r.Installed {
							@ui.Badge(ui.ToneOK, "Installed")
						}
						if r.New {
							@ui.Badge(ui.ToneAccent, "New since your last visit")
						}
					</div>
					if len(r.Intro) > 0 {
						<div class="wn-intro">
							for _, para := range r.Intro {
								<p>
									@fwInlines(para)
								</p>
							}
						</div>
					}
					for _, s := range r.Sections {
						<div class="wn-sec">
							<span class="wn-lbl">
								@ui.Badge(sectionTone(s.Title), s.Title)
							</span>
							<ul>
								for _, it := range s.Items {
									<li>
										@fwInlines(it.Text)
										if len(it.Sub) > 0 {
											<ul>
												for _, sub := range it.Sub {
													<li>
														@fwInlines(sub)
													</li>
												}
											</ul>
										}
									</li>
								}
							</ul>
						</div>
					}
				</section>
			}
		}
		@ui.CardStack(1) {
			<section class="ucard wn-you r1" aria-labelledby="wn-you-h">
				<h2 id="wn-you-h">You are on { p.Installed }</h2>
				if c := p.current(); c != nil && (c.Name != "" || c.Date != "") {
					<p class="wn-you-sub">
						if c.Name != "" {
							“{ c.Name }”
						}
						if c.Name != "" && c.Date != "" {
							{ " · " }
						}
						if c.Date != "" {
							{ isoDay(c.Date) }
						}
					</p>
				}
				<div class="btn-row">
					if p.IsAdmin {
						<a class="button" href={ templ.SafeURL(p.Base + "/about") }>About</a>
					}
					<a class="button" href={ templ.SafeURL(sourceURL + "/blob/main/CHANGELOG.md") } target="_blank" rel="noopener noreferrer">Full changelog</a>
				</div>
			</section>
			<section class="ucard wn-jump r2" aria-labelledby="wn-jump-h">
				<h2 id="wn-jump-h">Jump to a release</h2>
				<ul class="wn-jump-l">
					for _, r := range jumpNewest(p.Releases) {
						<li><a href={ templ.SafeURL("#v" + r.Version) }>{ r.Version }</a></li>
					}
				</ul>
				if older := jumpOlder(p.Releases); len(older) > 0 {
					<details class="wn-older">
						<summary>Older releases ({ strconv.Itoa(len(older)) })</summary>
						<ul class="wn-jump-l">
							for _, r := range older {
								<li><a href={ templ.SafeURL("#v" + r.Version) }>{ r.Version }</a></li>
							}
						</ul>
					</details>
				}
			</section>
		}
		}
		</div>
	</div>
}

// whatsNewSub is "You’re on 1.4.2 · last visit you saw 1.3.1".
func whatsNewSub(p whatsNewView) string {
	s := "You’re on " + p.Installed
	if p.Seen != "" {
		s += " · last visit you saw " + p.Seen
	}
	return s
}
