package web

import (
	"strconv"

	"github.com/hellwand/tasmofleet/internal/web/ui"
)

// What's new (design v2 screen "whatsnew", N5): this binary's changelog, newest first, with the
// installed release and the releases new since the user's last visit marked.

templ whatsNewPage(p whatsNewView) {
	<div class="page-whatsnew">
		@ui.PageHeader("What’s new in TasmoFleet", whatsNewSub(p))
		<div class="wn-stacks">
		@ui.CardStacks(3) {
		@ui.CardStack(2) {
			for _, r := range p.Releases {
				<section class="wn-rel r3" id={ "v" + r.Version } aria-labelledby={ "wn-h-" + r.Version }>
					<div class="wn-head">
						<h2 class="wn-v" id={ "wn-h-" + r.Version }>{ r.Version }</h2>
						if r.Name != "" {
							<span class="wn-name">“{ r.Name }”</span>
						}
						if r.Date != "" {
							<time class="wn-d" datetime={ r.Date }>{ isoDay(r.Date) }</time>
						}
						if r.Installed {
							@ui.Badge(ui.ToneOK, "Installed")
						}
						if r.New {
							@ui.Badge(ui.ToneAccent, "New since your last visit")
						}
					</div>
					if banner := wnActionBanner(r); banner != nil {
						@ui.Banner(*banner)
					}
					for _, s := range wnHeadlines(r) {
						<div class="wn-sec">
							<span class="wn-lbl">
								@ui.Badge(sectionTone(s.Title), s.Title)
							</span>
							<ul>
								for _, line := range s.Lines {
									<li>{ line }</li>
								}
							</ul>
						</div>
					}
					if len(r.Intro) > 0 || len(r.Sections) > 0 {
						<details class="fold">
							<summary>Details</summary>
							if len(r.Intro) > 0 {
								<div class="wn-intro">
									for _, para := range r.Intro {
										<p>
											@fwInlines(para)
										</p>
									}
								</div>
							}
							for _, s := range r.Sections {
								<div class="wn-sec">
									<span class="wn-lbl">
										@ui.Badge(sectionTone(s.Title), s.Title)
									</span>
									<ul>
										for _, it := range s.Items {
											<li>
												@fwInlines(it.Text)
												if len(it.Sub) > 0 {
													<ul>
														for _, sub := range it.Sub {
															<li>
																@fwInlines(sub)
															</li>
														}
													</ul>
												}
											</li>
										}
									</ul>
								</div>
							}
						</details>
					}
				</section>
			}
		}
		@ui.CardStack(1) {
			@ui.CardOf(ui.CardData{Title: "You are on " + p.Installed, Rank: 1, Class: "wn-you", LabelledBy: "wn-you-h"}) {
				if c := p.current(); c != nil && (c.Name != "" || c.Date != "") {
					<p class="wn-you-sub">
						if c.Name != "" {
							“{ c.Name }”
						}
						if c.Name != "" && c.Date != "" {
							{ " · " }
						}
						if c.Date != "" {
							{ isoDay(c.Date) }
						}
					</p>
				}
				<div class="btn-row">
					if p.IsAdmin {
						@ui.Button(ui.Btn{Label: "About", Href: p.Base + "/about"})
					}
					@ui.Button(ui.Btn{Label: "Full changelog", Href: sourceURL + "/blob/main/CHANGELOG.md", Target: "_blank", Rel: "noopener noreferrer"})
				</div>
			}
			@ui.CardOf(ui.CardData{Title: "Jump to a release", Rank: 2, Class: "wn-jump", LabelledBy: "wn-jump-h"}) {
				<ul class="wn-jump-l">
					for _, r := range p.Releases {
						<li><a href={ templ.SafeURL("#v" + r.Version) }>{ r.Version }</a></li>
					}
				</ul>
			}
		}
		}
		</div>
	</div>
}

// whatsNewSub is "You’re on 1.4.2 · last visit you saw 1.3.1", and says so when the page shows fewer releases
// than are new ("7 releases are new; the 2 older ones are in the full changelog").
func whatsNewSub(p whatsNewView) string {
	s := "You’re on " + p.Installed
	if p.Seen != "" {
		s += " · last visit you saw " + p.Seen
	}
	if p.NewCount > whatsNewShown {
		s += " · " + strconv.Itoa(p.NewCount) + " releases are new; the " + strconv.Itoa(p.NewCount-whatsNewShown) + " older ones are in the full changelog"
	}
	return s
}
