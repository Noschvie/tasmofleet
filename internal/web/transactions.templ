package web

import (
	"strconv"

	"github.com/hellwand/tasmofleet/internal/fwselect"
	"github.com/hellwand/tasmofleet/internal/model"

	"github.com/hellwand/tasmofleet/internal/web/ui"
)

// The Updates pages (design v2, WP P4): the transactions list ("updates"), one transaction
// ("txn"; a "Make compliant" transaction as the prototype's "compliant" screen) and the new
// update with its preview ("newupdate", "newupdate-v-preview"). CSS: app.css "page: Updates".

// transactionsPage is /transactions: the running transactions as cards, then the history. The
// list re-reads itself on job events (the cards' progress and the history's results move).
templ transactionsPage(p txListView) {
	@ui.PageHeader(txListTitle(p), txListSub(p)) {
		if p.CanStart {
			@ui.Button(ui.Btn{Label: "New update", Kind: "primary", Href: p.Base + "/updates/new"})
		}
	}
	<div hx-get={ p.Self } hx-trigger="sse:job throttle:2s" hx-select="#txlist" hx-target="#txlist" hx-swap="outerHTML">
		@txList(p)
	</div>
	@txnDialog(p.CSRF)
}

func txListTitle(p txListView) string {
	if p.Device != "" {
		return "Transactions of " + p.Device
	}
	return "Transactions"
}

func txListSub(p txListView) string {
	if p.Device != "" {
		return "Every transaction this device took part in; the result is the device's own"
	}
	return "Every bulk change runs as a transaction with a log per device"
}

templ txList(p txListView) {
	<div id="txlist" class="upd">
		if len(p.History) == 0 && len(p.Scheduled) == 0 {
			@ui.Card("", "") {
				@ui.Empty("No transactions yet", "Updates you start show up here.") {
					if p.CanStart {
						@ui.Button(ui.Btn{Label: "New update", Kind: "primary", Href: p.Base + "/updates/new"})
					}
				}
			}
		} else {
			for _, t := range p.Running {
				<div class="upd-run">
					@ui.TxnCard(t)
				</div>
			}
			if len(p.Scheduled) > 0 {
				<section id="scheduled" class="ulist upd-sched" aria-labelledby="sched-h">
					<div class="ulist-head"><h2 id="sched-h">Scheduled · { strconv.Itoa(len(p.Scheduled)) }</h2></div>
					<div class="upd-hhead upd-shead" aria-hidden="true"><span>ID</span><span>What</span><span>Devices</span><span>Planned start</span><span></span></div>
					for _, s := range p.Scheduled {
						<div class="upd-hrow upd-srow">
							<a class="upd-hid" href={ templ.SafeURL(s.Href) }>{ s.ID }</a>
							<a class="upd-htitle" href={ templ.SafeURL(s.Href) }>{ s.Title }</a>
							<span class="upd-hn">{ s.Devices }</span>
							<span class="upd-sstart">
								<span>Starts <b><time { ui.StampAttrs(s.Start, ui.StampWeekdayTime)... }>{ ui.StampText(s.Start, ui.StampWeekdayTime) }</time></b></span>
								<small><time { ui.StampAttrs(s.Start, ui.StampMonthDay)... }>{ ui.StampText(s.Start, ui.StampMonthDay) }</time> · { s.In } · { s.By }</small>
							</span>
							<span class="upd-sact">
								<a
									class="btn btn-sm"
									href={ templ.SafeURL(s.CancelHref) }
									data-dialog="dlg-txn"
									{ cancelScheduleWords(s.ID, s.CancelText).attrs(s.CancelHref)... }
									data-dlg-at={ ui.StampISO(s.Start) }
									data-dlg-ts={ ui.StampStart.Key }
									data-dlg-shown={ ui.StampText(s.Start, ui.StampStart) }
									aria-label={ "Cancel " + s.ID }
								>Cancel</a>
							</span>
						</div>
					}
				</section>
			}
			if len(p.History) > 0 {
			<section class="ulist upd-hist" aria-labelledby="hist-h">
				<div class="ulist-head"><h2 id="hist-h">History</h2></div>
				<div class="upd-hhead" aria-hidden="true"><span>ID</span><span>What</span><span>Devices</span><span>Result</span><span>Started by</span></div>
				for _, h := range p.History {
					<a class="upd-hrow" href={ templ.SafeURL(h.Href) }>
						<span class="upd-hid">{ h.ID }</span>
						<span class="upd-htitle">{ h.Title }</span>
						<span class="upd-hn">{ h.Devices }</span>
						<span class="upd-hst">
							@ui.Badge(h.Tone, h.Result)
						</span>
						<span class="upd-hwho">{ h.By } · { h.WhenLabel }<time datetime={ h.At } data-ts={ ui.StampDay.Key }>{ h.When }</time>{ h.Suffix }</span>
					</a>
				}
			</section>
			}
		}
	</div>
}

// batchPageView is /transactions/{batch}. The whole body re-reads itself on job events and, while
// the transaction runs, every 3 s (an event can arrive before its state is committed, and nothing
// follows the last one), keeping the device whose log is open (?job=).
templ batchPageView(p txnPage) {
	<div id="txn" hx-get={ p.LiveURL } hx-trigger="sse:job throttle:1s, sse:resync" hx-swap="innerHTML">
		@txnBody(p)
	</div>
	@txnDialog(p.CSRF)
}

// txnDialog is the confirmation of "Cancel remaining", filled by dialog.js from the button (the
// counts change while the transaction runs; the button in the live region carries the current
// ones). Without JavaScript the button is a link to the confirmation page.
templ txnDialog(csrf string) {
	<dialog id="dlg-txn" class="udlg" aria-labelledby="dlg-txn-h">
		<form method="post" action="" class="udlg-in" data-fill="form">
			<input type="hidden" name="csrf" value={ csrf }/>
			<h2 id="dlg-txn-h" data-fill="title"></h2>
			<p class="udlg-body" data-fill="text"></p>
			<div class="udlg-foot">
				<button type="button" class="btn" data-close data-fill="dismiss">Cancel</button>
				<button type="submit" class="btn btn-primary" data-fill="verb"></button>
			</div>
		</form>
	</dialog>
}

templ txnBody(p txnPage) {
	if p.Active && !p.Waiting {
		<span hidden hx-get={ p.LiveURL } hx-trigger="every 3s" hx-target="#txn" hx-swap="innerHTML"></span>
	}
	<div class="pghead upd-head">
		<div class="pghead-t">
			<div class="upd-h1">
				<h1>{ p.Title }</h1>
				@ui.BadgeOf(ui.BadgeData{Tone: p.StateTone, Label: p.State, Large: true, ID: "txn-state"})
			</div>
			if p.Sched != nil {
				<p class="pghead-sub"><span class="mono" data-visual-mask>{ p.ID }</span> · @schedSub(p.Sched)</p>
			} else if p.Template {
				<p class="pghead-sub"><span class="mono" data-visual-mask>{ p.ID }</span> · { p.SubPre }<time { ui.StampAttrs(p.SubAt, ui.StampShort)... }>{ ui.StampText(p.SubAt, ui.StampShort) }</time>{ p.SubPost }</p>
			} else {
				<p class="pghead-sub"><span class="mono" data-visual-mask>{ p.ID }</span> · { p.Sub }</p>
			}
			if p.RetryOf != 0 || len(p.RetriedBy) > 0 {
				<p class="pghead-sub upd-links">
					if p.RetryOf != 0 {
						Retry of <a href={ templ.SafeURL(p.Base + "/transactions/" + bid(p.RetryOf)) }>{ txID(p.RetryOf) }</a>
					}
					if len(p.RetriedBy) > 0 {
						Retried in
						for i, b := range p.RetriedBy {
							if i > 0 {
								,
							}
							<a href={ templ.SafeURL(p.Base + "/transactions/" + bid(b)) }>{ txID(b) }</a>
						}
					}
				</p>
			}
		</div>
		<div class="pghead-acts">
			if p.RetryN > 0 {
				if p.Active {
					@ui.Button(ui.Btn{Label: "Retry failed (" + strconv.Itoa(p.RetryN) + ")", DisabledReason: retryRunningWhy, ReasonID: "txn-retry-why", ReasonShared: true})
				} else {
					<a class="btn" href={ templ.SafeURL(p.Base + "/transactions/" + bid(p.Batch) + "/retry") }>Retry failed ({ strconv.Itoa(p.RetryN) })</a>
				}
			}
			if p.Sched != nil && p.Sched.Kind == "waiting" {
				<a
					class="btn"
					href={ templ.SafeURL(p.Base + "/transactions/" + bid(p.Batch) + "/cancel") }
					data-dialog="dlg-txn"
					{ cancelScheduleWords(p.ID, p.Sched.CancelText).attrs(p.Base + "/transactions/" + bid(p.Batch) + "/cancel")... }
					data-dlg-at={ ui.StampISO(p.Sched.Start) }
					data-dlg-ts={ ui.StampStart.Key }
					data-dlg-shown={ ui.StampText(p.Sched.Start, ui.StampStart) }
					aria-label={ "Cancel " + p.ID }
				>Cancel</a>
			} else if p.Active {
				<a
					class="btn"
					href={ templ.SafeURL(p.Base + "/transactions/" + bid(p.Batch) + "/cancel") }
					data-dialog="dlg-txn"
					{ cancelRemainingWords(p.ID, p.CancelText).attrs(p.Base + "/transactions/" + bid(p.Batch) + "/cancel")... }
				>Cancel remaining</a>
			}
			if p.Sched != nil && p.Sched.Again != nil {
				<form method="post" action={ templ.SafeURL(p.Base + p.Sched.Again.Action) } class="pol-inline">
					<input type="hidden" name="csrf" value={ p.CSRF }/>
					for _, f := range p.Sched.Again.Fields {
						<input type="hidden" name={ f.Key } value={ f.Value }/>
					}
					<button type="submit" class={ "btn", templ.KV("btn-primary", p.Sched.Kind == "notstarted") }>Plan again…</button>
				</form>
			}
			if p.CheckAgain != nil && len(p.CheckAgain.Fields) > 0 {
				<form method="post" action={ templ.SafeURL(p.Base + p.CheckAgain.Action) } class="pol-inline">
					<input type="hidden" name="csrf" value={ p.CSRF }/>
					for _, f := range p.CheckAgain.Fields {
						<input type="hidden" name={ f.Key } value={ f.Value }/>
					}
					<button type="submit" class="btn">Check again…</button>
				</form>
			} else if p.CheckAgain != nil {
				<a class="btn" href={ templ.SafeURL(p.Base + p.CheckAgain.Action) }>Check again…</a>
			}
			if p.Template {
				@ui.Button(ui.Btn{Label: "Back to policy", Kind: "primary", Href: p.Base + policyTemplatesPath})
			} else if p.Policy {
				@ui.Button(ui.Btn{Label: "Back to policy", Kind: "primary", Href: p.Base + "/policy"})
			}
		</div>
		if p.RetryN > 0 && p.Active {
			<p class="pghead-why" id="txn-retry-why">{ retryRunningWhy }</p>
		}
	</div>
	if p.Sched != nil && p.Sched.Kind == "notstarted" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Title: "Not started.", Text: "TasmoFleet was down at the planned start ("}) {
			<time { ui.StampAttrs(p.Sched.Start, ui.StampStart)... }>{ ui.StampText(p.Sched.Start, ui.StampStart) }</time>{ ") and was not back within " + strconv.Itoa(p.Sched.Minutes) + " minutes. It came back at " }<time { ui.StampAttrs(p.Sched.BackAt, p.Sched.BackFmt())... }>{ ui.StampText(p.Sched.BackAt, p.Sched.BackFmt()) }</time>{ ". No device was changed, and this update will not start later." }
		}
	}
	if p.Sched != nil && p.Sched.Kind == "waiting" {
		@schedWhen(p.Sched)
	}
	if !p.Waiting || p.Failed > 0 {
		@ui.CardOf(ui.CardData{ID: "batch-summary", Class: "upd-prog", Aria: "Progress"}) {
			@ui.SegBar(p.Bar)
			<div class="upd-counts" role="status">
				if p.NeverRan && p.Sched != nil && p.Sched.Kind == "notstarted" {
					<span><b>{ strconv.Itoa(p.Total) }</b> not started</span>
				} else if p.NeverRan {
					<span><b>{ strconv.Itoa(p.Total) }</b> cancelled</span>
				} else {
					if p.Policy || p.Template {
						<span><b>{ strconv.Itoa(p.Done) }</b> applied</span>
						<span><b class="upd-bad">{ strconv.Itoa(p.Failed) }</b> failed</span>
						if p.Running > 0 {
							<span><b>{ strconv.Itoa(p.Running) }</b> in progress</span>
						}
						if p.Queued > 0 {
							<span><b>{ strconv.Itoa(p.Queued) }</b> queued</span>
						}
					} else {
						<span><b>{ strconv.Itoa(p.Done) }</b> done</span>
						<span><b>{ strconv.Itoa(p.Running) }</b> in progress</span>
						<span><b>{ strconv.Itoa(p.Queued) }</b> queued</span>
						<span><b class="upd-bad">{ strconv.Itoa(p.Failed) }</b> failed</span>
					}
					if p.Planned > 0 {
						<span><b>{ strconv.Itoa(p.Planned) }</b> planned</span>
					}
					if p.Canceled > 0 && p.Template {
						<span><b>{ strconv.Itoa(p.Canceled) }</b> stopped</span>
					} else if p.Canceled > 0 {
						<span><b>{ strconv.Itoa(p.Canceled) }</b> cancelled</span>
					}
					if p.CancelPending > 0 {
						<span><b>{ strconv.Itoa(p.CancelPending) }</b> cancel requested</span>
					}
				}
				<span class="upd-of">of { strconv.Itoa(p.Total) }</span>
			</div>
			if p.Sched != nil && p.Sched.Kind == "ran" && !p.Sched.Started.IsZero() {
				<p class="upd-prog-note">
					if p.Sched.Instant() {
						Started on time, at the planned <time { ui.StampAttrs(p.Sched.Start, ui.StampClock)... }>{ ui.StampText(p.Sched.Start, ui.StampClock) }</time>.
					} else if p.Sched.OnTime() {
						Started on time, { p.Sched.LateText() } after the planned <time { ui.StampAttrs(p.Sched.Start, ui.StampClock)... }>{ ui.StampText(p.Sched.Start, ui.StampClock) }</time>.
					} else {
						Started { p.Sched.LateText() } after the planned <time { ui.StampAttrs(p.Sched.Start, ui.StampClock)... }>{ ui.StampText(p.Sched.Start, ui.StampClock) }</time>, within the { strconv.Itoa(p.Sched.Minutes) } minutes a late start is allowed.
					}
				</p>
			}
		}
	}
	if p.Sched != nil && p.Sched.Kind == "notstarted" {
		@ui.CardOf(ui.CardData{Class: "upd-prog", LabelledBy: "notif-h"}) {
			<div class="upd-when-card">
				<h2 id="notif-h">Notification</h2>
				<div class="upd-notif">
					<b>{ p.Sched.NoticeTitle }</b>
					<p>{ p.Sched.Notice }</p>
					<small>Sent once TasmoFleet was back, <time { ui.StampAttrs(p.Sched.BackAt, ui.StampDay)... }>{ ui.StampDayText(p.Sched.BackAt, p.Sched.BackAt) }</time>, when "Update job finished" is switched on in System, Notifications.</small>
				</div>
			</div>
		}
	}
	if p.Template {
		<div class="gt-txn">
			@ui.CardStacks(3) {
				for _, col := range tmplColumns(p.TCards) {
					@ui.CardStack(1) {
						for _, c := range col {
							@tmplCardView(c)
						}
					}
				}
			}
		</div>
	} else if p.Policy {
		<div class="upd-cards">
			for _, c := range p.Cards {
				<section class="upd-dev" aria-label={ c.Name }>
					<div class="upd-dev-head">
						<span class={ "upd-dot", "t-" + string(c.Tone) } aria-hidden="true"></span>
						<a href={ templ.SafeURL(c.Href) }>{ c.Name }</a>
					</div>
					for _, ch := range c.Changes {
						<div class="upd-change">
							<span class="upd-change-t">{ ch.Text }</span>
							@ui.Badge(ch.Tone, ch.Label)
							if ch.Have != "" {
								<span class="upd-change-have">device has <code>{ ch.Have }</code></span>
							}
							if ch.Note != "" {
								<span class="upd-change-have">{ ch.Note }</span>
							}
						</div>
					}
					if c.Reason != "" {
						<p class="upd-why">{ c.Reason }</p>
					}
					if c.Note != "" {
						<p class="upd-note">{ c.Note }</p>
					}
				</section>
			}
		</div>
	} else {
		<div class={ "upd-cols", templ.KV("upd-cols-one", p.Waiting || p.NeverRan) }>
			<section class="upd-rows" aria-label="Devices">
				for _, r := range p.Rows {
					<a class="upd-row" href={ templ.SafeURL(r.Href) } id={ "job-" + strconv.FormatInt(int64(r.JobID), 10) } if r.Selected {
						aria-current="true"
					}>
						<span class="upd-row-name">{ r.Name }</span>
						if r.From != "" || r.To != "" {
							<span class="upd-row-ver">
								{ r.From } → { r.To }
								if r.Upload {
									· upload
								}
								if r.Build != "" {
									· build { r.Build }
								}
							</span>
						}
						<span class="upd-row-state">
							@ui.Badge(r.Tone, r.Badge)
							if r.Bar {
								@ui.MiniBar(r.Pct)
							}
						</span>
					</a>
				}
			</section>
			if p.Sel != nil {
				<section class="upd-log" aria-labelledby="log-h">
					<div class="upd-log-head">
						<span id="log-h">Log · { p.Sel.Name }</span>
						<span class="upd-log-acts">
							if p.Sel.CanCancel {
								<a
									href={ templ.SafeURL(p.Base + "/jobs/" + jid(p.Sel.JobID) + "/cancel") }
									data-dialog="dlg-txn"
									{ cancelUpdateWords(p.Sel.Name, jobRunningCancelText, false).attrs(p.Base + "/jobs/" + jid(p.Sel.JobID) + "/cancel")... }
								>Cancel</a>
							}
							if p.Sel.CanRetry {
								<a href={ templ.SafeURL(p.Base + "/transactions/" + bid(p.Batch) + "/retry?id=" + strconv.FormatInt(int64(p.Sel.DeviceID), 10)) }>Retry</a>
							}
							<button type="button" data-copy="#log-lines">Copy log</button>
						</span>
					</div>
					<div class="upd-log-body" id="log-lines" tabindex="0" data-visual-mask>
						for _, l := range p.Sel.Log {
							<span class={ "upd-log-line", templ.KV("upd-log-err", l.Err) }><span class="upd-log-at"><time { ui.StampAttrs(l.At, ui.StampLog)... }>{ ui.StampText(l.At, ui.StampLog) }</time></span><span class="upd-log-t">@ui.SoftJSON(l.Text)</span></span>
						}
						if len(p.Sel.Log) == 0 {
							<span class="upd-log-line"><span class="upd-log-t">No events yet.</span></span>
						}
					</div>
				</section>
			}
		</div>
	}
}

// schedSub is the sub line of a planned update's page: who planned it, for when, and how it went.
templ schedSub(s *txnSched) {
	switch s.Kind {
		case "waiting":
			planned by { s.Who }, <time { ui.StampAttrs(s.Created, ui.StampDay)... }>{ ui.StampDayText(s.Created, s.Created) }</time> · { s.Tail }
		case "cancelled":
			planned by { s.Who }{ " for " }<time { ui.StampAttrs(s.Start, ui.StampStart)... }>{ ui.StampText(s.Start, ui.StampStart) }</time>
			if !s.CancelledAt.IsZero() {
				· cancelled by { s.CancelledBy }, <time { ui.StampAttrs(s.CancelledAt, ui.StampDay)... }>{ ui.StampDayText(s.CancelledAt, s.CancelledAt) }</time>
			}
		default:
			planned by { s.Who }{ " for " }<time { ui.StampAttrs(s.Start, ui.StampStart)... }>{ ui.StampText(s.Start, ui.StampStart) }</time>
			if !s.Started.IsZero() {
				· started <time { ui.StampAttrs(s.Started, ui.StampLog)... }>{ ui.StampText(s.Started, ui.StampLog) }</time>
			}
			· { s.Tail }
	}
}

// schedWhen is the card of a plan that waits: its start, the rule for a start that TasmoFleet misses (the words of
// the update preview) and what can be done until then.
templ schedWhen(s *txnSched) {
	@ui.CardOf(ui.CardData{Class: "upd-prog", Aria: "When"}) {
		<div class="upd-when-card">
			<p class="upd-when-big"><span>Starts <time { ui.StampAttrs(s.Start, ui.StampStart)... }>{ ui.StampText(s.Start, ui.StampStart) }</time></span> <small>· { s.In }</small></p>
			<p class="upd-rule"><b>If TasmoFleet is down at <time { ui.StampAttrs(s.Start, ui.StampClock)... }>{ ui.StampText(s.Start, ui.StampClock) }</time>,</b> the update starts as soon as TasmoFleet is back, but only until <time { ui.StampAttrs(s.Deadline(), ui.StampClock)... }>{ ui.StampText(s.Deadline(), ui.StampClock) }</time> ({ strconv.Itoa(s.Minutes) } minutes after the start time). If TasmoFleet is back later than that, the update is not started at all and TasmoFleet sends a notification. Devices are checked again when the update starts.</p>
		</div>
		<p class="upd-prog-note">Until it starts you can cancel it here. A running update cannot be changed this way.</p>
	}
}

// updateNewPage is /updates/new: 1 · Devices and 3 · Options in the wide stack, 2 · Release and the
// Plan in the narrow one; the form posts to the preview (step 4). Without JavaScript the plan shows the server's selection.
templ updateNewPage(f updateForm, csrf string) {
	@ui.PageHeader("New firmware update", "Pick devices and a release, check the plan, then start.")
	if f.Error != "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: f.Error, Alert: true})
	}
	<form id="picker" method="post" action={ templ.SafeURL(f.Base + "/updates/preview") }>
		<input type="hidden" name="csrf" value={ csrf }/>
		@ui.CardStacks(3) {
			@ui.CardStack(2) {
				<section class={ ui.StackRank(1), "ulist", "upd-pick" } aria-labelledby="dev-h">
					<div class="ulist-head">
						<h2 id="dev-h">1 · Devices</h2>
						<span class="upd-head-r">
							<span class="upd-n" data-select-n>{ strconv.Itoa(f.SelectedN()) } selected</span>
							if len(f.Options) > 0 {
								<details class="umenu upd-quick">
									<summary class="btn btn-link btn-sm">Select</summary>
									<div class="menu-panel" role="group" aria-label="Quick selection">
										<button type="submit" class="menu-item" form="pick-form" name="select" value="all" data-pick="all" data-picker="picker">All that can be updated</button>
										if f.Release != "" {
											<button type="submit" class="menu-item" form="pick-form" name="select" value="update" data-pick="update" data-picker="picker">All with an update to { f.Release }</button>
										}
										for _, fam := range f.Families {
											<button type="submit" class="menu-item" form="pick-form" name="select" value={ "family:" + fam.Family } data-pick={ "family:" + fam.Family } data-picker="picker">All { chipNameOf(fam.Family) } ({ strconv.Itoa(fam.Count) })</button>
										}
										<button type="submit" class="menu-item" form="pick-form" name="select" value="none" data-pick="none" data-picker="picker">None</button>
									</div>
								</details>
							}
						</span>
					</div>
					if len(f.Options) == 0 {
						<p class="upd-none">No devices.</p>
					} else {
						<div class="upd-pick-list">
							for _, o := range f.Options {
								<label
									class="upd-pick-row"
									data-family={ string(o.Device.Identity.Family) }
									data-file={ o.File }
									if o.Update {
										data-update="1"
									}
									if o.Blocked != "" {
										title={ "Not selectable: " + o.Blocked }
									}
								>
									<input type="checkbox" name="id" value={ strconv.FormatInt(int64(o.Device.ID), 10) } aria-label={ "Select " + o.Device.Name } checked?={ o.Selected } disabled?={ o.Blocked != "" }/>
									<span class={ "upd-dot", "t-" + string(o.Dot) } aria-hidden="true"></span>
									<span class="upd-pick-name">{ o.Device.Name }</span>
									if o.Blocked != "" && o.Blocked != o.Status {
										<small class="upd-pick-why">{ o.Blocked }</small>
									}
									<small class="upd-pick-fw">{ o.ChipVersion() }</small>
								</label>
							}
						</div>
					}
				</section>
				@ui.CardOf(ui.CardData{Title: "3 · Options", Rank: 3, Class: "upd-opts", LabelledBy: "opt-h"}) {
					<input type="hidden" name="backup_shown" value="1"/>
					<label class="upd-opt"><input type="checkbox" name="backup" value="1" checked?={ !f.SkipBackup }/>Back up each device before flashing</label>
					<label class="upd-opt">
						Policy
						<select name="policy">
							for _, o := range f.PolicyOpts() {
								<option value={ o.Value } title={ o.Text } selected?={ o.Checked }>{ o.Label }</option>
							}
						</select>
					</label>
					<label class="upd-opt">
						Delivery
						<select name="delivery">
							for _, o := range f.DeliveryOpts() {
								<option value={ o.Value } selected?={ o.Checked }>{ o.Label }</option>
							}
						</select>
					</label>
					<label class="upd-opt">
						Variant override
						<input name="variant" value={ f.Variant } placeholder="keep the detected variant"/>
					</label>
				}
			}
			@ui.CardStack(1) {
				@ui.CardOf(ui.CardData{Title: "2 · Release", Rank: 2, Class: "upd-rel", LabelledBy: "rel-h"}) {
					for _, o := range f.RelOpts {
						@relOption(o)
					}
					if len(f.OlderRels) > 0 {
						<details class="upd-older">
							<summary class="btn btn-link btn-sm">Older releases ({ strconv.Itoa(len(f.OlderRels)) })</summary>
							for _, o := range f.OlderRels {
								@relOption(o)
							}
						</details>
					}
					if len(f.RelOpts) == 0 {
						<p class="upd-none">No release is known yet. Open Firmware to check for releases.</p>
					}
				}
				@ui.CardOf(ui.CardData{Title: "Plan", Rank: 4, Class: "upd-aside", LabelledBy: "plan-h"}) {
					<dl class="upd-facts">
						<dt>Devices</dt><dd data-plan-devices>{ strconv.Itoa(f.SelectedN()) }</dd>
						<dt>Firmware files</dt><dd data-plan-files>{ strconv.Itoa(f.FileCount()) }</dd>
						<dt>Estimated time</dt><dd data-plan-est data-parallel={ strconv.Itoa(f.Parallel) } data-per-device={ strconv.Itoa(int(updatePerDevice.Seconds())) }>{ updateEstimate(f.SelectedN(), f.Parallel) }</dd>
					</dl>
					<ol class="upd-steps">
						<li data-plan-backup hidden?={ f.SkipBackup }>Back up each device</li>
						<li>Upload firmware, { strconv.Itoa(f.Parallel) } at a time</li>
						<li>Wait for each device to come back and confirm the version</li>
					</ol>
					<p class="upd-hint" role="status" data-push-hint hidden></p>
					@ui.Button(ui.Btn{Label: "Review update", Kind: "primary", Tall: true, Type: "submit"})
				}
			}
		}
	</form>
	<form id="pick-form" method="get" action={ templ.SafeURL(f.Base + "/updates/new") }></form>
}

templ relOption(o ui.Option) {
	<label class="upd-relopt">
		<input type="radio" name="release" value={ o.Value } checked?={ o.Checked }/>
		<span class="upd-relopt-t">{ o.Label }</span>
		<small class="upd-relopt-d">{ o.Text }</small>
	</label>
}

// updatePreviewPage is the answer to "Review update" (step 4): what each device gets and what
// happens, then Start update. It is a page of its own, so it also works without JavaScript.
templ updatePreviewPage(p previewPage, csrf string) {
	@ui.PageHeader("New firmware update", "Pick devices and a release, check the plan, choose when to start.")
	<div class="upd-split upd-split-prev">
		<div class="upd-main">
		<section class="ulist upd-prev" aria-labelledby="prev-h">
			<div class="ulist-head">
				<h2 id="prev-h">4 · Preview · { plural(p.Upgrades(), "device") }</h2>
				<button type="submit" class="btn btn-link btn-sm" form="change">Change</button>
			</div>
			<div class="upd-prev-list">
				for _, r := range p.Rows {
					<div class="upd-prow">
						<span class="upd-prow-name">{ r.Device.Name }</span>
						if r.Go {
							<span class="upd-prow-ver"><span class="upd-from">{ r.From }</span> → <b>{ r.To }</b></span>
							<span class="upd-prow-file" title={ r.Item.Filename }>{ r.FileText() }</span>
						} else {
							<span class="upd-prow-dec">
								if len(r.BuildOptions) > 0 || r.LanguageChoice || r.StepOffered() {
									@ui.Badge(ui.ToneWarn, "Needs a choice")
								} else {
									@ui.Badge(r.Tone(), label(r.Item.Decision))
								}
							</span>
							if r.LanguageChoice {
								<span class="upd-prow-why" title={ r.Item.Reason }>The device does not report a language build TasmoFleet knows, and the wrong one would change the device's language.</span>
							} else if r.Item.VariantChoice {
								<span class="upd-prow-why" title={ r.Item.Reason }>{ r.VariantChoiceText() }</span>
							} else if len(r.BuildOptions) > 0 && r.Build == "" {
								<span class="upd-prow-why">This chip has two builds that cannot be told apart from the device.</span>
							} else {
								<span class="upd-prow-why" title={ r.Item.Reason }>{ humanReason(r.Item.Reason) }</span>
							}
						}
						if len(r.BuildOptions) > 0 {
							<fieldset class="rcards upd-prow-build">
								<legend>Choose the build</legend>
								for _, o := range r.BuildOptions {
									<label class="rcard">
										<input type="radio" name={ r.BuildName() } value={ o.Value } form="recheck" checked?={ r.Build == o.Value } required/>
										<span class="rcard-body"><b>{ o.Label }</b><span>{ o.Text }</span></span>
									</label>
								}
							</fieldset>
						}
						if r.Remembered {
							<span class="upd-prow-note upd-prow-mem">
								<span>Build { r.Build } · remembered from your last update</span>
								<button type="submit" class="btn btn-link btn-sm" form="recheck" name="change_build" value={ strconv.FormatInt(int64(r.Device.ID), 10) } formnovalidate>Change</button>
								<button type="submit" class="btn btn-link btn-sm" form="recheck" name="forget_build" value={ strconv.FormatInt(int64(r.Device.ID), 10) } formnovalidate>Forget</button>
							</span>
						}
						if r.LanguageChoice {
							<label class="upd-prow-build">
								Language build of this device
								<select name={ r.LanguageName() } form="recheck" required>
									<option value="">Choose the language</option>
									for _, o := range languageOptions {
										<option value={ o.Value } selected?={ r.Language == o.Value }>{ o.Label }</option>
									}
								</select>
							</label>
						}
						if r.PathText() != "" {
							<span class="upd-prow-note" data-path>{ r.PathText() }</span>
						}
						if r.Go && r.Item.Plan == model.PlanStaged {
							<span class="upd-prow-note">Staged: minimal firmware first, then the release.</span>
						}
						if r.DeliveryText() != "" {
							<span class="upd-prow-note">{ r.DeliveryText() }</span>
						}
						if r.Note != "" {
							<span class="upd-prow-note">{ r.Note }</span>
						}
					</div>
				}
			</div>
			if len(p.StepIDs()) > 0 {
				// The settings-migration step (#892) is a preview of its own: one release per batch, checked like any
				// release the person picks.
				<div class="upd-prev-foot">
					<p class="upd-hint">Devices older than { fwselect.MigrationFloor } take Tasmota { fwselect.StepRelease } first, in an update of their own.</p>
					<button type="submit" class="btn" form="step">{ p.StepActionText() }</button>
				</div>
			}
			if p.ChoosingBuilds() > 0 || p.ChoosingLanguages() > 0 {
				<div class="upd-prev-foot">
					if p.ChoosingLanguages() == 0 {
						<p class="upd-hint">Nothing is guessed: choose the build of each device, then recheck.</p>
					} else {
						<p class="upd-hint">Nothing is guessed: choose the build or language of each device, then recheck.</p>
					}
					<button type="submit" class="btn btn-primary" form="recheck">Recheck</button>
				</div>
			}
		</section>
		@whenCard(p.When)
		</div>
		@ui.CardOf(ui.CardData{Title: "What happens", Tag: "aside", Class: "upd-aside upd-what", LabelledBy: "what-h"}) {
			<dl class="upd-facts upd-facts-wide">
				<dt>Target</dt><dd><b>{ p.ReleaseText }</b></dd>
				<dt>Starts</dt>
				<dd data-starts>
					switch p.When.Mode {
						case "set":
							<b>{ p.When.StartsText() }</b> · { p.When.StartsIn() }
						case "past":
							<span class="upd-warn-text">Not set: the time is in the past</span>
						case "unset":
							<span class="upd-warn-text">Not set yet: choose a quick pick or a time</span>
						default:
							<b>Now</b> · when you press Start update
					}
				</dd>
				<dt>Devices</dt><dd><b>{ strconv.Itoa(p.Upgrades()) }</b></dd>
				if p.Refused() > 0 {
					<dt>Refused</dt><dd class="upd-bad">{ plural(p.Refused(), "device") }</dd>
				}
				if p.ChoosingBuilds()+p.ChoosingLanguages()+len(p.StepIDs()) > 0 {
					<dt>Needs a choice</dt><dd class="upd-warn">{ plural(p.ChoosingBuilds()+p.ChoosingLanguages()+len(p.StepIDs()), "device") }</dd>
				}
				if p.Skips() > 0 {
					<dt>Skipped</dt><dd>{ plural(p.Skips(), "device") }</dd>
				}
				<dt>Files</dt><dd>{ strconv.Itoa(len(p.Files)) }</dd>
				if len(p.Files) > 0 {
					<dt>Download first</dt><dd>Nothing</dd>
					<dt>From cache</dt><dd class="mono">{ joinComma(p.Files) }</dd>
				}
				if p.Bytes > 0 {
					<dt>Sent to devices</dt><dd>{ sizeText(p.Bytes) } over the LAN</dd>
				}
				<dt>Delivery</dt>
				<dd data-visual-mask>
					{{ lead, url, tail := p.Delivery() }}
					{ lead }
					if url != "" {
						<span class="upd-url">@ui.Soft(url)</span>
					}
					{ tail }
				</dd>
				<dt>Estimated</dt><dd>{ updateEstimate(p.Upgrades(), p.Parallel) }</dd>
			</dl>
			<p class="upd-rule" data-starts-rule data-late={ strconv.Itoa(p.When.LateMinutes()) } hidden?={ !p.When.ShowRule() }><b>If TasmoFleet is down at <span data-clock>{ p.When.RuleClock() }</span>,</b> the update starts as soon as TasmoFleet is back, but only until <span data-deadline>{ p.When.RuleDeadline() }</span> ({ strconv.Itoa(p.When.LateMinutes()) } minutes after the start time). If TasmoFleet is back later than that, the update is not started at all and TasmoFleet sends a notification. Devices are checked again when the update starts.</p>
			<div class="upd-go">
				@ui.Button(ui.Btn{Label: "Back", Tall: true, Type: "submit", Form: "change"})
				if len(p.IDs) > 0 {
					@ui.Button(ui.Btn{Label: p.When.ButtonText(), Kind: "primary", Tall: true, Type: "submit", Form: "start", ID: "start-go"})
				}
			</div>
			if len(p.IDs) == 0 && p.ChoosingBuilds()+p.ChoosingLanguages() == 0 && len(p.StepIDs()) > 0 {
				<p class="upd-hint">These devices take Tasmota { fwselect.StepRelease } first: preview it above.</p>
			} else if len(p.IDs) == 0 && p.ChoosingBuilds()+p.ChoosingLanguages() > 0 {
				if p.ChoosingLanguages() == 0 {
					<p class="upd-hint">Choose a build above, then recheck.</p>
				} else {
					<p class="upd-hint">Choose above, then recheck.</p>
				}
			} else if len(p.IDs) == 0 {
				<p class="upd-hint">No device can be updated with these settings.</p>
			}
		}
	</div>
	<form id="start" method="post" action={ templ.SafeURL(p.Base + "/updates") }>
		@previewFields(p, csrf, p.IDs, true)
		for _, id := range p.Picked {
			<input type="hidden" name="picked" value={ id }/>
		}
		<input type="hidden" name="start_at" data-start-at/>
	</form>
	<form id="change" method="post" action={ templ.SafeURL(p.Base + "/updates/new") }>
		@previewFields(p, csrf, p.Picked, false)
	</form>
	<form id="recheck" method="post" action={ templ.SafeURL(p.Base + "/updates/preview") }>
		@previewFields(p, csrf, p.Picked, false)
		if p.When.At {
			// "Plan again…" opened on the time choice; a recheck (a language, a build) must keep it, or the page
			// would come back on "Start now" with the main button armed to flash at once (#825).
			<input type="hidden" name="when" value="at"/>
			if p.When.Preset() != "" {
				<input type="hidden" name="start_at" value={ p.When.Preset() }/>
			}
		}
	</form>
	if len(p.StepIDs()) > 0 {
		<form id="step" method="post" action={ templ.SafeURL(p.Base + "/updates/preview") }>
			@stepFields(p, csrf)
		</form>
	}
}

// whenCard is "5 · When" of the preview: Start now (the default) or Start at a chosen time with the quick picks
// and the fields of Other time. Its inputs belong to the form "start", so they travel with Start update.
// static/updatestart.js recomputes the picks in the browser's zone and keeps the plan's "Starts" row in step.
templ whenCard(w whenState) {
	@ui.CardOf(ui.CardData{Title: "5 · When", Class: "upd-when", LabelledBy: "when-h", Attrs: w.cardAttrs()}) {
		<fieldset class="rcards">
			<legend class="sr-only">When does the update start?</legend>
			<label class="rcard"><input type="radio" name="when" id="when-now" value="now" form="start" checked?={ !w.At }/><span class="rcard-body"><b>Start now</b><span>The update starts as soon as you press Start update.</span></span></label>
			<label class="rcard"><input type="radio" name="when" id="when-at" value="at" form="start" checked?={ w.At }/><span class="rcard-body"><b>Start at a chosen time</b><span>Plan this update for later, for example overnight. It is listed in Transactions until it starts, and you can cancel it there.</span></span></label>
		</fieldset>
		<div class="upd-when-at">
			<fieldset class="upd-picks">
				<legend>Quick picks</legend>
				for _, pk := range w.Picks {
					<label class="chip"><input type="radio" name="at" value={ pk.Value() } form="start" data-kind={ pk.Kind } checked?={ w.Picked == pk.Value() }/><span class="chip-main">{ pk.Label }</span><span class="chip-sub">{ pk.Date() }</span></label>
				}
				<label class="chip"><input type="radio" name="at" value="custom" form="start" data-kind="custom" checked?={ w.Picked == "custom" }/><span class="chip-main">Other time</span><span class="chip-sub">Choose below</span></label>
			</fieldset>
			<div class="upd-custom">
				<label>Date<input type="date" name="at_date" form="start" value={ w.Date }
					if w.Invalid() {
						aria-invalid="true" aria-describedby="when-err"
					}
				/></label>
				<label>Time<input type="time" name="at_time" form="start" value={ w.Time }
					if w.Invalid() {
						aria-invalid="true" aria-describedby="when-err"
					}
				/></label>
			</div>
			<p class="upd-err" id="when-err" role="alert" data-now={ w.Now.Format("2006-01-02T15:04:05Z07:00") } hidden?={ !w.Invalid() }>{ w.Err }</p>
			<p class="upd-tz" data-tz>Times are in the server's time zone ({ w.ZoneText() }).</p>
		</div>
	}
}

// previewFields carry the choice of the preview to the start or back to the picker. A build that comes
// from the device's memory goes to the start only: carried through a recheck it would turn into a
// posted pick ("chosen by you"), and the memory applies again by itself.
templ previewFields(p previewPage, csrf string, ids []string, start bool) {
	<input type="hidden" name="csrf" value={ csrf }/>
	for _, id := range ids {
		<input type="hidden" name="id" value={ id }/>
	}
	<input type="hidden" name="release" value={ p.Form.Release }/>
	<input type="hidden" name="policy" value={ p.Form.Policy }/>
	<input type="hidden" name="variant" value={ p.Form.Variant }/>
	if p.Form.SkipBackup {
		<input type="hidden" name="skip_backup" value="1"/>
	}
	<input type="hidden" name="delivery" value={ p.Form.Delivery }/>
	for _, id := range ids {
		if b := p.Builds[id]; b != "" && (start || !p.RememberedIDs[id]) {
			<input type="hidden" name={ "build_" + id } value={ b }/>
		}
		if l := p.Languages[id]; l != "" {
			<input type="hidden" name={ "language_" + id } value={ l }/>
		}
	}
}

// stepFields open the preview of the settings-migration step (#892): the step devices only, the step release, and
// the person's other choices (policy, variant, backup, delivery, the time of a plan). Builds and languages are not
// carried: those rows were refused before either was asked, and the step preview asks anew.
templ stepFields(p previewPage, csrf string) {
	<input type="hidden" name="csrf" value={ csrf }/>
	for _, id := range p.StepIDs() {
		<input type="hidden" name="id" value={ id }/>
	}
	<input type="hidden" name="release" value={ fwselect.StepRelease }/>
	<input type="hidden" name="policy" value={ p.Form.Policy }/>
	<input type="hidden" name="variant" value={ p.Form.Variant }/>
	if p.Form.SkipBackup {
		<input type="hidden" name="skip_backup" value="1"/>
	}
	<input type="hidden" name="delivery" value={ p.Form.Delivery }/>
	if p.When.At {
		<input type="hidden" name="when" value="at"/>
		if p.When.Preset() != "" {
			<input type="hidden" name="start_at" value={ p.When.Preset() }/>
		}
	}
}

// tmplCardView is one device of an "Apply GPIO template" transaction: backup, read again, send, verify.
// Mockup: gpio-templates-mockup/3a and 3b.
templ tmplCardView(c tmplCard) {
	<section class={ "upd-dev", c.Rank } aria-label={ c.Name }>
		<div class="upd-dev-head">
			<span class={ "upd-dot", "t-" + string(c.Tone) } aria-hidden="true"></span>
			<a href={ templ.SafeURL(c.Href) }>{ c.Name }</a>
		</div>
		for _, st := range c.Steps {
			<div class="upd-change">
				<div class="upd-change-t gt-step">
					if st.Cmd != "" {
						<details class="gt-cmd-d">
							<summary>{ st.Text }</summary>
							<pre class="gt-cmd">{ st.Cmd }</pre>
						</details>
					} else if !st.Backup.At.IsZero() {
						{ st.Text } · <a href={ templ.SafeURL(st.Backup.Href) }>backup <time { ui.StampAttrs(st.Backup.At, ui.StampShort)... }>{ ui.StampText(st.Backup.At, ui.StampShort) }</time></a>
					} else {
						{ st.Text }
					}
				</div>
				@ui.Badge(st.Tone, st.Label)
			</div>
		}
		if c.Reason != "" {
			<p class={ "upd-why", templ.KV("gt-stopped", c.Stopped) }>{ c.Reason }</p>
		}
	</section>
}
