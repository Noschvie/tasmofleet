package web

import "github.com/hellwand/tasmofleet/internal/web/ui"

// pathsCard is the Connection card (#261, #1112): the address TasmoFleet uses and the IP the device reports at its top,
// then how TasmoFleet reaches the device and which way each action takes. It sits under Stability and the medium's card
// (Wi-Fi or Ethernet), and is never dimmed (it explains an offline device). Both lists are folds, closed so the phone
// overview keeps its height budget. The live refresh swaps the summaries and the lists by id (pathsLive), never the
// folds, so an open fold stays open. The address rows are rendered also when the paths could not be read (c is nil).
// The Forget button is the admin's: a viewer without it sees the card read-only.
templ pathsCard(addr []ui.KVRow, c *pathCard) {
	<section id="devpaths" class={ "devcard", ui.StackRank(4) } aria-labelledby="dc-paths">
		<div class="devcard-head"><h2 id="dc-paths">{ connectionTitle }</h2></div>
		@ui.KV(addr)
		if c != nil {
			<details class="fold">
				@pathSummary("devpaths-facts-sum", c.FactsSummary(), nil)
				@pathList("devpaths-facts", c.Facts, *c, nil)
			</details>
			<details class="fold">
				@pathSummary("devpaths-actions-sum", c.ActionsSummary(), nil)
				@pathList("devpaths-actions", c.Actions, *c, nil)
			</details>
		}
	</section>
}

// pathsLive is the live refresh of the card: the four parts out of band.
templ pathsLive(c pathCard) {
	@pathSummary("devpaths-facts-sum", c.FactsSummary(), templ.Attributes{"hx-swap-oob": "true"})
	@pathList("devpaths-facts", c.Facts, c, templ.Attributes{"hx-swap-oob": "true"})
	@pathSummary("devpaths-actions-sum", c.ActionsSummary(), templ.Attributes{"hx-swap-oob": "true"})
	@pathList("devpaths-actions", c.Actions, c, templ.Attributes{"hx-swap-oob": "true"})
}

templ pathSummary(id, text string, attrs templ.Attributes) {
	<summary id={ id } { attrs... }>{ text }</summary>
}

templ pathList(id string, rows []pathRow, c pathCard, attrs templ.Attributes) {
	<dl id={ id } class="ukv" { attrs... }>
		for _, r := range rows {
			<div class="ukv-row">
				<dt>
					{ r.Key }
					if r.Experiment {
						{ " " }
						@ui.Badge(ui.ToneAccent, "Experimental")
					}
				</dt>
				<dd>
					<div>@ui.Badge(r.Tone, r.Value)</div>
					if r.Sub != "" {
						<p class="devcard-note">
							@keepTogether(r.Sub)
							if !r.StampAt.IsZero() {
								{ r.StampLead + " " }<time data-visual-mask { ui.StampAttrs(r.StampAt, ui.StampRelative)... }>{ r.StampText }</time>{ r.StampTail }
							}
							if r.Enables != "" {
								{ " " + r.Enables }
							}
							if !r.Since.IsZero() {
								{ " Since " }
								<time data-visual-mask { ui.StampAttrs(r.Since, ui.StampRelative)... }>{ r.SinceText }</time>.
							}
						</p>
					}
					if a := r.PWActs; a != nil {
						<div class="pw-acts">
							if a.Test && a.TestWhy == "" && c.PWTest != "" {
								<form method="post" action={ templ.SafeURL(c.PWTest) }>
									<input type="hidden" name="csrf" value={ c.CSRF }/>
									@ui.Button(ui.Btn{Label: a.TestLabel, Kind: "link", Type: "submit"})
								</form>
							} else if a.Test {
								@ui.Button(ui.Btn{Label: a.TestLabel, Kind: "link", Disabled: true, Attrs: templ.Attributes{"aria-describedby": "pw-test-why"}})
							}
							if a.Change && c.PWChange != "" {
								@ui.Button(ui.Btn{Label: a.ChangeLabel, Kind: "link", Href: c.PWChange})
							}
							if a.UseBroker && c.PWBroker != "" {
								@ui.Button(ui.Btn{Label: "Use the broker password…", Kind: "link", Href: c.PWBroker})
							}
						</div>
						if a.ACL {
							@ui.BrokerACLNotice()
						}
						if a.Test && a.TestWhy != "" {
							<p class="devcard-note" id="pw-test-why">{ connTestWhyLead + sentence(a.TestWhy) }</p>
						}
					}
					if r.Forget && c.Forget != "" {
						<form method="post" action={ templ.SafeURL(c.Forget) }>
							<input type="hidden" name="csrf" value={ c.CSRF }/>
							@ui.Button(ui.Btn{Label: "Forget", Kind: "link", Type: "submit"})
						</form>
					}
				</dd>
			</div>
		}
	</dl>
}
