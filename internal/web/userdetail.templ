package web

import (
	"strconv"

	"github.com/hellwand/tasmofleet/internal/auth"
	"github.com/hellwand/tasmofleet/internal/web/ui"
)

// The user detail page and the temporary password page (design v2 screens user-u1..u5 and userotp,
// N4), in the app shell.

templ userDetailPage(v userDetailView) {
	<div class="ud-head">
		@ui.Avatar(v.Avatar, v.D.User.Subject)
		<div class="ud-who">
			<h1>
				<span>{ v.Title }</span>
				if v.Role != "" {
					@ui.Badge(roleTone(v.D.User.Role == "admin"), v.Role)
				}
				if v.Self {
					@ui.Badge(ui.ToneNeutral, "You")
				}
				if v.D.User.Disabled {
					@ui.Badge(ui.ToneNeutral, "Deactivated")
				}
				if v.D.User.MustChangePassword {
					@ui.Badge(ui.ToneWarn, passwordChangeDue)
				}
			</h1>
			<p class="ud-sub">{ v.Sub }</p>
		</div>
	</div>
	<div class="btn-row ud-acts" aria-label="User actions" role="group">
		// Only Delete (the menu's last item, after its rule) reads red, here as in the row menu; Deactivate is a
		// default button in both places and danger-solid in its dialog.
		for _, a := range v.Actions {
			if a.Disabled {
				@ui.Button(ui.Btn{Label: a.Label, Disabled: true, DisabledReason: a.Why, ReasonID: v.reasonID(a.Label), ReasonShared: true})
			} else {
				@ui.Button(ui.Btn{Label: a.Label, Kind: userActionKind(a), Href: a.Href, Dialog: a.Dialog})
			}
		}
	</div>
	if len(v.Reasons) > 0 || v.Why != "" {
		<div class="ud-whys">
			// why the disabled buttons are, one line per reason; each button names its line (#1072)
			for i, g := range v.Reasons {
				<p class="ud-why" id={ udReasonID(i) }>{ g.Lead() }: { g.Why }</p>
			}
			if v.Why != "" {
				<p class="ud-why">{ v.Why }</p>
			}
		</div>
	}
	@usersBanners(auth.UsersPageData{Notice: v.D.Notice, Error: v.D.Error, ErrField: v.D.ErrField, ViewOnly: v.D.ViewOnly})
	if v.D.User.Disabled {
		@ui.Banner(ui.BannerData{Tone: ui.ToneNeutral, Title: "Deactivated.", Text: "Can’t sign in; all sessions were ended.", Class: "ud-off", Action: v.reactivateAction()})
	}
	if v.Info != "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneAccent, Text: v.Info, ID: udInfoID})
	}
	<div class="ud-grid">
		@ui.CardOf(ui.CardData{Title: "Details", Class: "ud-details", LabelledBy: "ud-details-h"}) {
			@ui.KV(v.Facts)
			if v.D.User.Method == auth.MethodLocal && v.D.Guards.Profile.Allowed && !v.D.ViewOnly {
				<details class="fold ud-edit" open?={ v.ProfileOpen }>
					<summary>Edit name and email</summary>
					<form class="acct-form" method="post" action={ templ.SafeURL(v.LocalAction) }>
						<input type="hidden" name="csrf" value={ v.D.CSRFToken }/>
						<input type="hidden" name="action" value="profile"/>
						<input type="hidden" name="from" value="detail"/>
						@ui.Field(ui.FieldData{Label: "Name", Name: "display_name", Value: v.D.DisplayName, Autocomplete: "off", Error: fieldErr(v.D.ErrField, "display_name", v.D.Error), Autofocus: focus(v.D.ErrField, "display_name", false)})
						@ui.Field(ui.FieldData{Label: "Email (optional)", Name: "email", Type: "email", Value: v.D.Email, Autocomplete: "off", Error: fieldErr(v.D.ErrField, "email", v.D.Error), Autofocus: focus(v.D.ErrField, "email", false)})
						@udSubmit(v, "Save profile")
					</form>
				</details>
			}
			if v.D.User.Method == auth.MethodLocal && v.D.Guards.Reset.Allowed && !v.D.ViewOnly {
				<details class="fold ud-edit" open?={ v.PasswordOpen }>
					<summary>Set a password instead</summary>
					<form class="acct-form" method="post" action={ templ.SafeURL(v.LocalAction) }>
						<input type="hidden" name="csrf" value={ v.D.CSRFToken }/>
						<input type="hidden" name="action" value="password"/>
						<input type="hidden" name="from" value="detail"/>
						@ui.Field(ui.FieldData{Label: "New password", Name: "password", Type: "password", Autocomplete: "new-password", Help: "At least " + strconv.Itoa(auth.PasswordMinLength) + " characters. You tell them yourself; they change it at the next sign-in.", Error: fieldErr(v.D.ErrField, "password", v.D.Error), Autofocus: focus(v.D.ErrField, "password", false)})
						@udSubmit(v, "Set password")
					</form>
				</details>
			}
		}
		<section class="ulist ud-sessions" aria-labelledby="ud-sessions-h">
			<div class="ulist-head"><h2 id="ud-sessions-h">Active sessions</h2></div>
			if len(v.Sessions) == 0 {
				<p class="ud-none">No active sessions.</p>
			}
			for _, s := range v.Sessions {
				<div class="ud-row">
					<div class="ud-row-t">
						<span class="ud-row-main">Signed in <time datetime={ s.StartedAt } data-ts={ ui.StampRelative.Key }>{ s.Started }</time></span>
						<span class="ud-row-sub mono">
							last active <time datetime={ s.SeenAt }>{ s.Seen }</time>
							if s.Current {
								{ " · this session" }
							}
						</span>
					</div>
					if !s.Current && !v.D.ViewOnly {
						<form method="post" action={ templ.SafeURL(v.D.BasePath + "/users/sessions") } class="ud-end">
							<input type="hidden" name="csrf" value={ v.D.CSRFToken }/>
							<input type="hidden" name="subject" value={ v.D.User.Subject }/>
							<input type="hidden" name="session" value={ s.ID }/>
							if v.StepUp != nil {
								@ui.Button(ui.Btn{Label: "End session", Href: v.D.BasePath + detailPath(v.D.User), Dialog: v.StepUp.ID})
							} else {
								@ui.Button(ui.Btn{Label: "End session", Type: "submit"})
							}
						</form>
					}
				</div>
			}
		</section>
		<section class="ulist ud-activity" aria-labelledby="ud-activity-h">
			<div class="ulist-head">
				<h2 id="ud-activity-h">Recent activity</h2>
				@ui.Button(ui.Btn{Label: "Audit log", Kind: "link", Href: v.AuditHref})
			</div>
			if len(v.Activity) == 0 {
				<p class="ud-none">Nothing recorded yet.</p>
			}
			for _, a := range v.Activity {
				<div class="ud-act">
					<time class="ud-act-when" datetime={ a.At } data-ts={ ui.StampRelative.Key }>{ a.When }</time>
					<span class="ud-act-text"><span class="ud-act-what mono">{ a.Action }</span> <span class="ud-act-sum">{ a.Summary }</span></span>
					@ui.Badge(a.Tone, a.Status)
				</div>
			}
		</section>
	</div>
	for _, dlg := range v.Dialogs {
		@ui.Dialog(dlg)
	}
	if v.StepUp != nil {
		@ui.StepUp(*v.StepUp)
	}
}

// udSubmit is the submit of a fold's form: while changes need a step-up it opens that dialog.
templ udSubmit(v userDetailView, label string) {
	if v.StepUp != nil {
		@ui.Button(ui.Btn{Label: label, Href: v.D.BasePath + detailPath(v.D.User), Dialog: v.StepUp.ID})
	} else {
		@ui.Button(ui.Btn{Label: label, Type: "submit"})
	}
}

// otpPage shows a generated password once: the value in a read-only field with a copy button (the field
// selects the whole value on focus, copy.js), the username, when it expires, the warning that it cannot be
// shown again, Done (the user's page) and Back to users. The value is in the markup once: the field's value,
// which Copy reads (#1111).
templ otpPage(o otpView) {
	if o.D.Created {
		@ui.PageHeader("Account created for "+o.D.User, "Give them this temporary password. It’s shown only once and expires in 24 hours.")
	} else {
		@ui.PageHeader("Password reset for "+o.D.User, "Give them this temporary password. It’s shown only once and expires in 24 hours.")
	}
	@ui.CardOf(ui.CardData{Class: "otp-card", Aria: "Temporary password"}) {
		<div class="otp-value">
			<input id="otp-value" class="mono" type="text" value={ o.D.Password } readonly autocomplete="off" spellcheck="false" aria-label={ "Temporary password of " + o.D.User } data-visual-mask/>
			@ui.CopyButton(ui.CopyData{From: "#otp-value"})
		</div>
		@ui.KV([]ui.KVRow{{Key: "Username", Value: o.D.User, Mono: true}, {Key: "Expires", At: o.Expires, Mask: true}})
		@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Text: "Once you leave this page the password can’t be shown again. Reset it to get a new one."})
	}
	<div class="otp-foot">
		@ui.Button(ui.Btn{Label: "Back to users", Href: o.D.BasePath + "/users"})
		@ui.Button(ui.Btn{Label: "Done", Kind: "primary", Href: o.Detail})
	</div>
}
