package web

import "github.com/hellwand/tasmofleet/internal/web/ui"

// dashboardPage is the dashboard (design v2 screen "dashboard" and its "empty" state, WP P1).
// The body below the header reloads itself from the event stream (TestDashboardIsLive): hx-select
// takes the same #dash out of the whole page the GET answers with.
templ dashboardPage(d dashView) {
	<div id="dash" hx-get={ d.Base + "/" } hx-trigger="sse:state throttle:2s, sse:device throttle:2s, sse:job throttle:2s, sse:backup throttle:2s, sse:resync" hx-select="#dash" hx-swap="outerHTML">
		@ui.PageHeaderLive("Fleet overview", d.Sub) {
			// No button while the fleet is empty (#1109): the empty card has the one first action, and New update has
			// nothing to update.
			if !d.Empty {
				if d.AddHref != "" {
					@ui.Button(ui.Btn{Label: "Add devices", Href: d.AddHref})
				}
				if d.NewUpdate != "" {
					@ui.Button(ui.Btn{Label: "New update", Kind: "primary", Href: d.NewUpdate})
				}
			}
		}
		if d.Empty {
			if d.AddHref != "" {
				@ui.Empty("No devices yet", "Add your Tasmota devices to see their health here.") {
					@ui.Button(ui.Btn{Label: "Add devices", Kind: "primary", Href: d.AddHref})
				}
			} else {
				// an operator may not add devices: no button that would only be refused, the words say who does
				@ui.Empty("No devices yet", "An admin adds them.")
			}
		} else {
			<div class="stat-grid">
				for _, t := range d.Tiles {
					@ui.StatTile(t)
				}
			</div>
			@ui.HealthBar(d.OK, d.Off, d.Unk)
			@ui.CardStacks(dashStacks(d)) {
				@ui.CardStack(1) {
					@ui.ListCard(d.AttTitle, "All devices", d.Base+"/devices") {
						@ui.AttentionList(d.Att)
						if len(d.Att.Props) == 0 && len(d.Att.Groups) == 0 {
							<p class="dash-none">Nothing needs attention: every device answers and follows the policy.</p>
						}
					}
				}
				if d.TxnCard {
					@ui.CardStack(1) {
						@ui.ListCard("Activity", "History", d.Base+"/transactions") {
							if d.Plans.N > 0 {
								@ui.PlanLine(d.Plans)
							}
							for _, c := range d.Cards {
								@ui.TxnCard(c)
							}
							for _, r := range d.Rows {
								@ui.TxnRow(r)
							}
							if len(d.Cards) == 0 && len(d.Rows) == 0 && d.Plans.N == 0 {
								<p class="dash-none">No jobs yet. Updates you start show up here.</p>
							}
						}
					}
				}
			}
		}
	</div>
}
