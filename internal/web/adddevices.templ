package web

import (
	"strconv"

	"github.com/hellwand/tasmofleet/internal/web/ui"
)

// The Add page (#410): the header and four boxes, no tabs. The CSS is the "Add devices" block of
// app.css (.add-*, .scard-add).

// addPageView is the page: one line that says where to start (#1110), then Discovered and Network scan in the
// wide stack, Add by address and Import from TasmoAdmin in the narrow one. The rank classes give the phone
// order: Discovered, Add by address, Network scan, Import.
templ addPageView(p addPage) {
	@ui.PageHeader(addTitle, "Devices announce themselves here. Not showing up? Scan your network or add one by address.")
	if p.Manual.Error != "" && p.Manual.ErrField == "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: p.Manual.Error, Alert: true})
	}
	if p.Disc != nil {
		@discBanners(*p.Disc)
	}
	@ui.CardStacks(3) {
		if p.Disc != nil {
			@ui.CardStack(2) {
				@addBox("discovered", "r1", "Discovered", strconv.Itoa(p.Disc.NewCount), "Found by MQTT discovery and network scans, waiting for an admin.") {
					@discoveredBody(*p.Disc)
				}
				@addBox("scan", "r3", "Network scan", "", "Probes the ranges for Tasmota devices; new ones appear under Discovered.") {
					@scanBox(*p.Scan)
				}
			}
		}
		@ui.CardStack(1) {
			@addBox("manual", "r2", "Add by address", "", "When you know its IP address or hostname.") {
				@addManualForm(p.Manual)
			}
			if p.Import != nil {
				@addBox("import", "r4", "Import from TasmoAdmin", "", "Takes over the device list of a TasmoAdmin installation.") {
					if p.ImportFolded {
						// a one-time migration: once the fleet has devices it waits folded (A3-007)
						<details class="fold">
							<summary>Upload the files</summary>
							@importBodyPart(*p.Import)
						</details>
					} else {
						@importBodyPart(*p.Import)
					}
				}
			}
		}
	}
}

// addBox is one box of the Add page: a card of the column-stack grid with a title (and the count of
// what waits in it), a one-line note and its body.
templ addBox(id, rank, title, count, note string) {
	<section class={ "scard", "scard-add", rank } id={ "card-" + id }>
		<div class="sch">
			<div>
				<h2>
					{ title }
					if count != "" && count != "0" {
						{ " " }
						@ui.Badge(ui.ToneAccent, count)
					}
				</h2>
				<p class="cnote">{ note }</p>
			</div>
		</div>
		<div class="sbody sbody-plain">
			{ children... }
		</div>
	</section>
}

// ---- Add by address ----

templ addManualForm(f addManualView) {
	<form class="add-manual" method="post" action={ templ.SafeURL(f.Base + "/devices/new") }>
		<input type="hidden" name="csrf" value={ f.CSRF }/>
		if f.Prefill != nil {
			<input type="hidden" name="prefilled" value={ f.Prefill.Source }/>
			<div class="add-note t-accent" role="status">
				<span class="add-note-dot" aria-hidden="true"></span>
				<span class="add-note-text">
					Prefilled from { f.Prefill.Source }:
					if f.Prefill.Name != "" {
						<b>{ f.Prefill.Name }</b>
					}
					if f.Prefill.Host != "" {
						<span class="mono">{ f.Prefill.Host }</span>
					}
					· <span class="mono" data-visual-mask>{ f.Prefill.Address }</span>
				</span>
				@ui.Button(ui.Btn{Label: "Clear", Small: true, Href: f.Base + "/devices/new"})
			</div>
		}
		if f.Tested != nil {
			<div class="add-note t-ok" role="status">
				<span class="add-note-dot" aria-hidden="true"></span>
				<span class="add-note-text">
					<b>Connected.</b> { testedText(*f.Tested) } Nothing was added yet.
				</span>
			</div>
		}
		@ui.Field(ui.FieldData{Label: "IP address or hostname", Name: "address", Value: f.Device.Address, Mono: true, Wide: true,
			Autocomplete: "off", Error: f.FieldError("address")})
		<label class="ufield">
			<span class="ufield-label">Web user</span>
			<input value="admin" readonly class="mono" aria-describedby="add-user-help"/>
			<span class="ufield-help" id="add-user-help">Tasmota’s web user is always admin.</span>
		</label>
		@ui.Field(ui.FieldData{Label: "Web password", Name: "http_password", Type: "password", Autocomplete: "new-password",
			Placeholder: f.PasswordPlaceholder(), Help: f.PasswordHelp(), Error: f.FieldError("http_password"), Autofocus: f.NeedPassword})
		if f.HasDefault && f.Prefill == nil {
			<input type="hidden" name="use_default_password" value="1"/>
		}
		<details class="add-more" open?={ f.MoreOpen() }>
			<summary>More options</summary>
			<div class="add-more-grid">
				@ui.Field(ui.FieldData{Label: "Name", Name: "name", Value: f.Device.Name, Help: "Optional, read from the device when empty.", Error: f.FieldError("name")})
				@ui.Field(ui.FieldData{Label: "Port", Name: "port", Type: "number", Value: portText(f.Device.Port), Placeholder: "80", Help: "Empty means 80.", Error: f.FieldError("port")})
				@ui.Field(ui.FieldData{Label: "Tags", Name: "tags", Value: f.TagsText, Wide: true, Help: "Comma separated.", Error: f.FieldError("tags")})
				<label class="ufield ufield-wide">
					<span class="ufield-label">Notes</span>
					<textarea name="notes" rows="3" maxlength="4000"
						if f.FieldError("notes") != "" {
							aria-invalid="true"
							aria-describedby="err-notes"
						}
					>{ f.Device.Notes }</textarea>
					if f.FieldError("notes") != "" {
						<span class="ufield-err" id="err-notes">{ f.FieldError("notes") }</span>
					} else {
						<span class="ufield-help">Free text for you; not sent to the device.</span>
					}
				</label>
				<label class="ucheck ufield-wide" title="A device with this on is never offered firmware, for example one that must not be touched remotely.">
					<input type="checkbox" name="ota_excluded" value="1" checked?={ f.Device.OTAExcluded }/>
					<span>Exclude from OTA updates</span>
				</label>
			</div>
		</details>
		if f.Fallback {
			<label class="ucheck ufield-wide">
				<input type="checkbox" name="skip_probe" value="1"/>
				<span>Add without probing the device</span>
			</label>
		}
		if f.NoNetworks {
			<p class="add-off" id="add-off">Adding is off until a device network is configured (see the notice above): every address would be refused.</p>
		}
		<div class="add-acts">
			@ui.Button(ui.Btn{Label: "Add device", Kind: "primary", Type: "submit", Disabled: f.NoNetworks, Attrs: offDescribed(f.NoNetworks, "add-off")})
			@ui.Button(ui.Btn{Label: "Test connection", Type: "submit", Name: "test", Value: "1", Disabled: f.NoNetworks})
		</div>
	</form>
}

// ---- Discovered ----

templ discBanners(p discView) {
	if p.Error != "" {
		@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: p.Error, Alert: true})
	}
	if len(p.NeedPassword) > 0 {
		// "Add N selected" left these: each is added through its filled-in form (#1110). Beside a danger banner the
		// count of the added devices is said there already.
		@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Text: needPasswordLead(p), Action: addedListAction(p)}) {
			for i, n := range p.NeedPassword {
				<a href={ templ.SafeURL(n.Href) }>{ n.Name }</a>{ listEnd(i, len(p.NeedPassword)) }
			}
		}
	} else if p.Added > 0 {
		@ui.Banner(ui.BannerData{Tone: ui.ToneOK, Text: plural(p.Added, "device") + " added.", Action: &ui.Btn{Label: "Open the device list", Href: p.Base + "/devices"}})
	}
	if p.Unverified != nil {
		<form method="post" action={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(p.Unverified.ProposalID, 10) + "/accept") }>
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			<input type="hidden" name="version" value={ p.Unverified.Version }/>
			<input type="hidden" name="token" value={ p.Unverified.Token }/>
			@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Alert: true, Class: "add-confirm", Text: "Could not verify that ", Action: &ui.Btn{Label: "Update address anyway", Type: "submit"}}) {
				<code>{ p.Unverified.Target }</code>{ " is the same device as " + p.Unverified.Name + " (MAC). The stored web password will be sent there, possibly to a different host. You can also " }<a href={ templ.SafeURL(p.Base + "/devices/new") }>go back</a>{ "." }
			}
		</form>
	}
}

// discoveredBody is the Discovered box: the note about a switched-off discovery, then one table of the
// known devices that reported a new address (or a conflict) and the new devices (and, with Show ignored,
// the ignored ones) with selection, Ignore and Add, then the topics MQTT saw but could not identify.
// Show ignored is a GET form of its own (a POST form would put its CSRF token in the URL); the POST form
// follows it and, with display: contents, takes part in the same row of the bar, so the bulk buttons that
// select.js counts per form stay beside it.
templ discoveredBody(p discView) {
	if p.Off {
		<div class="add-note t-warn" role="status">
			<span class="add-note-dot" aria-hidden="true"></span>
			<span class="add-note-text"><b>MQTT discovery is switched off.</b> Only network scans find new devices.</span>
			if p.Settings != "" {
				@ui.Button(ui.Btn{Label: "Open settings", Small: true, Href: p.Settings})
			}
		</div>
	}
	<div class="add-bar">
		<h3 class="sys-subhead" id="disc-new">Waiting for a decision ({ strconv.Itoa(p.OpenCount()) })</h3>
		<form class="add-showign" method="get" action={ templ.SafeURL(p.Base + "/devices/new#card-discovered") } data-autosubmit>
			for _, f := range discFields(p) {
				<input type="hidden" name={ f[0] } value={ f[1] }/>
			}
			@ui.Check("ignored", "Show ignored ("+strconv.Itoa(p.Ignored)+")", "", p.ShowIgn, false)
			@ui.Button(ui.Btn{Label: "Apply", Small: true, Type: "submit", Attrs: templ.Attributes{"data-autosubmit-hide": true}})
		</form>
		<form class="add-newdev" method="post" action={ templ.SafeURL(p.Base + "/discovery/proposals/accept") }>
			<input type="hidden" name="csrf" value={ p.CSRF }/>
			// Add of this page opens the added device; the dashboard's Add, which posts no "from", stays there
			<input type="hidden" name="from" value="add"/>
			if p.HasDefault {
				<input type="hidden" name="use_default_password" value="1"/>
			}
			<input type="hidden" name="state" value={ p.State }/>
			<input type="hidden" name="sort" value={ p.Sort }/>
			<input type="hidden" name="dir" value={ p.Dir }/>
			if p.ShowIgn {
				<input type="hidden" name="ignored" value="1"/>
			}
			<span class="add-gap"></span>
			if p.NewCount > 0 {
				<div class="btn-row" data-bulkbar>
					@ui.Button(ui.Btn{Label: "Ignore selected", Type: "submit", FormAction: p.Base + "/discovery/proposals/dismiss"})
					@ui.Button(ui.Btn{Label: "Add ", Kind: "primary", Type: "submit"}) {
						<span data-bar-count></span>{ " selected" }
					}
				</div>
			}
			<div class="add-bar-body">
				// The rule is store.UpsertProposal's "same" (an ignored row stays hidden while its content is unchanged); keep the
				// words generic. Only while the ignored devices are listed: that is when the question comes up (A3-004).
				if p.Ignored > 0 && p.ShowIgn {
					<p class="add-ignhelp">Ignored devices stay hidden until they change or reappear after { strconv.Itoa(p.ProposalDays) } days.</p>
				}
				for _, h := range p.Help() {
					<p class="add-ignhelp">{ h }</p>
				}
		if len(p.Chips) > 0 && (len(p.Rows) > 0 || p.Filtered) {
			<div class="add-chips" role="group" aria-label="Filter by state">
				for _, c := range p.Chips {
					@ui.Chip(ui.ChipData{Label: c.Label, Count: strconv.Itoa(c.N), Href: c.Href, Current: c.Current})
				}
			</div>
		}
		if p.HasTable() {
			<div class="add-table add-disc-table">
				<table aria-label="New devices and known devices that reported a change">
					<colgroup>
						<col class="c-sel"/>
						<col class="c-name"/>
						<col class="c-ip"/>
						<col class="c-src"/>
						<col class="c-last"/>
						<col class="c-act"/>
					</colgroup>
					<thead>
						<tr>
							<th class="sel">
								if p.NewCount != 0 {
									<input type="checkbox" data-select-all aria-label="Select all"/>
								}
							</th>
							@sortTh(p, "name", "Device name")
							@sortTh(p, "ip", "IP")
							@sortTh(p, "source", "Source")
							@sortTh(p, "last", "Last seen")
							<th class="act"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, m := range p.Moves {
							@moveTableRow(p, m)
						}
						for _, m := range p.Conflicts {
							@moveTableRow(p, m)
						}
						for _, r := range p.Rows {
							<tr class={ templ.KV("is-ign", r.Ignored) }>
								<td class="sel">
									if !r.Ignored {
										<input type="checkbox" name="id" value={ strconv.FormatInt(r.ID, 10) + ":" + r.Version } aria-label={ "Select " + r.Label() }/>
									}
								</td>
								<td class="name" title={ nameTip(r) }>
									<span class="add-label">
										<span class="add-label-t">{ dash(r.Name) }</span>
										if r.Ignored {
											@ui.Badge(ui.ToneNeutral, "Ignored")
										}
										if r.Offline {
											@ui.Badge(ui.ToneWarn, "Offline")
											if r.OfflineText != "" {
												<span class="add-t2">since <time datetime={ r.OfflineSince.UTC().Format("2006-01-02T15:04:05Z") }>{ r.OfflineText }</time></span>
											}
										}
									</span>
									if r.Topic != "" {
										<span class="add-sub">{ r.Topic }</span>
									}
								</td>
								<td class="mono" title={ r.Address }>{ r.Address }</td>
								<td>
									@ui.Tag(r.Source)
								</td>
								<td class="add-t2"><time datetime={ r.Last.UTC().Format("2006-01-02T15:04:05Z") }>{ r.LastText }</time></td>
								<td class="act">
									if r.Ignored {
										@ui.Button(propBtn(p, r, "Show again", "undismiss", ui.Btn{Small: true}))
									} else {
										@ui.Button(propBtn(p, r, "Ignore", "dismiss", ui.Btn{Kind: "ghost", Class: "add-ign"}))
										// the cell is inline: the space keeps the two buttons apart
										{ " " }
										@ui.Button(propBtn(p, r, "Add", "accept", ui.Btn{Kind: "primary"}))
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="add-cards">
				for _, m := range p.Moves {
					@moveCard(p, m)
				}
				for _, m := range p.Conflicts {
					@moveCard(p, m)
				}
				for _, r := range p.Rows {
					<div class={ "add-card", templ.KV("is-ign", r.Ignored) }>
						<label class="add-card-sel">
							if !r.Ignored {
								<input type="checkbox" name="id" value={ strconv.FormatInt(r.ID, 10) + ":" + r.Version } aria-label={ "Select " + r.Label() }/>
							}
						</label>
						<div class="add-card-body">
							<span class="add-card-title">
								<span class="add-card-name">{ r.Label() }</span>
								if r.Ignored {
									@ui.Badge(ui.ToneNeutral, "Ignored")
								}
								if r.Offline {
									@ui.Badge(ui.ToneWarn, "Offline")
									if r.OfflineText != "" {
										<span class="add-t2">since <time datetime={ r.OfflineSince.UTC().Format("2006-01-02T15:04:05Z") }>{ r.OfflineText }</time></span>
									}
								}
							</span>
							<span class="add-card-meta"><span data-visual-mask>{ r.Address }</span>{ metaTail(cardHost(r)) }</span>
							<span class="add-card-src">{ r.Source } · last seen <time datetime={ r.Last.UTC().Format("2006-01-02T15:04:05Z") }>{ r.LastText }</time></span>
							if r.Ignored {
								@ui.Button(propBtn(p, r, "Show again", "undismiss", ui.Btn{Class: "add-card-btn"}))
							} else {
								<div class="add-card-acts">
									@ui.Button(propBtn(p, r, "Ignore", "dismiss", ui.Btn{}))
									@ui.Button(propBtn(p, r, "Add", "accept", ui.Btn{Kind: "primary"}))
								</div>
							}
						</div>
					</div>
				}
			</div>
		}
		if p.Filtered {
			<div class="uempty add-empty">
				<div class="uempty-icon" aria-hidden="true"><span></span></div>
				<h2>No { p.State } devices</h2>
				<p>No device in this list is { p.State } right now.</p>
			</div>
		} else if !p.HasTable() {
			<div class="uempty add-empty">
				<div class="uempty-icon" aria-hidden="true"><span></span></div>
				<h2>No new devices found</h2>
				if p.Off {
					// the banner above says that discovery is off and links its setting: this says what to do (A3-014)
					<p>Nothing new yet. Scan your network below.</p>
				} else {
					<p>
						Discovery is listening on MQTT. New Tasmota devices show up here a few seconds after they join the network.
						if !p.LastAnnounce.IsZero() {
							Last announcement <time { ui.StampAttrs(p.LastAnnounce, ui.StampRelative)... }>{ p.LastAnnounceText }</time>.
						}
					</p>
				}
			</div>
		}
			</div>
		</form>
	</div>
	if len(p.Unident) > 0 {
		@unidentSection(p.Unident)
	}
	@whyBox(p)
}

// whyBox is the lookup of #713: for one device that is on the broker but not offered as new, which
// of the places it is in (the device list, ignored, listed, not identified). It is a GET form, so an
// answer can be bookmarked and changes nothing.
templ whyBox(p discView) {
	<form class="add-why" method="get" action={ templ.SafeURL(p.Base + "/devices/new#why") }>
		<label for="why-q">Find a device by address</label>
		// the lookup takes an IP address, a MAC or a topic (discovery.Explain), not a hostname: the example says what works
		<input id="why-q" class="mono add-why-q" type="search" name="why" value={ p.WhyQuery } maxlength="128" placeholder="192.168.1.50 or aa:bb:cc:dd:ee:ff" autocomplete="off" data-visual-mask/>
		if p.ShowIgn {
			<input type="hidden" name="ignored" value="1"/>
		}
		@ui.Button(ui.Btn{Label: "Look up", Type: "submit"})
	</form>
	if p.Why != nil {
		@whyAnswer(p, *p.Why)
	}
}

// whyAnswer is the answer of the lookup: one line per place the device was found, each with its way on.
templ whyAnswer(p discView, a whyView) {
	<section class="add-moves" id="why" aria-label="Lookup result">
		<div class="add-moves-head">
			<h2>Lookup: <span class="mono" data-visual-mask>{ a.Query }</span></h2>
			if a.Limit != "" {
				<div class="add-moves-sub">{ a.Limit }</div>
			}
		</div>
		if a.Message != "" {
			<div class="add-move"><span class="add-move-why">{ a.Message }</span></div>
		}
		for _, l := range a.Lines {
			if l.RestoreID != 0 {
				<form class="add-move" method="post" action={ templ.SafeURL(p.Base + "/discovery/proposals/" + strconv.FormatInt(l.RestoreID, 10) + "/undismiss") }>
					<input type="hidden" name="csrf" value={ p.CSRF }/>
					<input type="hidden" name="version" value={ l.RestoreVersion }/>
					<input type="hidden" name="state" value={ p.State }/>
					<input type="hidden" name="sort" value={ p.Sort }/>
					<input type="hidden" name="dir" value={ p.Dir }/>
					if p.ShowIgn {
						<input type="hidden" name="ignored" value="1"/>
					}
					@whyLine(l)
				</form>
			} else {
				<div class="add-move">
					@whyLine(l)
				</div>
			}
		}
	</section>
}

// unidentSection lists the topics MQTT saw that are no proposal yet (spec 11.3a): offline
// devices without a discovery config, unanswered Status 5, addresses outside the networks.
templ unidentSection(rows []moveRow) {
	<section class="add-moves" aria-label="Seen on MQTT, not identified yet">
		<div class="add-moves-head">
			<h2>Seen on MQTT, not identified yet ({ strconv.Itoa(len(rows)) })</h2>
			<div class="add-moves-sub">These topics are on the broker, but TasmoFleet does not know their MAC yet, so they cannot be added. They appear under New devices once identified.</div>
		</div>
		for _, m := range rows {
			<div class="add-move">
				<span class="add-move-name">
					<span class="mono">{ m.Name }</span>
					<span class="add-move-seen"><time datetime={ m.Seen.UTC().Format("2006-01-02T15:04:05Z") }>{ m.SeenText }</time></span>
				</span>
				<span class="add-move-addr mono" data-visual-mask>{ dash(m.New) }</span>
				<span class="add-move-why">{ m.Why }</span>
			</div>
		}
	</section>
}

// moveTableRow is a known device that reported something, as a row of the Discovered table: the stored
// device's name with a badge (New address, Conflict), the new address with the stored one under it, Ignore
// and, where the move can be confirmed here, Apply. An ignored row has Show again as its only action. It has
// no selection box: Add selected and Ignore selected are for new devices. What holds for every row of its
// kind is said above the table; the row keeps only its own exception.
templ moveTableRow(p discView, m moveRow) {
	<tr class={ "add-row-move", templ.KV("is-ign", m.Ignored), templ.KV("has-note", m.Why != "") }>
		<td class="sel"></td>
		<td class="name">
			<span class="add-label">
				if m.Href != "" {
					<a class="add-label-t" href={ templ.SafeURL(m.Href) }>{ dash(m.Name) }</a>
				} else {
					<span class="add-label-t">{ dash(m.Name) }</span>
				}
				@moveBadges(m)
			</span>
		</td>
		<td class="mono">
			<b>{ m.New }</b>
			if m.Old != "" {
				<span class="add-sub" data-visual-mask>was { m.Old }</span>
			}
		</td>
		<td>
			@ui.Badge(ui.ToneNeutral, m.Source)
		</td>
		<td class="add-t2"><time datetime={ m.Seen.UTC().Format("2006-01-02T15:04:05Z") }>{ m.LastText }</time></td>
		<td class="act">
			@moveActs(p, m, ui.Btn{Kind: "ghost", Class: "add-ign"}, ui.Btn{Small: true}, ui.Btn{Kind: "primary"})
		</td>
	</tr>
	if m.Why != "" {
		// the row's own exception takes the whole width under the row, not the narrow name column
		<tr class={ "add-row-note", templ.KV("is-ign", m.Ignored) }>
			<td colspan="6" class="add-note-cell">{ m.Why }</td>
		</tr>
	}
}

// moveCard is the same row on a phone.
templ moveCard(p discView, m moveRow) {
	<div class={ "add-card", templ.KV("is-ign", m.Ignored) }>
		<span class="add-card-sel"></span>
		<div class="add-card-body">
			<span class="add-card-title">
				if m.Href != "" {
					<a class="add-card-name" href={ templ.SafeURL(m.Href) }>{ dash(m.Name) }</a>
				} else {
					<span class="add-card-name">{ dash(m.Name) }</span>
				}
				@moveBadges(m)
			</span>
			<span class="add-card-meta"><span data-visual-mask>{ m.New }</span>
				if m.Old != "" {
					<span data-visual-mask>{ " · was " + m.Old }</span>
				}
			</span>
			if m.Why != "" {
				<span class="add-card-why">{ m.Why }</span>
			}
			<span class="add-card-src">{ m.Source } · last seen <time datetime={ m.Seen.UTC().Format("2006-01-02T15:04:05Z") }>{ m.LastText }</time></span>
			if m.Ignored {
				@moveActs(p, m, ui.Btn{Class: "add-card-btn"}, ui.Btn{Class: "add-card-btn"}, ui.Btn{Kind: "primary"})
			} else {
				<div class="add-card-acts">
					@moveActs(p, m, ui.Btn{}, ui.Btn{}, ui.Btn{Kind: "primary"})
				</div>
			}
		</div>
	</div>
}

templ moveBadges(m moveRow) {
	if m.Ignored {
		@ui.Badge(ui.ToneNeutral, "Ignored")
	}
	if m.Conflict {
		@ui.Badge(ui.ToneDanger, "Conflict")
	} else {
		@ui.Badge(ui.ToneAccent, "New address")
	}
}

// moveActs are the buttons of a known device's row, in the POST form of the table: each carries the
// version of its own row, which the form has no field for (#745). The three Btn give each button its look
// (kind, size, the page's class) in the table and on the phone card.
templ moveActs(p discView, m moveRow, ignore, show, apply ui.Btn) {
	if m.Ignored {
		@ui.Button(rowBtn(p.Base, m.ID, m.Version, "Show again", "undismiss", show))
	} else {
		@ui.Button(rowBtn(p.Base, m.ID, m.Version, "Ignore", "dismiss", ignore))
		if m.CanApply {
			// the table cell is inline: the space keeps the two buttons apart
			{ " " }
			@ui.Button(rowBtn(p.Base, m.ID, m.Version, "Apply", "accept", apply))
		}
	}
}

// ---- Network scan ----

// scanPage is the results page of one scan: the heading, a way back to the Add page and the scan body.
templ scanPage(t scanTab) {
	<div class="add-head"><h1>Network scan</h1></div>
	@scanBody(t.Body)
	<p class="ufield-help"><a href={ templ.SafeURL(t.Body.Base + "/devices/new") }>Back to Add devices</a></p>
}

// scanBox is the Network scan box of the Add page: the ranges, Scan now (it opens the results page,
// where the scan runs live), the line about the last scan with a link to all its results, and the
// scheduled scan's state. A scan that is running shows its progress and a link to watch it.
templ scanBox(b scanBodyView) {
	<div id="scan" class="add-scan">
		<form class="add-scanbar" method="post" action={ templ.SafeURL(b.Base + "/discovery/scan") }>
			<input type="hidden" name="csrf" value={ b.CSRF }/>
			<input class="mono add-subnet" name="cidrs" value={ b.CIDRs } placeholder="192.168.1.0/24" aria-label="Subnet"/>
			@ui.Button(ui.Btn{Label: "Scan now", Kind: "primary", Type: "submit", Disabled: b.NoNetworks || b.Running, Attrs: offDescribed(b.NoNetworks, "scan-off")})
			<span class="add-scanstatus">
				<span data-visual-mask>
					{ b.StatusLead }
					if !b.StatusAt.IsZero() {
						<time { ui.StampAttrs(b.StatusAt, ui.StampRelative)... }>{ b.StatusAtText }</time>
					}
					{ b.StatusTail }
				</span>
			</span>
			if b.Prefilled != "" {
				<span class="ufield-help add-scanerr" id="scan-prefill-note">{ b.Prefilled }</span>
			}
			if b.NoNetworks {
				<span class="ufield-help add-scanerr" id="scan-off">Scanning is off until a device network is configured (see the notice above).</span>
			}
		</form>
		if b.Running {
			<div class="add-note t-accent" role="status">
				<span class="add-note-dot pulse" aria-hidden="true"></span>
				<span class="add-note-text">
					<b>Scanning { b.Ranges }.</b> { strconv.Itoa(b.Done) } of { strconv.Itoa(b.Total) } addresses.
					<a href={ templ.SafeURL(b.Base + "/discovery/scan/" + b.ID) }>Watch the scan</a>
				</span>
			</div>
		} else if b.HasScan && b.Summary != "" {
			<div class="add-note t-ok" role="status">
				<span class="add-note-dot" aria-hidden="true"></span>
				<span class="add-note-text">
					<b>Scan finished.</b> { b.BoxSummary }
					<a href={ templ.SafeURL(b.Base + "/discovery/scan/" + b.ID) }>All results</a>
				</span>
			</div>
		}
		if b.Scheduled != "" {
			<p class="ufield-help">
				Scheduled scan: { b.Scheduled }.
				if b.SettingsHref != "" {
					<a href={ templ.SafeURL(b.SettingsHref) }>Settings → Discovery</a>
				}
			</p>
		}
	</div>
}

// scanBody is the tab body. While a scan runs the event stream swaps only the progress and the results
// (#scan-live, event "scan"): the scan bar with its Stop button stays untouched, so a click on it is not
// lost to a re-render (#144). The last event ("scan-done") replaces the whole body with a version
// without stream attributes, so the browser stops listening.
templ scanBody(b scanBodyView) {
	<div
		id="scan"
		class="add-scan"
		if b.Running {
			hx-ext="sse"
			sse-connect={ scanStreamURL(b) }
			sse-swap="scan-done"
			hx-swap="outerHTML"
		}
	>
		<form class="add-scanbar" method="post" action={ templ.SafeURL(b.Base + "/discovery/scan") }>
			<input type="hidden" name="csrf" value={ b.CSRF }/>
			<input
				class="mono add-subnet"
				name="cidrs"
				value={ b.CIDRs }
				placeholder="192.168.1.0/24"
				aria-label="Subnet"
				if b.Error != "" {
					aria-invalid="true"
					aria-describedby="err-cidrs"
				}
			/>
			if b.Running {
				@ui.Button(ui.Btn{Label: "Stop scan", Type: "submit", FormAction: b.Base + "/discovery/scan/" + b.ID + "/cancel"})
			} else {
				@ui.Button(ui.Btn{Label: "Scan now", Kind: "primary", Type: "submit", Disabled: b.NoNetworks, Attrs: offDescribed(b.NoNetworks, "scan-off")})
			}
			<span class="add-scanstatus">
				<span data-visual-mask>
					{ b.StatusLead }
					if !b.StatusAt.IsZero() {
						<time { ui.StampAttrs(b.StatusAt, ui.StampRelative)... }>{ b.StatusAtText }</time>
					}
					{ b.StatusTail }
				</span>
			</span>
			if b.Error != "" {
				<span class="ufield-err add-scanerr" id="err-cidrs">{ b.Error }</span>
			}
			if b.Prefilled != "" {
				<span class="ufield-help add-scanerr" id="scan-prefill-note">{ b.Prefilled }</span>
			}
			if b.NoNetworks {
				<span class="ufield-help add-scanerr" id="scan-off">Scanning is off until a device network is configured (see the notice above).</span>
			}
		</form>
		<div
			id="scan-progress"
			if b.Running {
				sse-swap="scan-progress"
				hx-swap="innerHTML"
			}
		>
			@scanProgress(b)
		</div>
		<div
			id="scan-live"
			if b.Running {
				sse-swap="scan"
				hx-swap="innerHTML"
			}
		>
			@scanLive(b)
		</div>
	</div>
}

// scanProgress is the progress bar of a running scan, or the note of a finished one. The stream swaps
// it on every tick; it holds nothing to click.
templ scanProgress(b scanBodyView) {
	if b.Running {
		<div class="add-progress" role="status">
			<div class="add-progress-head">
				<span class="add-progress-t"><span class="add-note-dot pulse" aria-hidden="true"></span><b>Scanning { b.Ranges }</b></span>
				<span class="mono add-t2">{ strconv.Itoa(b.Done) } of { strconv.Itoa(b.Total) } addresses</span>
			</div>
			<progress max={ strconv.Itoa(max(b.Total, 1)) } value={ strconv.Itoa(b.Done) }>{ strconv.Itoa(b.Percent()) } %</progress>
			<div class="add-progress-found">Found { strconv.Itoa(b.Found) } Tasmota devices so far</div>
		</div>
	} else if b.HasScan {
		<div class="add-note t-ok" role="status">
			<span class="add-note-dot" aria-hidden="true"></span>
			<span class="add-note-text"><b>Scan finished.</b> { b.Summary }</span>
		</div>
	}
}

// sortTh is a sortable header of the New devices table: a plain link (no script), the current
// column marked and announced.
templ sortTh(p discView, key, label string) {
	{{ href, class, aria := sortHeader(p, key) }}
	<th aria-sort={ aria }><a class={ class } href={ templ.SafeURL(href) }>{ label }<span class="sortmark" aria-hidden="true"></span></a></th>
}

// scanLive is filter chips, bulk bar and the table. The stream swaps it only when a device was found,
// so ticks and clicks are not lost to a refresh that changes nothing.
templ scanLive(b scanBodyView) {
	if b.HasScan {
		<form method="post" action={ templ.SafeURL(b.Base + "/discovery/proposals/accept") }>
			<input type="hidden" name="csrf" value={ b.CSRF }/>
			if b.HasDefault {
				<input type="hidden" name="use_default_password" value="1"/>
			}
			<div class="add-chips">
				for _, c := range b.Chips {
					@ui.Chip(ui.ChipData{Label: c.Label, Count: strconv.Itoa(c.N), Href: c.Href, Current: c.Current})
				}
				<span class="add-gap"></span>
				if b.Selectable {
					<div class="btn-row" data-bulkbar>
						@ui.Button(ui.Btn{Label: "Add ", Kind: "primary", Type: "submit"}) {
							<span data-bar-count></span>{ " selected" }
						}
					</div>
				}
			</div>
			if len(b.Rows) == 0 {
				<div class="uempty add-empty">
					<div class="uempty-icon" aria-hidden="true"><span></span></div>
					if b.Running {
						<h2>Nothing found so far</h2>
						<p>The scan is still probing.</p>
					} else {
						<h2>Nothing found</h2>
						<p>No Tasmota device answered in these ranges.</p>
					}
				</div>
			} else {
				<div class="add-table add-scan-table">
					<table>
						<colgroup>
							if b.Selectable {
								<col class="c-sel"/>
							}
							<col class="c-name"/>
							<col class="c-ip"/>
							<col class="c-mac"/>
							<col class="c-fw"/>
							<col class="c-st"/>
							<col class="c-act"/>
						</colgroup>
						<thead>
							<tr>
								if b.Selectable {
									<th class="sel"><input type="checkbox" data-select-all aria-label="Select all"/></th>
								}
								<th>Name</th>
								<th>IP</th>
								<th>MAC</th>
								<th>Firmware</th>
								<th>Status</th>
								<th class="act"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody>
							for _, r := range b.Rows {
								<tr>
									if b.Selectable {
										<td class="sel">
											if r.Kind == "new" {
												<input type="checkbox" name="id" value={ strconv.FormatInt(r.ProposalID, 10) + ":" + r.Version } aria-label={ "Select " + r.Name }/>
											}
										</td>
									}
									<td class="name" title={ r.Name }><span class="add-label">{ r.Name }</span></td>
									<td class="mono" title={ r.Address } data-visual-mask>{ r.Address }</td>
									<td class="mono add-t2" title={ r.MAC } data-visual-mask>{ r.MAC }</td>
									<td
										class="mono"
										if r.FirmwareTip != "" {
											title={ r.FirmwareTip }
										}
									>{ dash(r.Firmware) }</td>
									<td>
										@ui.Badge(r.Tone, r.Label)
									</td>
									<td class="act">
										@scanRowActs(b, r)
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				<div class="add-cards">
					for _, r := range b.Rows {
						<div class="add-card add-scan-card">
							<div class="add-card-body">
								<span class="add-card-title">
									<span class="add-card-name">{ r.Name }</span>
									@ui.Badge(r.Tone, r.Label)
								</span>
								<span class="add-card-meta"><span data-visual-mask>{ r.Address }</span>{ metaTail(r.Firmware) }</span>
								<span class="add-card-src mono" data-visual-mask>{ r.MAC }</span>
								<div class="add-card-acts">
									@scanRowActs(b, r)
								</div>
							</div>
						</div>
					}
				</div>
			}
		</form>
	}
}

templ scanRowActs(b scanBodyView, r scanRow) {
	switch {
		case r.Kind == "new":
			@ui.Button(rowBtn(b.Base, r.ProposalID, r.Version, "Ignore", "dismiss", ui.Btn{Kind: "ghost", Class: "add-ign"}))
			// the cell is inline: the space keeps the buttons apart, as it did before they were components
			{ " " }
			@ui.Button(ui.Btn{Label: "Add", Small: true, Href: r.AddHref})
		case r.Kind == "ignored":
			@ui.Button(rowBtn(b.Base, r.ProposalID, r.Version, "Show again", "undismiss", ui.Btn{Kind: "link"}))
		case r.OpenHref != "":
			@ui.Button(ui.Btn{Label: "Open", Kind: "link", Href: r.OpenHref})
		case r.ReviewRef != "":
			@ui.Button(ui.Btn{Label: "Review", Kind: "link", Href: r.ReviewRef})
		case r.AddHref != "":
			@ui.Button(ui.Btn{Label: "Add", Small: true, Href: r.AddHref})
	}
}

// ---- Import from TasmoAdmin ----

// importBodyPart is the drop zone and the plan or result below it; the upload and Apply answer
// with a new one (hx-target="#import").
templ importBodyPart(b importBody) {
	<div id="import" class="add-import" aria-live="polite">
		if b.Report == nil {
			<form
				class="add-drop"
				hx-post={ b.Base + "/import/tasmoadmin" }
				hx-encoding="multipart/form-data"
				hx-trigger="change"
				data-busy-label="Import upload"
				hx-target="#import"
				hx-swap="outerHTML"
				data-dropzone
			>
				<span class="add-drop-text">
					if len(b.Uploaded) > 0 {
						for i, n := range b.Uploaded {
							if i > 0 {
								{ listSep(i, len(b.Uploaded)) }
							}
							<b>{ n }</b>
						}
						{ "uploaded from TasmoAdmin" }
						<span class="add-drop-sub">Drop other files here to replace them.</span>
					} else {
						<b>devices.csv</b>{ " from TasmoAdmin, with " }<b>MyConfig.json</b>{ " and " }<b>.device-password.key</b>{ " if you have them" }
						<span class="add-drop-sub">Drop the files here. They are read in memory, never stored; each may be up to 1 MiB.</span>
					}
				</span>
				<label class="btn add-drop-btn">
					Choose files
					<input type="file" name="files" multiple class="add-drop-input" accept=".csv,.json,.key,text/csv,application/json"/>
				</label>
			</form>
		}
		if b.Error != "" {
			@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: b.Error, Alert: true})
		}
		if b.Plan != nil {
			for _, w := range b.Plan.Warnings {
				@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Text: w})
			}
			if b.Plan.Hint != "" {
				@ui.Banner(ui.BannerData{Tone: ui.ToneAccent, Text: b.Plan.Hint})
			}
			<section class="add-plan" aria-labelledby="imp-plan-h">
				<div class="add-plan-head">
					<h2 id="imp-plan-h">Import plan</h2>
					<span class="add-plan-counts">
						@ui.BadgeMark(ui.ToneOK, markCreate, strconv.Itoa(b.Plan.Create)+" create")
						@ui.BadgeMark(ui.ToneAccent, markMerge, strconv.Itoa(b.Plan.Merge)+" merge")
						@ui.BadgeMark(ui.ToneWarn, markReject, strconv.Itoa(b.Plan.Reject)+" reject")
					</span>
				</div>
				for _, r := range b.Plan.Rows {
					@importRowView(r, "add-impw")
				}
				if b.Plan.CanApply() {
					<form class="add-plan-foot" hx-post={ b.Base + "/import/tasmoadmin/apply" } hx-target="#import" hx-swap="outerHTML">
						<input type="hidden" name="csrf" value={ b.CSRF }/>
						<input type="hidden" name="plan" value={ b.Plan.Token }/>
						<span class="add-t2">
							Rejected rows aren’t imported. Fix them in TasmoAdmin and upload again.
							if b.Plan.Probe {
								Devices are probed when you apply.
							}
						</span>
						@ui.Button(ui.Btn{Label: "Apply plan · " + plural(b.Plan.Create+b.Plan.Merge, "device"), Kind: "primary", Type: "submit"})
					</form>
				} else {
					<div class="add-plan-foot">
						<span class="add-t2"><b>Nothing to import.</b> No row of devices.csv can be added or merged. Fix the files and check them again.</span>
					</div>
				}
			</section>
		}
		if b.Report != nil {
			<div class="add-note t-ok" role="status">
				<span class="add-note-dot" aria-hidden="true"></span>
				<span class="add-note-text"><b>Import finished.</b> { b.Report.Summary }</span>
			</div>
			if b.Report.Hint != "" {
				@ui.Banner(ui.BannerData{Tone: ui.ToneAccent, Text: b.Report.Hint})
			}
			<section class="add-plan add-result" aria-label="Import result">
				for _, r := range b.Report.Rows {
					@importRowView(r, "add-impw add-impw-res")
				}
			</section>
			<div class="btn-row add-result-acts">
				@ui.Button(ui.Btn{Label: "Download report", Href: b.Base + "/import/tasmoadmin/report.csv", Attrs: templ.Attributes{"download": true}})
				@ui.Button(ui.Btn{Label: "Import more files", Href: b.Base + "/devices/new#card-import"})
				@ui.Button(ui.Btn{Label: "Open devices", Kind: "primary", Href: b.Base + "/devices"})
			</div>
		}
	</div>
}

templ importRowView(r importRow, badgeClass string) {
	<div class="add-improw">
		<span class={ badgeClass }>
			@ui.BadgeMark(r.Tone, r.Mark, r.Label)
		</span>
		<span class="add-improw-dev">
			<span class="add-improw-name">{ r.Name }</span>
			if r.Address != "" {
				<span class="add-improw-ip mono" data-visual-mask>{ r.Address }</span>
			}
		</span>
		<span class="add-improw-why">{ r.Why }</span>
	</div>
}

// whyLine is one finding of the lookup: the device, what it is, and the way on (Show again, the device
// page, the list it is in).
templ whyLine(l whyLineView) {
	<span class="add-move-name">
		if l.Href != "" {
			<a href={ templ.SafeURL(l.Href) }>{ l.Name }</a>
		} else if l.Topic {
			<span class="mono" data-visual-mask>{ l.Name }</span>
		} else {
			<span>{ l.Name }</span>
		}
	</span>
	<span class="add-move-why"><b>{ l.Lead }</b> { l.Detail }</span>
	<span class="btn-row add-move-acts">
		if l.RestoreID != 0 {
			@ui.Button(ui.Btn{Label: "Show again", Type: "submit"})
		}
		if l.Anchor != "" {
			@ui.Button(ui.Btn{Label: "Show in list", Href: l.Anchor})
		}
	</span>
}
