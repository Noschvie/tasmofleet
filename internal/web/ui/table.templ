package ui

import (
	"strconv"
)

// TableCol is one column of a data table.
type TableCol struct {
	Label string
	// SrOnly: the header names the column for screen readers only (the row-actions column).
	SrOnly bool
	// Class goes on the header cell, Col on the column's <col> (its default width in app.css).
	Class, Col string
}

// TableData is a data table (design v2, D19). Key names its entry in the column registry of
// internal/web (tableDefs): the server writes the user's saved widths, hidden columns, order
// and pins into the rendered table and adds the Columns chooser; tables.js adds resizing,
// fitting and the sticky offsets of the pinned columns. A table with no Key is no registry table
// (an ordered list such as the policy rules): it has no data-table, so none of those hooks find it.
// The rows are the component's children.
type TableData struct {
	Key   string
	Class string
	// Caption names the table for a screen reader (#1094); it is the first child of the table. It is
	// not drawn (sr-only) while the page has a visible heading for the table; CaptionVisible draws it
	// for a table that has none. "" writes no caption.
	Caption        string
	CaptionVisible bool
	// BodyAttrs are the data attributes a script needs on the <tbody> (the policy list's drag hooks):
	// the refusals and the order of a button's Attrs.
	BodyAttrs templ.Attributes
	// Select names the leading "select all" checkbox for screen readers; "" means the table
	// has no selection column. The checkbox is hidden until select.js runs (it needs the script).
	Select string
	Cols   []TableCol
	// SortBase is the URL the sort links extend (filters kept); Sort and Dir the current sort.
	SortBase, Sort, Dir string
}

// Table renders the frame of a data table: caption, colgroup, header and the rows given as children.
// Every header cell is scope="col".
templ Table(t TableData) {
	<table
		if t.Class != "" {
			class={ t.Class }
		}
		if t.Key != "" {
			data-table={ t.Key }
		}
		if t.SortBase != "" {
			data-sortbase={ t.SortBase }
			data-sort={ t.Sort }
			data-dir={ t.Dir }
		}
	>
		if t.Caption != "" && t.CaptionVisible {
			<caption>{ t.Caption }</caption>
		} else if t.Caption != "" {
			<caption class="sr-only">{ t.Caption }</caption>
		}
		<colgroup>
			if t.Select != "" {
				<col class="c-sel"/>
			}
			for _, c := range t.Cols {
				if c.Col != "" {
					<col class={ c.Col }/>
				} else {
					<col/>
				}
			}
		</colgroup>
		<thead>
			<tr>
				if t.Select != "" {
					<th scope="col" class="sel"><input type="checkbox" data-select-all hidden aria-label={ t.Select }/><span class="sr-only">Select</span></th>
				}
				for _, c := range t.Cols {
					<th
						scope="col"
						if c.Class != "" {
							class={ c.Class }
						}
					>
						if c.SrOnly {
							<span class="sr-only">{ c.Label }</span>
						} else {
							{ c.Label }
						}
					</th>
				}
			</tr>
		</thead>
		<tbody { pageAttrs(t.BodyAttrs)... }>
			{ children... }
		</tbody>
	</table>
}

// RowHeadData is the first cell of a row that names the row (#1094): the rule's name, the firmware.
type RowHeadData struct {
	// Class goes on the cell (the page's own hook, such as p1 of the phone card), Label is its data-label.
	Class, Label string
}

// RowHead is a <th scope="row">: a screen reader says it with each other cell of the row. The name
// (text, a link, a badge) is the component's children.
templ RowHead(r RowHeadData) {
	<th
		scope="row"
		if r.Class != "" {
			class={ r.Class }
		}
		if r.Label != "" {
			data-label={ r.Label }
		}
	>
		{ children... }
	</th>
}

// PagerSize is one page size of a Pager: the link to it, Current for the one the list is on.
type PagerSize struct {
	N       int
	Href    string
	Current bool
}

// PagerData is the model of a Pager: made of plain links (no script) that keep the filters of the
// page; the server builds it (newPager in internal/web). Prev and Next are empty when there is
// nothing to go to.
type PagerData struct {
	Page, Pages, Total, Size int
	Noun                     string
	Prev, Next               string
	Sizes                    []PagerSize
}

// Pager is the one paging control of every paged table: Previous, the position, Next and the
// page sizes.
templ Pager(p PagerData) {
	<nav class="pager" aria-label="Pages">
		if p.Prev != "" {
			@Button(Btn{Label: "Previous", Href: p.Prev, Rel: "prev", Small: true})
		} else {
			@Button(Btn{Label: "Previous", Small: true, Disabled: true})
		}
		<span class="pager-of">
			if p.Total > 0 {
				Page { strconv.Itoa(p.Page) } of { strconv.Itoa(p.Pages) }, { strconv.Itoa(p.Total) } { p.Noun }
			} else {
				No { p.Noun }
			}
		</span>
		if p.Next != "" {
			@Button(Btn{Label: "Next", Href: p.Next, Rel: "next", Small: true})
		} else {
			@Button(Btn{Label: "Next", Small: true, Disabled: true})
		}
		<span class="pager-size">
			Per page
			for _, s := range p.Sizes {
				@Button(Btn{Label: strconv.Itoa(s.N), Href: s.Href, Small: true, Current: s.Current})
			}
		</span>
	</nav>
}

// DeviceCardData is one device of the phone list (design v2: below 45rem the device list shows
// cards instead of the table). The live parts are slots, so the same partials that the event
// stream pushes render them; each slot has the event name it is swapped by.
type DeviceCardData struct {
	ID   string // the device id: the value of the selection box, shared with the table row (select.js)
	Name string
	Href string
	// Meta is the second line: address, chip and firmware, joined by " · ".
	Meta []string
	// Select: the card has a selection box (the bulk actions exist).
	Select bool
	// UpdateTo adds the "Update 16.2.0" badge (the stable release the device can take; "" = none), Deviations the policy
	// badge ("1 off policy"): the words are on screen, not in a title (#1073).
	UpdateTo   string
	Deviations int
	// Status (badges), Uptime and Wifi (last line), Power (the relay buttons) and Menu (row actions).
	Status, Uptime, Wifi, Power, Menu templ.Component
	// Stability is the "Boot loop" / "Weak Wi-Fi" badge (nil for a stable device), beside the status.
	Stability templ.Component
}

// DeviceListData is the phone card list: one card per device. "Select all N" is a button of the bulk bar (#1133),
// not a row above the cards.
type DeviceListData struct {
	Cards []DeviceCardData
}

// DeviceCards renders the phone list of the device list.
templ DeviceCards(l DeviceListData) {
	<div class="dcards">
		<ul class="dcard-list" role="list">
			for _, c := range l.Cards {
				@DeviceCard(c)
			}
		</ul>
	</div>
}

// DeviceCard is one device on a phone: selection box, name with the status dot, address, chip
// and firmware, the status badges, uptime and signal, and on the right the power control and
// the row actions. The name is the link (its accessible name is the device name); CSS
// stretches its hit area over the card's text block, as the prototype opens the device there.
templ DeviceCard(c DeviceCardData) {
	<li class="dcard" data-id={ c.ID }>
		if c.Select {
			<label class="dcard-sel"><input type="checkbox" name="id" value={ c.ID } aria-label={ "Select " + c.Name }/></label>
		}
		<div class="dcard-main">
			<span class="dcard-name"><span class="dcard-dot" aria-hidden="true"></span><a class="dcard-title" href={ templ.URL(c.Href) }>{ c.Name }</a></span>
			<span class="dcard-meta" data-visual-mask>
				for i, m := range c.Meta {
					if i > 0 {
						{ " · " }
					}
					<span class="dcard-meta-part">{ m }</span>
				}
			</span>
			<span class="dcard-badges">
				<span class="dcard-st" sse-swap={ "health-" + c.ID }>
					@slot(c.Status)
				</span>
				@slot(c.Stability)
				if c.UpdateTo != "" {
					<span class="bdg t-accent">{ "Update " + c.UpdateTo }</span>
				}
				if c.Deviations > 0 {
					<span class="bdg t-warn">{ OffPolicy(c.Deviations) }</span>
				}
			</span>
			// the prototype's last line: "Up 19d 1h · -60 dBm", "Last seen 3h ago" (the uptime part
			// says seen when the device is down) or "Never responded" (status Unknown); CSS picks.
			// The separator is an expression: templ drops the leading space of literal text.
			<span class="dcard-last" data-visual-mask><span class="dl-up">Up </span><span class="dl-last">Last </span><span class="dl-uptime" sse-swap={ "uptime-" + c.ID }>
				@slot(c.Uptime)
			</span><span class="dl-sep">{ " · " }</span><span class="dl-wifi" sse-swap={ "wifi-" + c.ID }>
				@slot(c.Wifi)
			</span><span class="dl-never">Never responded</span></span>
		</div>
		<div class="dcard-side">
			<div class="pcell" sse-swap={ "power-" + c.ID }>
				@slot(c.Power)
			</div>
			@slot(c.Menu)
		</div>
	</li>
}

// slot renders an optional component.
templ slot(c templ.Component) {
	if c != nil {
		@c
	}
}
