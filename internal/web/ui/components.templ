package ui

import "time"

// Components of the design system (design v2, WP F4). Every one is on /styleguide; the CSS
// lives in app.css under "Components (design v2, WP F4)", one block per component.

// PageHeader is the page title with its subtitle line and the page's buttons (children) on the
// right: h1 22 px, subtitle 13 px.
templ PageHeader(title, sub string) {
	@pageHeader(title, sub, false, false) {
		{ children... }
	}
}

// PageHeaderLive is PageHeader for a page that holds the event stream and whose subtitle says
// how fresh its values are: while html[data-live] reports the stream down, the subtitle adds
// "Values from HH:MM" (the time live.js already keeps for the status bar). Without a failure
// the stylesheet hides it, so the subtitle never claims a connection it cannot know.
templ PageHeaderLive(title, sub string) {
	@pageHeader(title, sub, false, true) {
		{ children... }
	}
}

// PageHeaderSample is PageHeader for a sample on /styleguide: the title is a div with the h1
// styling, because the page around the sample already has its own h1 (#515).
templ PageHeaderSample(title, sub string) {
	@pageHeader(title, sub, true, false) {
		{ children... }
	}
}

templ pageHeader(title, sub string, sample, live bool) {
	<div class="pghead">
		<div class="pghead-t">
			if sample {
				<div class="h1-sample">{ title }</div>
			} else {
				<h1>{ title }</h1>
			}
			if sub != "" {
				if live {
					<p class="pghead-sub">{ sub }<span class="pghead-stale">{ " · Values from " }<time data-live-since>page load</time></span></p>
				} else {
					<p class="pghead-sub">{ sub }</p>
				}
			}
		</div>
		<div class="pghead-acts">
			{ children... }
		</div>
	</div>
}

// Button is a button, or a link styled as one (Btn). A button with a DisabledReason is the blocked variant
// (blockedButton). The children follow the label (an icon, a count).
templ Button(b Btn) {
	if b.DisabledReason != "" {
		@blockedButton(b)
	} else if b.Href != "" {
		<a
			class={ b.classes() }
			href={ templ.SafeURL(b.Href) }
			if b.ID != "" {
				id={ b.ID }
			}
			if b.Dialog != "" {
				data-dialog={ b.Dialog }
			}
			if b.Target != "" {
				target={ b.Target }
			}
			if b.Rel != "" {
				rel={ b.Rel }
			}
			if b.Mask {
				data-visual-mask
			}
			if b.Aria != "" {
				aria-label={ b.Aria }
			}
			if b.Current {
				aria-current="page"
			}
			if b.Disabled {
				aria-disabled="true"
			}
			{ b.attrs()... }
		>{ b.Label }{ children... }</a>
	} else {
		<button
			type={ b.buttonType() }
			class={ b.classes() }
			if b.ID != "" {
				id={ b.ID }
			}
			if b.Form != "" {
				form={ b.Form }
			}
			if b.FormAction != "" {
				formaction={ templ.SafeURL(b.FormAction) }
			}
			if b.NoValidate {
				formnovalidate
			}
			if b.Name != "" {
				name={ b.Name }
				value={ b.Value }
			}
			if b.Dialog != "" {
				data-dialog={ b.Dialog }
			}
			if b.Aria != "" {
				aria-label={ b.Aria }
			}
			if b.Current {
				aria-current="page"
			}
			disabled?={ b.Disabled }
			{ b.attrs()... }
		>{ b.Label }{ children... }</button>
	}
}

// blockedButton is a button that cannot act now and says why (#1072). It is no <button disabled>, which no key reaches
// and no touch explains: it is aria-disabled, so Tab still lands on it, and aria-describedby names a line that
// shows the reason as text. It carries no action at all (type=button, no href, dialog, name or value), so
// pressing it does nothing with or without JavaScript. Its own reason line sits under it; with ReasonShared the
// line is one the page shows already (a banner, or one line for several buttons).
templ blockedButton(b Btn) {
	if b.ReasonShared {
		@blockedBtn(b)
	} else {
		<span class="btn-blocked">
			@blockedBtn(b)
			<span class="btn-why" id={ b.ReasonID }>{ b.DisabledReason }</span>
		</span>
	}
}

templ blockedBtn(b Btn) {
	<button
		type="button"
		class={ b.classes() }
		aria-disabled="true"
		if b.ReasonID != "" {
			aria-describedby={ b.ReasonID }
		}
		if b.Aria != "" {
			aria-label={ b.Aria }
		}
	>{ b.Label }</button>
}

// ButtonRow lays buttons out in a wrapping row with the prototype's 8 px gap.
templ ButtonRow() {
	<div class="btn-row">
		{ children... }
	</div>
}

// Badge is a small tinted label: state, result, counter.
templ Badge(tone Tone, label string) {
	<span class={ "bdg", tone.class() }>{ label }</span>
}

// BadgeOf is a Badge that needs more than a tone and a word (BadgeData): extra classes, a hint, a link, the large
// size or an id. The classes come in a fixed order (bdg, t-<tone>, bdg-lg, then Class), so the output is the same every time.
// The children follow the label inside the badge (the MQTT-down reason sits in its badge, #1097).
templ BadgeOf(b BadgeData) {
	if b.Href != "" {
		<a
			if b.ID != "" {
				id={ b.ID }
			}
			class={ b.classes() }
			href={ templ.URL(b.Href) }
			if b.Title != "" {
				title={ b.Title }
			}
			{ b.attrs()... }
		>{ b.Label }{ children... }</a>
	} else {
		<span
			if b.ID != "" {
				id={ b.ID }
			}
			class={ b.classes() }
			if b.Title != "" {
				title={ b.Title }
			}
			{ b.attrs()... }
		>{ b.Label }{ children... }</span>
	}
}

// Chip is a pill that filters or picks (ChipData): a label around an input, a link or a button, drawn alike. The
// attributes of a label chip go on its input, those of a link or button on the element.
templ Chip(c ChipData) {
	switch {
		case c.Name != "":
			<label
				class="chip"
				if c.Title != "" {
					title={ c.Title }
				}
			>
				<input
					type={ c.inputType() }
					name={ c.Name }
					value={ c.Value }
					if c.Form != "" {
						form={ c.Form }
					}
					checked?={ c.Checked }
					{ c.attrs()... }
				/>
				@chipBody(c)
			</label>
		case c.Href != "":
			<a
				class="chip"
				href={ templ.URL(c.Href) }
				if c.Current {
					aria-current="page"
				}
				if c.Title != "" {
					title={ c.Title }
				}
				{ c.attrs()... }
			>
				@chipBody(c)
			</a>
		default:
			<button
				type="button"
				class="chip"
				if c.Current {
					aria-current="true"
				}
				if c.Title != "" {
					title={ c.Title }
				}
				{ c.attrs()... }
			>
				@chipBody(c)
			</button>
	}
}

// chipBody is the parts of a chip. templ puts a space between elements it finds on separate lines; the chip is a flex
// box, which draws no whitespace between its items.
templ chipBody(c ChipData) {
	<span class="chip-l">{ c.Label }if c.Long != "" {
		<span class="sr-only">{ " " + c.Long }</span>
	}</span>
	if c.Sub != "" {
		<span class="chip-sub">{ c.Sub }</span>
	}
	if c.Count != "" {
		<span class="chip-n">{ c.Count }</span>
	}
	if c.Remove {
		<span class="chip-x" aria-hidden="true">×</span>
	}
}

// Tag is a read-only outlined label for a kind or a source (Proxy, System, MQTT discovery). It is never a state: a
// state is a badge.
templ Tag(label string) {
	<span class="tag">{ label }</span>
}

// TagOf is a Tag that needs more than its words (TagData): a hint, a link, the mono font or an attribute a script
// finds it by.
templ TagOf(t TagData) {
	if t.Href != "" {
		<a
			class={ t.classes() }
			href={ templ.URL(t.Href) }
			if t.Title != "" {
				title={ t.Title }
			}
			{ t.attrs()... }
		>{ t.Label }</a>
	} else {
		<span
			class={ t.classes() }
			if t.Title != "" {
				title={ t.Title }
			}
			{ t.attrs()... }
		>{ t.Label }</span>
	}
}

// CopyButton is the small button that copies a value (CopyData). It is hidden until static/copy.js shows it.
templ CopyButton(c CopyData) {
	<button
		type="button"
		class="btn btn-sm"
		if c.From != "" {
			data-copy-from={ c.From }
		} else {
			data-copy-text={ c.Text }
		}
		if c.Aria != "" {
			aria-label={ c.Aria }
		}
		hidden
	>{ c.label() }</button>
}

// BadgeMark is a Badge with a glyph before its word (Create +, Merge ⇄, Reject –): a second cue besides the colour. The
// glyph is decoration (aria-hidden), the word is what a screen reader reads; an empty mark draws none.
templ BadgeMark(tone Tone, mark, label string) {
	<span class={ "bdg", tone.class() }>
		@badgeText(mark, label)
	</span>
}

templ badgeText(mark, label string) {
	if mark != "" {
		<span class="bdg-mark" aria-hidden="true">{ mark }</span>
	}
	{ label }
}

// StatusDot is a coloured dot with its word (Online, Offline, Unknown): the colour is never the
// only signal.
templ StatusDot(tone Tone, label string) {
	<span class={ "sdot", tone.class() }><span class="sdot-dot" aria-hidden="true"></span>{ label }</span>
}

// StatusBadge is the connection status of a device: dot and word on the tone's tint (StatusBadgeData). It is a Badge
// with a dot, so the list, the header and the attention list draw one status one way.
templ StatusBadge(s StatusBadgeData) {
	<span
		class={ "bdg", "dv-st", s.Tone.class() }
		data-state={ s.State }
		if s.Title != "" {
			title={ s.Title }
		}
	><span class="dv-dot" aria-hidden="true"></span>{ s.Label }</span>
}

// InfoTile is a tile that describes one thing: label, value, hint (InfoTileData). The children follow the hint.
templ InfoTile(t InfoTileData) {
	<div class="itile" data-tile={ t.Key }>
		<div class="itile-l">
			{ t.Label }
			if t.Note != nil {
				@t.Note
			}
		</div>
		<div class={ t.valueClass() } data-visual-mask?={ t.Mask }>{ t.Value }</div>
		if t.Bar > 0 {
			<svg class={ "itile-bar", t.BarTone.classOrNone() } viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" data-visual-mask>
				<rect class="itile-bar-track" x="0" y="0" width="100" height="6"></rect>
				<rect class="itile-bar-fill" x="0" y="0" width={ itoa(min(t.Bar, 100)) } height="6"></rect>
			</svg>
		}
		<div class="itile-s">
			if !t.HintAt.IsZero() {
				{ t.HintPrefix }<time data-visual-mask { StampAttrs(t.HintAt, StampRelative)... }>{ t.HintAtText }</time>
			} else {
				{ t.Hint }
			}
		</div>
		{ children... }
	</div>
}

// Avatar is the round initials badge; the colour follows the username.
templ Avatar(name, username string) {
	<span class={ "uavatar", AvatarTone(username).class() } aria-hidden="true">{ Initials(name) }</span>
}

// Card is a section: surface, hairline border, 10 px radius, an h2 and an optional line under it.
templ Card(title, sub string) {
	@CardOf(CardData{Title: title, Sub: sub}) {
		{ children... }
	}
}

// CardOf is Card for a page that needs more (CardData): the phone stack rank, a class of its own, an id, another
// element, the heading a label names, attributes of a live swap. Without those it is Card, byte for byte.
templ CardOf(c CardData) {
	switch c.tag() {
		case "article":
			<article class={ c.classes() } if c.ID != "" { id={ c.ID } } if c.LabelledBy != "" { aria-labelledby={ c.LabelledBy } } if c.Aria != "" { aria-label={ c.Aria } } { c.attrs()... }>
				@cardBody(c) {
					{ children... }
				}
			</article>
		case "aside":
			<aside class={ c.classes() } if c.ID != "" { id={ c.ID } } if c.LabelledBy != "" { aria-labelledby={ c.LabelledBy } } if c.Aria != "" { aria-label={ c.Aria } } { c.attrs()... }>
				@cardBody(c) {
					{ children... }
				}
			</aside>
		case "form":
			<form class={ c.classes() } if c.ID != "" { id={ c.ID } } if c.LabelledBy != "" { aria-labelledby={ c.LabelledBy } } if c.Aria != "" { aria-label={ c.Aria } } { c.attrs()... }>
				@cardBody(c) {
					{ children... }
				}
			</form>
		case "div":
			<div class={ c.classes() } if c.ID != "" { id={ c.ID } } if c.LabelledBy != "" { aria-labelledby={ c.LabelledBy } } if c.Aria != "" { aria-label={ c.Aria } } { c.attrs()... }>
				@cardBody(c) {
					{ children... }
				}
			</div>
		default:
			<section class={ c.classes() } if c.ID != "" { id={ c.ID } } if c.LabelledBy != "" { aria-labelledby={ c.LabelledBy } } if c.Aria != "" { aria-label={ c.Aria } } { c.attrs()... }>
				@cardBody(c) {
					{ children... }
				}
			</section>
	}
}

templ cardBody(c CardData) {
	if c.Title != "" {
		if c.LabelledBy != "" {
			<h2 id={ c.LabelledBy }>{ c.Title }</h2>
		} else {
			<h2>{ c.Title }</h2>
		}
	}
	if c.Sub != "" {
		<p class="ucard-sub">{ c.Sub }</p>
	}
	{ children... }
}

// ListCard is a card whose body is a list of rows: a header row with the title and an optional
// link on the right, then the rows (children) separated by hairlines.
templ ListCard(title, linkLabel, linkHref string) {
	<section class="ulist">
		<div class="ulist-head">
			<h2>{ title }</h2>
			if linkLabel != "" {
				<a class="btn btn-link" href={ templ.SafeURL(linkHref) }>{ linkLabel }</a>
			}
		</div>
		{ children... }
	</section>
}

// KV is a list of label/value rows inside a card.
templ KV(rows []KVRow) {
	<dl class="ukv">
		for _, r := range rows {
			<div class={ "ukv-row", templ.KV("ukv-wide", r.Wide) }>
				<dt>{ r.Key }</dt>
				<dd class={ templ.KV("mono", r.Mono), templ.KV("ukv-name", r.IsName) } data-visual-mask?={ r.Mask }>
					@kvValue(r)
					if r.Action != nil {
						{ " " }
						@Button(*r.Action)
					}
				</dd>
			</div>
		}
	</dl>
}

// StampedText is a sentence with one instant: the lead, the instant as a <time> element that time.js repaints in the
// browser's locale and zone (its fallback text is for a page without JavaScript), then the tail. Every carrier of
// such a sentence (a dialog body, a banner text, a row, a release card) renders it through this one component.
templ StampedText(s Stamped) {
	if s.At.IsZero() {
		{ s.Lead + s.Tail }
	} else {
		{ s.Lead }<time { StampAttrs(s.At, s.stamp())... }>{ s.fallback() }</time>{ s.Tail }
	}
}

// kvValue is the value of a row: a time, a soft-wrapped name or plain text.
templ kvValue(r KVRow) {
	if !r.At.IsZero() {
		@StampedText(Stamped{Lead: r.Lead, At: r.At, Stamp: r.stampOf(), Text: r.Value, Tail: r.Tail})
	} else if r.Soft {
		@Soft(r.Value)
	} else {
		{ r.Value }
	}
}

// Tabs is a row of underline tabs; on a phone the row scrolls sideways.
templ Tabs(label string, tabs []Tab) {
	<nav class="utabs" aria-label={ label }>
		for _, t := range tabs {
			if t.Reason != "" && !t.Current {
				<span class="utab" aria-disabled="true" title={ t.Reason }>{ t.Label }</span>
			} else {
				if t.Badge > 0 {
					<a class="utab" href={ templ.SafeURL(t.Href) } if t.Current { aria-current="page" }>{ t.Label } <span class="bdg t-accent">{ itoa(t.Badge) }</span></a>
				} else {
					<a class="utab" href={ templ.SafeURL(t.Href) } if t.Current { aria-current="page" }>{ t.Label }</a>
				}
			}
		}
	</nav>
}

// RowMenu is the "⋯" menu of a row: a <details> (opens without JavaScript; menu.js adds one
// open at a time, Escape and click outside). Up opens it above its button (last rows).
templ RowMenu(label string, items []MenuItem, up bool) {
	@rowMenu(label, items, up, false)
}

// RowMenuStatic is the menu drawn open in the flow, for the style guide.
templ RowMenuStatic(label string, items []MenuItem, up bool) {
	@rowMenu(label, items, up, true)
}

// MenuButton is the "⋯" button that opens a row menu: the <summary> of a <details class="rowmenu">. The title, when
// set, is the hover hint (a list row names the device it acts on). RowMenu draws it itself; a menu whose items are
// not a plain list of links (the device list's, whose items post) writes its own panel and takes only this.
templ MenuButton(label, title string) {
	<summary class="btn btn-ghost btn-icon icon" aria-label={ label } if title != "" { title={ title } }>⋯</summary>
}

templ rowMenu(label string, items []MenuItem, up, static bool) {
	<details class={ "rowmenu", "umenu", templ.KV("up", up) } open?={ static } data-static?={ static }>
		@MenuButton(label, "")
		<div class="rowmenu-body menu-panel">
			for _, it := range items {
				if it.Sep {
					<hr/>
				}
				if it.Disabled {
					<button type="button" class="menu-item" aria-disabled="true">
						<span>{ it.Label }</span>
						if it.Why != "" {
							<span class="menu-why">{ it.Why }</span>
						}
					</button>
				} else {
					<a
						class={ "menu-item", templ.KV("danger", it.Danger) }
						href={ templ.SafeURL(it.Href) }
						if it.Dialog != "" {
							data-dialog={ it.Dialog }
						}
					><span>{ it.Label }</span></a>
				}
			}
		</div>
	</details>
}

// Banner is an inline banner above the page content: it stays until its cause is gone. The children follow Text
// inside the same text block (a list, a link, a time); the one action, if any, is the banner's button.
templ Banner(b BannerData) {
	<div
		class={ b.classes() }
		if b.ID != "" {
			id={ b.ID }
		}
		if b.Alert {
			role="alert"
		} else {
			role="status"
		}
		if b.Flash {
			data-flash
		}
		{ b.attrs()... }
	>
		<span class={ "banner-dot", templ.KV("pulse", b.Pulse) } aria-hidden="true"></span>
		<div class="banner-text">
			if !b.TitleAt.IsZero() {
				<b>{ b.Title }<time data-visual-mask { StampAttrs(b.TitleAt, StampRelative)... }>{ b.TitleAtText }</time>{ b.TitleAfter }</b>
			} else if b.Title != "" {
				<b>{ b.Title }</b>
			}
			if !b.TextStamp.IsZero() {
				@StampedText(b.TextStamp)
			} else {
				{ b.Text }
			}
			{ children... }
		</div>
		if b.Action != nil {
			@Button(b.action()) {
				if b.Action.Href != "" && b.Action.Target == "_blank" {
					{ " " }<span class="sr-only">(opens in a new tab)</span>
				}
			}
		}
	</div>
}

// BrokerACLNotice is the broker ACL notice (#840, #1078): without an access control list on the broker, every MQTT
// client can read what TasmoFleet sends through it. It is one short warn banner, the same everywhere: the lead, one
// sentence and one action, the guide in a new tab. It has no way to be closed (it is a property of the broker that
// TasmoFleet cannot see); an admin hides it for one broker on System, MQTT. Which pages show it is decided in web
// (brokerACLOpen and each place's own path condition), never here.
templ BrokerACLNotice() {
	@Banner(BannerData{Tone: ToneWarn, Title: BrokerACLLead, Text: BrokerACLText,
		Action: &Btn{Label: BrokerACLAction, Href: BrokerACLDocURL, Target: "_blank", Rel: "noopener noreferrer"}})
}

// ErrorSummary is the one banner a form shows when the server refused two or more of its inputs: "Fix 2 fields.
// Nothing was saved yet." The count is the only thing a caller passes, so the wording cannot drift; below 2 it draws
// nothing, because one refused input carries its own message (and the focus), and the banner would say it twice
// (design-system.md, Form errors sit at the input).
templ ErrorSummary(n int) {
	if n >= 2 {
		@Banner(BannerData{Tone: ToneDanger, Title: "Fix " + itoa(n) + " fields.", Text: "Nothing was saved yet.", Class: "err-summary", Alert: true})
	}
}

// ToastStatic is a toast drawn in the flow (the style guide); toast.js makes the live ones.
templ ToastStatic(t ToastData) {
	<div class={ "toast", t.Tone.class(), "has-x" }>
		<span class="toast-dot"></span>
		<span class="toast-text">{ t.Text }</span>
		if t.Action != "" {
			<button type="button" class="toast-act">{ t.Action }</button>
		}
		<button type="button" class="toast-x" aria-label="Dismiss">×</button>
	</div>
}

// LivePill is the live indicator in one fixed state, for the style guide.
templ LivePill(state, label string) {
	<span class={ "live-pill", "lp-" + state }><span class="live-pill-dot" aria-hidden="true"></span>{ label }</span>
}

// Field is a label-above input. An error from the server marks the input invalid, points to
// the message and replaces the help line.
templ Field(f FieldData) {
	<label class={ "ufield", templ.KV("ufield-wide", f.Wide) }>
		<span class="ufield-label">{ f.Label }</span>
		<input
			name={ f.Name }
			if f.Type != "" {
				type={ f.Type }
			}
			value={ f.Value }
			class={ templ.KV("mono", f.Mono) }
			if f.Placeholder != "" {
				placeholder={ f.Placeholder }
			}
			if f.Autocomplete != "" {
				autocomplete={ f.Autocomplete }
			}
			if f.NoAutocapitalize {
				autocapitalize="off"
			}
			if f.NoSpellcheck {
				spellcheck="false"
			}
			if f.Error != "" {
				aria-invalid="true"
				aria-describedby={ "err-" + f.Name }
			}
			autofocus?={ f.Autofocus }
		/>
		if f.Error != "" {
			<span class="ufield-err" id={ "err-" + f.Name }>{ f.Error }</span>
		} else if f.Help != "" {
			<span class="ufield-help">{ f.Help }</span>
		}
	</label>
}

// SelectField is a label-above native select.
templ SelectField(label, name string, opts []Option) {
	<label class="ufield">
		<span class="ufield-label">{ label }</span>
		<select name={ name }>
			for _, o := range opts {
				<option value={ o.Value } selected?={ o.Checked }>{ o.Label }</option>
			}
		</select>
	</label>
}

// Check is a checkbox with its label (and an optional second line).
templ Check(name, label, text string, checked, disabled bool) {
	<label class="ucheck">
		<input type="checkbox" name={ name } checked?={ checked } disabled?={ disabled }/>
		<span>
			{ label }
			if text != "" {
				<span class="ucheck-text">{ text }</span>
			}
		</span>
	</label>
}

// RadioCards are radio buttons drawn as cards with a title and a line (auth method, backup keep
// or drop): plain label > input, no JavaScript.
templ RadioCards(legend, name string, opts []Option) {
	<fieldset class="rcards">
		<legend>{ legend }</legend>
		for _, o := range opts {
			<label class="rcard">
				<input type="radio" name={ name } value={ o.Value } checked?={ o.Checked } disabled?={ o.Disabled }/>
				<span class="rcard-body"><b>{ o.Label }</b>
					if !o.TextStamp.IsZero() {
						<span>@StampedText(o.TextStamp)</span>
					} else if o.Text != "" {
						<span>{ o.Text }</span>
					}
				</span>
			</label>
		}
	</fieldset>
}

// Segmented is a small set of exclusive choices in one frame (Advisory / Required, Operator /
// Admin): radio inputs, so it works without JavaScript.
templ Segmented(label, name string, opts []Option) {
	<div class="useg" role="radiogroup" aria-label={ label }>
		for _, o := range opts {
			<label>
				<input type="radio" name={ name } value={ o.Value } checked?={ o.Checked }/>
				<span>{ o.Label }</span>
			</label>
		}
	</div>
}

// Toggle is a setting switch (a checkbox with role="switch", 38 x 22); see ToggleData. It posts Value ("true" unless
// set) when on, nothing when off. With a Label it is the setting's card; without one, only the switch in its label,
// which a <label for> the ID names.
templ Toggle(t ToggleData) {
	if t.Label != "" {
		<label class="utoggle">
			@toggleInput(t)
			<span class="sw" aria-hidden="true"></span>
			<span class="utoggle-text">
				<b>{ t.Label }</b>
				if t.Text != "" {
					<span>{ t.Text }</span>
				}
			</span>
		</label>
	} else {
		<label class="uswitch">
			@toggleInput(t)
			<span class="sw" aria-hidden="true"></span>
		</label>
	}
}

templ toggleInput(t ToggleData) {
	<input
		type="checkbox"
		role="switch"
		name={ t.Name }
		value={ t.value() }
		if t.ID != "" {
			id={ t.ID }
		}
		checked?={ t.On }
		disabled?={ t.Disabled }
		{ t.attrs()... }
	/>
}

// PowerSwitch is the relay switch of a device (34 x 20 inside a 48 x 44 target), in a list row, on a card and in the
// relay box; see PowerSwitchData. Disabled while the device is offline.
templ PowerSwitch(p PowerSwitchData) {
	<button
		type={ p.buttonType() }
		class={ p.classes() }
		role="switch"
		aria-checked={ ariaBool(p.On) }
		if p.Label != "" {
			aria-label={ p.Label }
		}
		if p.LabelledBy != "" {
			aria-labelledby={ p.LabelledBy }
		}
		disabled?={ p.Disabled }
		{ p.attrs()... }
	><span class="sw" aria-hidden="true"></span></button>
}

// StatTile is a dashboard tile: dot and label, the value, a hint; the whole tile links to the
// filtered list.
templ StatTile(s StatTileData) {
	<a class="stat-tile" href={ templ.SafeURL(s.Href) }>
		<span class="stat-label"><span class={ "sdot-dot", s.Tone.class() } aria-hidden="true"></span>{ s.Label }</span>
		<span class="stat-value">{ s.Value }</span>
		if !s.HintAt.IsZero() {
			<span class="stat-hint">{ s.Hint }<time { StampAttrs(s.HintAt, StampRelative)... }>{ s.HintAtText }</time>{ s.HintAfter }</span>
		} else if s.Hint != "" {
			<span class="stat-hint">{ s.Hint }</span>
		}
	</a>
}

// HealthBar is the fleet health bar: online, offline and unknown as three segments whose widths
// come from the server (SVG attributes, no inline style).
templ HealthBar(ok, off, unk int) {
	<svg class="health-bar" viewBox="0 0 1000 8" preserveAspectRatio="none" role="img" aria-label={ itoa(ok) + " online, " + itoa(off) + " offline, " + itoa(unk) + " unknown" }>
		@barSegs(healthSegments(ok, off, unk))
	</svg>
}

// barSegs draws the segments of the health and compliance bars and, over the boundary between two of them, the
// divider (barGaps).
templ barSegs(segs []barSeg) {
	for _, s := range segs {
		<rect class={ "bar-seg", s.Tone.class() } x={ itoa(s.X) } y="0" width={ itoa(s.W) } height="8"></rect>
	}
	for _, x := range barGaps(segs) {
		<line class="bar-gap" x1={ itoa(x) } x2={ itoa(x) } y1="0" y2="8"></line>
	}
}

// ComplianceBar is a rule's compliance: devices that match, deviate and cannot be judged, drawn
// like the fleet health bar (same segments and CSS); only the text for assistive technology differs.
templ ComplianceBar(match, deviate, unknown int) {
	<svg class="health-bar" viewBox="0 0 1000 8" preserveAspectRatio="none" role="img" aria-label={ itoa(match) + " match, " + itoa(deviate) + " deviate, " + itoa(unknown) + " not judged" }>
		@barSegs(complianceSegments(match, deviate, unknown))
	</svg>
}

// AttentionList is the "Needs attention" list: the note on what it holds, the proposals with two inline actions, then
// one group per reason with its devices, worst first. A group is capped by the caller; its More says how many it leaves
// out and where to see them.
templ AttentionList(a AttentionData) {
	if a.Note != "" {
		<p class="att-note">{ a.Note }</p>
	}
	for _, p := range a.Props {
		<div class="att-row att-prop">
			<span class="sdot-dot t-accent" aria-hidden="true"></span>
			<span class="att-text"><span class="att-name">{ p.Name }</span><span class="att-why">{ p.Text }</span></span>
			<span class="att-acts">
				<form method="post" action={ templ.SafeURL(p.SecondaryAction) }>
					@attHidden(a.CSRF, p.Version)
					<button type="submit" class="btn btn-sm" aria-label={ p.Secondary + " " + p.Name }>{ p.Secondary }</button>
				</form>
				<form method="post" action={ templ.SafeURL(p.PrimaryAction) }>
					@attHidden(a.CSRF, p.Version)
					<button type="submit" class="btn btn-sm btn-primary" aria-label={ p.Primary + " " + p.Name }>{ p.Primary }</button>
				</form>
			</span>
		</div>
	}
	@attMore(a.PropsMore)
	for _, g := range a.Groups {
		<div class="att-group">
			<h3 class="att-gh">{ g.Title }</h3>
			for _, it := range g.Items {
				@attItem(it)
			}
			@attMore(g.More)
		</div>
	}
}

// attItem is one entry of a group: a link to the device (or the guide) with the reason.
templ attItem(it AttItem) {
	<a class="att-row att-item" href={ templ.SafeURL(it.Href) }>
		if it.Status == nil {
			<span class={ "sdot-dot", it.Tone.class() } aria-hidden="true"></span>
		}
		if it.Text != "" {
			<span class="att-text"><span class="att-name">{ it.Name }</span><span class="att-why">{ it.Text }</span></span>
		} else {
			<span class="att-text"><span class="att-name">{ it.Name }</span></span>
		}
		if it.Status != nil {
			@StatusBadge(*it.Status)
		}
		<span class="att-go" aria-hidden="true">›</span>
	</a>
}

// attMore is the line under a capped list: a link to the list that holds the rest, or plain text.
templ attMore(m AttMore) {
	if m.Text != "" && m.Href != "" {
		<a class="att-more" href={ templ.SafeURL(m.Href) } aria-label={ m.Label }>{ m.Text }</a>
	} else if m.Text != "" {
		<p class="att-more">{ m.Text }</p>
	}
}

// attHidden are a proposal form's hidden fields: the CSRF token and the shown version.
templ attHidden(csrf, version string) {
	<input type="hidden" name="csrf" value={ csrf }/>
	if version != "" {
		<input type="hidden" name="version" value={ version }/>
	}
}

// SegBar is the transaction progress: succeeded, failed, running. The states differ by shape as well as by hue
// (#1073): done is one solid bar, running is stripes, failed is a checker (segRects).
templ SegBar(t TxnData) {
	<svg class="seg-bar" viewBox="0 0 1000 6" preserveAspectRatio="none" role="img" aria-label={ itoa(t.OK) + " done, " + itoa(t.Failed) + " failed, " + itoa(t.Active) + " running of " + itoa(t.Total) }>
		for _, s := range txnSegments(t) {
			for _, r := range segRects(s) {
				<rect class={ "bar-seg", s.Tone.class() } x={ itoa(r.X) } y={ itoa(r.Y) } width={ itoa(r.W) } height={ itoa(r.H) }></rect>
			}
		}
	</svg>
}

// MiniBar is a row's progress in percent with the number beside it.
templ MiniBar(pct int) {
	<span class="mini-bar">
		<svg viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true"><rect class="mini-bg" x="0" y="0" width="100" height="4"></rect><rect class="mini-fill" x="0" y="0" width={ itoa(min(max(pct, 0), 100)) } height="4"></rect></svg>
		<span class="mini-pct">{ itoa(pct) }%</span>
	</span>
}

// TxnCard is a transaction that is still at work: id, title, state, progress, summary and when it started; a link to it.
templ TxnCard(t TxnData) {
	<a class="txn-card" href={ templ.SafeURL(t.Href) }>
		<span class="txn-head"><span class="txn-id">{ t.ID }</span><span class="txn-title">{ t.Title }</span>
			@Badge(t.StateTone, t.State)
		</span>
		@SegBar(t)
		<span class="txn-sum">
			<span>{ t.Summary }</span>
			if t.StartedText != "" {
				<span class="txn-when">
					started
					if t.Started.IsZero() {
						{ t.StartedText }
					} else {
						<time { StampAttrs(t.Started, StampRelative)... }>{ t.StartedText }</time>
					}
				</span>
			}
		</span>
	</a>
}

// TxnRow is one finished transaction in the history list.
templ TxnRow(r TxnRowData) {
	<a class="att-row txn-row" href={ templ.SafeURL(r.Href) }>
		<span class="txn-id">{ r.ID }</span>
		<span class="txn-row-title">{ r.Title }</span>
		@Badge(r.Tone, r.Result)
		if r.WhenAt.IsZero() {
			<span class="txn-when">{ r.When }</span>
		} else {
			<span class="txn-when"><time { StampAttrs(r.WhenAt, StampRelative)... }>{ r.When }</time></span>
		}
	</a>
}

// Dialog is a confirmation dialog. dialog.js opens it from a [data-dialog] trigger; without
// JavaScript the trigger's link leads to the confirmation page (ConfirmPage).
templ Dialog(d DialogData) {
	<dialog id={ d.ID } class="udlg" aria-labelledby={ d.ID + "-h" } open?={ d.Static } data-static?={ d.Static }
		if d.OOB {
			hx-swap-oob="true"
		}
	>
		<form method="post" action={ templ.SafeURL(d.Action) } class="udlg-in">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			for _, f := range d.Fields {
				<input type="hidden" name={ f.Key } value={ f.Value }/>
			}
			<h2 id={ d.ID + "-h" }>{ d.Title }</h2>
			<p class="udlg-body">
				if !d.BodyStamp.IsZero() {
					@StampedText(d.BodyStamp)
				} else {
					{ d.Body }
				}
			</p>
			if d.Command != "" {
				<label class="ufield"><span class="ufield-label">Command</span><input name="command" class="mono" value={ d.Command }/></label>
			}
			if len(d.Changes) > 0 {
				<div class="udlg-changes">
					for _, c := range d.Changes {
						<div><span>{ c.Key }</span><span class="mono">{ c.Value }</span></div>
					}
				</div>
			}
			<div class="udlg-foot">
				<button type="button" class="btn" data-close>Cancel</button>
				if d.Alt != "" {
					<button type="submit" class="btn" formaction={ templ.SafeURL(d.AltAction) }>{ d.Alt }</button>
				}
				<button type="submit" class={ "btn", templ.KV("btn-danger-solid", d.Danger), templ.KV("btn-primary", !d.Danger) }>{ d.Verb }</button>
			</div>
		</form>
	</dialog>
}

// StepUp is the "Confirm it's you" dialog: re-authentication with the identity provider, or the
// local password. It posts to the existing step-up route.
templ StepUp(s StepUpData) {
	<dialog id={ s.ID } class="udlg stepup" aria-labelledby={ s.ID + "-h" } open?={ s.Static || s.Open } data-static?={ s.Static } data-autoopen?={ s.Open }>
		<form method="post" action={ templ.SafeURL(s.Action) } class="udlg-in">
			<input type="hidden" name="csrf" value={ s.CSRF }/>
			if s.Next != "" {
				<input type="hidden" name="next" value={ s.Next }/>
			}
			for _, f := range s.Fields {
				<input type="hidden" name={ f.Key } value={ f.Value }/>
			}
			<div class="stepup-who">
				@Avatar(s.Name, s.Name)
				<div><h2 id={ s.ID + "-h" }>Confirm it’s you</h2><div class="stepup-sub">{ s.Sub }</div></div>
			</div>
			<p class="udlg-body"><b>{ s.What }</b> is an admin action. Sign in again to continue; you won’t be asked again for 5 minutes.</p>
			if s.IdP != "" && s.IdPHref != "" {
				@Button(Btn{Label: "Re-authenticate with " + s.IdP, Kind: "primary", Tall: true, Type: "submit", FormAction: s.IdPHref, NoValidate: true})
			} else if s.IdP != "" {
				@Button(Btn{Label: "Re-authenticate with " + s.IdP, Kind: "primary", Tall: true, Type: "submit", NoValidate: true})
			}
			if s.IdP != "" && s.Local {
				<div class="or-rule">or use your local password</div>
			}
			if s.Local {
				@Field(FieldData{Label: "Password", Name: s.passwordName(), Type: "password", Error: s.Error, Autocomplete: "current-password"})
			} else if s.Error != "" {
				<p class="ufield-err" role="alert">{ s.Error }</p>
			}
			<div class="udlg-foot">
				<button type="button" class="btn" data-close>Cancel</button>
				if s.Local {
					<button type="submit" class="btn btn-primary">Confirm</button>
				}
			</div>
		</form>
	</dialog>
}

// ConfirmPage is a confirmation as a page (no JavaScript): the dialog's look, a form that posts
// with the CSRF token, Cancel as a link back.
templ ConfirmPage(c ConfirmData) {
	@PageHeader(c.Title, "")
	<section
		class="ucard confirm-card"
		if c.showHeading() {
			aria-labelledby="confirm-h"
		} else {
			aria-label={ c.Title }
		}
	>
		if c.showHeading() {
			<h2 id="confirm-h">{ c.Heading }</h2>
		}
		<p class="udlg-body">
			if !c.TextStamp.IsZero() {
				@StampedText(c.TextStamp)
			} else {
				{ c.Text }
			}
		</p>
		if c.Warning != "" {
			@Banner(BannerData{Tone: ToneDanger, Text: c.Warning, Alert: true})
		}
		if c.ACL {
			@BrokerACLNotice()
		}
		if len(c.Facts) > 0 {
			@KV(c.Facts)
		}
		<form method="post" action={ templ.SafeURL(c.Action) } class="udlg-foot" data-no-busy?={ c.NoBusy }>
			<input type="hidden" name="csrf" value={ c.CSRF }/>
			for _, f := range c.Fields {
				<input type="hidden" name={ f.Key } value={ f.Value }/>
			}
			if c.Ack != "" {
				<label class="ucheck"><input type="checkbox" name="ack" value="1" required/><span>{ c.Ack }</span></label>
			}
			<a class="btn" href={ templ.SafeURL(c.CancelHref) }>{ c.CancelLabel }</a>
			<button type="submit" class={ "btn", templ.KV("btn-danger-solid", c.Danger), templ.KV("btn-primary", !c.Danger) }>{ c.Verb }</button>
		</form>
	</section>
}

// Empty is the empty state of a list: an icon tile, a heading, a line and up to three buttons
// (children).
templ Empty(title, text string) {
	<div class="uempty">
		<div class="uempty-icon" aria-hidden="true"><span></span></div>
		<h2>{ title }</h2>
		<p>{ text }</p>
		<div class="btn-row">
			{ children... }
		</div>
	</div>
}

// NoMatch is the row of a filtered list without results, with the way back.
templ NoMatch(text, clearHref string) {
	<div class="nomatch">
		<span>{ text }</span>
		<a class="btn btn-sm" href={ templ.SafeURL(clearHref) }>Clear filters</a>
	</div>
}

// Skeleton is the loading state of a lazily loaded list (D12: never a whole server page).
templ Skeleton(label string, rows int) {
	<div class="skel" aria-busy="true">
		<div class="skel-head">{ label }</div>
		for i := 0; i < rows; i++ {
			<div class={ "skel-row", "skel-w" + itoa(i%4) }><span class="skel-box"></span><span class="skel-line"></span><span class="skel-fill"></span><span class="skel-end"></span></div>
		}
	</div>
}

// ErrorPage is a full error page: the status code, a title, the explanation, the path that
// failed and two ways on, in a card centred on the page (#1085).
templ ErrorPage(code, title, body, path string, primary, secondary Btn) {
	@errorPage(code, title, body, path, primary, secondary, "h1")
}

// ErrorCard is ErrorPage for a page that has its own h1 already (a device's page keeps the device's name as
// its one h1): the title is an h2.
templ ErrorCard(code, title, body, path string, primary, secondary Btn) {
	@errorPage(code, title, body, path, primary, secondary, "h2")
}

// ErrorPageSample is ErrorPage for a sample on /styleguide: the title is a div with the h1
// styling, because the page around the sample already has its own h1 (#515).
templ ErrorPageSample(code, title, body, path string, primary, secondary Btn) {
	@errorPage(code, title, body, path, primary, secondary, "sample")
}

// errorPage draws the card. level is the title's element: "h1", "h2" or "sample" (a div with the h1 look).
templ errorPage(code, title, body, path string, primary, secondary Btn, level string) {
	<div class={ "errpage", templ.KV("errpage-sub", level == "h2") }>
		<div class="errpage-in">
			<span class="errpage-code">{ code }</span>
			switch level {
				case "sample":
					<div class="h1-sample">{ title }</div>
				case "h2":
					<h2>{ title }</h2>
				default:
					<h1>{ title }</h1>
			}
			<p>{ body }</p>
			if path != "" {
				<div class="errpage-path">{ path }</div>
			}
			<div class="btn-row">
				@Button(primary)
				@Button(secondary)
			</div>
		</div>
	</div>
}

// AuthCard is the card of the sign-in, setup and password pages: the brand above, the card
// (children) and the footer "TasmoFleet x.y.z · host" (D15).
templ AuthCard(base, version, host string) {
	<div class="uauth">
		@Brand(base)
		<div class="auth-card">
			{ children... }
		</div>
		<div class="auth-foot" data-visual-mask><span>TasmoFleet { version }</span> · <span>{ host }</span></div>
	</div>
}

// Console is the device console: a dark panel with timestamped lines and the prompt, the quick
// commands below it. Quick commands are submit buttons that send their command (no JavaScript).
templ Console(c ConsoleData) {
	<div class="console" if c.HistoryAdd != "" { data-history-add={ c.HistoryAdd } }>
		<div class="console-head">
			<span class="console-dot" aria-hidden="true"></span><span class="console-title">{ c.Title }</span>
			if c.ClearHref != "" {
				<a class="console-clear" href={ templ.SafeURL(c.ClearHref) }>Clear</a>
			} else {
				<button type="button" class="console-clear">Clear</button>
			}
		</div>
		<div class="console-lines" role="log" aria-label="Console output" tabindex="0">
			for _, l := range c.Lines {
				<div class={ "console-line", templ.KV("is-cmd", l.Kind == "cmd"), templ.KV("is-err", l.Kind == "err" || l.Kind == "alert"), templ.KV("is-dim", l.Kind == "dim"), templ.KV("is-reply", l.Kind == "reply") } if l.Kind == "reply" { data-visual-mask="console-reply" } if l.Kind == "alert" { role="alert" }>
					if l.Datetime != "" {
						<time class="console-time" datetime={ l.Datetime } data-ts="clock-24">{ l.Time }</time>
					} else {
						<span class="console-time">{ l.Time }</span>
					}
					if l.Who != "" {
						<span class="console-text">@SoftJSON(l.Text) <span class="console-who">{ l.Who }</span></span>
					} else {
						<span class="console-text">@SoftJSON(l.Text)</span>
					}
				</div>
			}
		</div>
		<form method="post" action={ templ.SafeURL(c.Action) } class="console-form">
			<input type="hidden" name="csrf" value={ c.CSRF }/>
			for _, f := range c.Hidden {
				<input type="hidden" name={ f.Key } value={ f.Value }/>
			}
			<span class="console-prompt" aria-hidden="true">›</span>
			<input name="command" data-history-input value={ c.Input } placeholder="Type a Tasmota command, e.g. Status 5" aria-label="Command" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="255" required/>
			<button type="submit" class="console-send">Send</button>
		</form>
		<div class="console-histbar"><button type="button" class="console-histlink" data-history-clear hidden>Clear history</button></div>
	</div>
	if len(c.Quick) > 0 {
		<form method="post" action={ templ.SafeURL(c.Action) } class="console-quick">
			<input type="hidden" name="csrf" value={ c.CSRF }/>
			for _, f := range c.Hidden {
				<input type="hidden" name={ f.Key } value={ f.Value }/>
			}
			<span class="console-quick-l">Quick</span>
			for _, q := range c.Quick {
				switch {
				case q.Why != "":
					@Button(Btn{Label: q.Command, DisabledReason: q.Why, ReasonID: q.WhyID, ReasonShared: true, Class: "console-chip"})
				case q.Href != "":
					@Button(Btn{Label: q.Command, Href: q.Href, Dialog: q.Dialog, Class: "console-chip"})
				default:
					<button type="submit" class="btn console-chip" name="command" value={ q.Command }>{ q.Command }</button>
				}
			}
		</form>
	}
}

// diffLabel is the label of one side of a Diff: the instant as a time element, or the plain label.
templ diffLabel(label string, at time.Time) {
	if at.IsZero() {
		{ label }
	} else {
		<time { StampAttrs(at, StampDateTime)... }>{ StampText(at, StampDateTime) }</time>
	}
}

// Diff compares two backups side by side or unified; changed rows are tinted.
templ Diff(d DiffData) {
	<section class="ulist diff">
		if !d.Unified {
			<div class="diff-scroll">
				<div class="diff-grid diff-headrow"><span>Setting</span><span>Older · @diffLabel(d.OldLabel, d.OldAt)</span><span>Newer · @diffLabel(d.NewLabel, d.NewAt)</span></div>
				for _, r := range d.Rows {
					<div class={ "diff-grid", "diff-row", templ.KV("is-changed", r.Changed) }><span class="diff-key">{ r.Key }</span><span>{ r.Old }</span><span>{ r.New }</span></div>
				}
			</div>
		} else {
			<div class="diff-uni">
				<div class="diff-uni-head">− @diffLabel(d.OldLabel, d.OldAt)<br/>+ @diffLabel(d.NewLabel, d.NewAt)</div>
				for _, r := range d.Rows {
					if r.Changed {
						<div class="diff-line is-del"><span>−</span><span><b>{ r.Key }</b> { r.Old }</span></div>
						<div class="diff-line is-add"><span>+</span><span><b>{ r.Key }</b> { r.New }</span></div>
					} else {
						<div class="diff-line"><span></span><span><b>{ r.Key }</b> { r.Old }</span></div>
					}
				}
			</div>
		}
	</section>
}

// Notes renders release notes from text blocks; nothing in them becomes markup.
templ Notes(blocks []NoteBlock) {
	<article class="unotes">
		for _, b := range blocks {
			switch b.Kind {
				case "h":
					<h2>{ b.Text }</h2>
				case "ul":
					<ul>
						for _, it := range b.Items {
							<li>{ it }</li>
						}
					</ul>
				case "code":
					<pre><code>{ b.Text }</code></pre>
				case "breaking":
					<section class="unotes-breaking">
						<h2><span class="sdot-dot t-warn" aria-hidden="true"></span>{ b.Text }</h2>
						<ul>
							for _, it := range b.Items {
								<li>{ it }</li>
							}
						</ul>
					</section>
				default:
					<p>{ b.Text }</p>
			}
		}
	</article>
}
