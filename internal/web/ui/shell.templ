package ui

import (
	"encoding/json"
	"strconv"
)

// htmxConfig is the htmx configuration meta tag: no eval, no script tags in responses,
// same-origin requests only, 4xx/5xx bodies are swapped in as error content.
const htmxConfig = `{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"selfRequestsOnly":true,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}]}`

// deferred scripts of every page, in load order (htmx and its SSE extension load first, blocking).
var deferredScripts = []string{"theme.js", "live.js", "toast.js", "select.js", "form.js", "batch.js", "menu.js", "copy.js", "dialog.js", "tables.js", "tooltip.js", "firmware.js", "tabs.js"}

// csrfHeaders is the htmx default request header carrying the CSRF token.
func csrfHeaders(token string) string {
	q, err := json.Marshal(token)
	if err != nil { // a string always marshals
		q = []byte(`""`)
	}
	return `{"X-CSRF-Token": ` + string(q) + `}`
}

// Shell is the page frame every full page renders in (design v2): head, the top bar with its
// sub-navigation (desktop) or the phone header, the navigation drawer, the crumbs, the
// connection banners, the notices, the page's content and the toast region. The content is any
// component: a ported page, or the bridge that runs a not-yet-ported html/template page.
//
// No element is a size container (D5 as built): the gutters' cqw then resolves against the
// viewport including the scrollbar, exactly what the prototype's root measures, and fixed
// elements (drawer, toasts, bulk bar) stay positioned against the window.
templ Shell(d ShellData, content templ.Component) {
	<!DOCTYPE html>
	<html
		lang="en"
		if d.Theme == "light" || d.Theme == "dark" {
			data-theme={ d.Theme }
		} else {
			data-theme-auto
		}
	>
		@head(d)
		<body
			data-prefs={ d.Base + "/prefs" }
			hx-headers={ csrfHeaders(d.CSRF) }
			if d.Live {
				hx-ext="sse"
				sse-connect={ d.Base + "/events" }
			}
		>
			<header class="top">
				@topBar(d)
				@subNav(d)
				@phoneHeader(d)
				if d.Live {
					@connBanners()
				}
			</header>
			@NavDrawer(d)
			<main id="main">
				@Crumbs(d.Trail(), d.Base)
				if d.Flash != "" {
					<p class="banner tone-ok" role="status" data-flash><span class="banner-dot"></span><span class="banner-text">{ d.Flash }</span></p>
				}
				if d.Nav != "setup" && d.Banner != "" {
					<p class="banner tone-warn" role="status"><span class="banner-dot"></span><span class="banner-text">{ d.Banner } <a href={ templ.SafeURL(d.Base + "/setup") }>Open the setup</a></span></p>
				}
				@content
			</main>
			<div class="toasts" id="toasts" aria-live="polite"></div>
		</body>
	</html>
}

// Bare is a page without the navigation (the first-run setup, design v2 "setup"): the same
// document head, the content centred under the brand (AuthCard).
templ Bare(d ShellData, content templ.Component) {
	<!DOCTYPE html>
	<html
		lang="en"
		if d.Theme == "light" || d.Theme == "dark" {
			data-theme={ d.Theme }
		} else {
			data-theme-auto
		}
	>
		@head(d)
		<body data-prefs={ d.Base + "/prefs" } hx-headers={ csrfHeaders(d.CSRF) }>
			<main id="main" class="bare">
				@content
			</main>
			<div class="toasts" id="toasts" aria-live="polite"></div>
		</body>
	</html>
}

// head is the document head of every page: title, icons, fonts, the stylesheet and the scripts.
templ head(d ShellData) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="htmx-config" content={ htmxConfig }/>
		<title>{ d.Title } - TasmoFleet</title>
		<link rel="icon" href={ d.Base + "/favicon.ico" } sizes="48x48"/>
		<link rel="icon" href={ d.static("favicon.svg") } type="image/svg+xml"/>
		<link rel="apple-touch-icon" href={ d.static("apple-touch-icon.png") }/>
		<link rel="manifest" href={ d.Base + "/static/manifest.webmanifest" }/>
		<link rel="preload" href={ d.static("geist-latin.woff2") } as="font" type="font/woff2" crossorigin/>
		<link rel="preload" href={ d.static("geist-mono-latin.woff2") } as="font" type="font/woff2" crossorigin/>
		<link rel="stylesheet" href={ d.static("app.css") }/>
		<script src={ d.static("htmx-2.0.11.min.js") }></script>
		<script src={ d.static("htmx-ext-sse-2.2.4.js") }></script>
		for _, s := range deferredScripts {
			<script src={ d.static(s) } defer></script>
		}
	</head>
}

// BrandMark is the TasmoFleet logo (D16): the prototype's top-bar mark, a ring on a blue tile.
// assets/branding/logo.svg is the same drawing.
templ BrandMark(size string) {
	<svg class="brand-mark" width={ size } height={ size } viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#1f63a8"></rect><circle cx="16" cy="16" r="5.2" fill="none" stroke="#fff" stroke-width="2.9"></circle></svg>
}

// Brand is the mark with the wordmark, linked to the dashboard.
templ Brand(base string) {
	<a class="brand" href={ templ.SafeURL(base + "/") }>
		@BrandMark("22")
		TasmoFleet
	</a>
}

// topBar is the desktop row: brand, the four groups, the live indicator and the user menu. The
// groups are links to their first page; the sub-navigation lists the group's pages.
templ topBar(d ShellData) {
	<div class="tb">
		<div class="shell-in tb-in">
			@Brand(d.Base)
			<nav class="tb-groups" aria-label="Main">
				for _, g := range d.Groups() {
					<a
						class="tb-group"
						href={ templ.SafeURL(d.Base + g.Path) }
						if g.Current {
							aria-current="true"
						}
					>{ g.Label }</a>
				}
			</nav>
			<span class="tb-fill"></span>
			if d.Live {
				@liveIndicator()
			}
			@userMenu(d)
		</div>
	</div>
}

// subNav is the row under the top bar with the pages of the current group.
templ subNav(d ShellData) {
	if g, ok := d.currentGroup(); ok {
		<div class="sn">
			<nav class="shell-in sn-in" aria-label={ g.Label }>
				for _, it := range g.Items {
					<a
						class="sn-item"
						href={ templ.SafeURL(d.Base + it.Path) }
						if it.Current {
							aria-current="page"
						}
					>
						{ it.Label }
						@navBadge(it.Badge)
					</a>
				}
			</nav>
		</div>
	} else {
		<div class="sn sn-empty"></div>
	}
}

// liveIndicator is the connection state of the live updates: live.js sets data-live on <html>
// from the SSE extension's events, the stylesheet shows the matching label.
templ liveIndicator() {
	<span class="live">
		<span class="live-dot"></span>
		<span class="live-l live-ok">Live</span>
		<span class="live-l live-re">Reconnecting…</span>
		<span class="live-l live-off">Offline</span>
	</span>
}

// avatar is the round initials badge of the signed-in user; news > 0 adds the dot that says
// What's new has releases the user has not seen (N5).
templ avatar(name string, news int) {
	<span class="avatar" aria-hidden="true" data-visual-mask>
		{ Initials(name) }
		if news > 0 {
			<span class="avatar-dot"></span>
		}
	</span>
	if news > 0 {
		<span class="sr-only">, { newsText(news) }</span>
	}
}

// userMenu is the avatar button with the account menu: who is signed in, the theme, the account
// page and Sign out. A <details> element, so it opens without JavaScript; menu.js adds Escape
// and click-outside.
templ userMenu(d ShellData) {
	@userMenuOf(d, false)
}

// UserMenuStatic is the user menu open in the flow, for the style guide (data-static: the
// scripts leave it alone).
templ UserMenuStatic(d ShellData) {
	@userMenuOf(d, true)
}

templ userMenuOf(d ShellData, static bool) {
	<details class="navgroup usermenu" open?={ static } data-static?={ static }>
		<summary class="um-btn">
			@avatar(d.UserName, d.News)
			<span class="um-first" data-visual-mask>{ FirstName(d.UserName) }</span>
			<span class="um-caret" aria-hidden="true">▼</span>
		</summary>
		<div class="um-menu">
			<div class="um-who"><div class="um-name" data-visual-mask>{ d.UserName }</div><div class="um-role" data-visual-mask>{ d.RoleLine() }</div></div>
			<div class="um-theme">
				<span>Theme</span>
				@themeSwitch(d)
			</div>
			<p class="um-note" data-theme-note hidden?={ d.Theme != "" }>Auto follows your system</p>
			<a class="um-item um-news" href={ templ.SafeURL(d.Base + "/whats-new") }>
				What’s new
				if d.News > 0 {
					<span class="bdg t-accent">{ newsText(d.News) }</span>
				}
			</a>
			if d.UserMethod == "local" {
				<a class="um-item" href={ templ.SafeURL(d.Base + "/account") }>Account &amp; password</a>
			} else {
				<a class="um-item" href={ templ.SafeURL(d.Base + "/account") }>Account</a>
			}
			<form method="post" action={ templ.SafeURL(d.Base + "/logout") }><input type="hidden" name="csrf" value={ d.CSRF }/><button type="submit" class="um-item">Sign out</button></form>
		</div>
	</details>
}

// themeSwitch is the segmented Light / Dark / Auto control (D11). theme.js applies a choice at
// once and stores it per user (POST <base>/prefs/theme); without JavaScript the page follows the
// system.
templ themeSwitch(d ShellData) {
	<div class="seg" role="group" aria-label="Theme">
		<button type="button" data-theme-choice="light" aria-pressed={ ariaBool(d.Theme == "light") }>Light</button>
		<button type="button" data-theme-choice="dark" aria-pressed={ ariaBool(d.Theme == "dark") }>Dark</button>
		<button type="button" data-theme-choice="auto" aria-pressed={ ariaBool(d.Theme == "") }>Auto</button>
	</div>
}

func ariaBool(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

// phoneHeader is the top bar below 45rem: menu button, page title, live state, avatar. Both
// buttons are links to /nav, the drawer as a page; dialog.js opens the drawer instead.
templ phoneHeader(d ShellData) {
	<div class="ph">
		<a class="ph-btn ph-menu" href={ templ.SafeURL(d.Base + "/nav") } data-dialog="nav-drawer" aria-label="Open navigation"><span class="burger" aria-hidden="true"><span></span><span></span><span></span></span></a>
		<span class="ph-title">{ d.Title }</span>
		if d.Live {
			@liveIndicator()
		}
		<a class="ph-btn ph-me" href={ templ.SafeURL(d.Base + "/nav") } data-dialog="nav-drawer" aria-label="Account and theme">
			@avatar(d.UserName, d.News)
		</a>
	</div>
}

// NavDrawer is the phone navigation: a modal <dialog> opened by dialog.js. Without JavaScript
// the buttons that open it lead to /nav, which shows the same list as a page.
templ NavDrawer(d ShellData) {
	<dialog id="nav-drawer" class="drawer" aria-label="Navigation">
		@NavList(d)
	</dialog>
}

// NavList is the content of the drawer and of /nav: the brand, every group with its pages, then
// the account, the theme and Sign out.
templ NavList(d ShellData) {
	<div class="dr">
		<div class="dr-brand">
			@BrandMark("22")
			TasmoFleet
		</div>
		<nav aria-label="Main">
			for _, g := range d.Groups() {
				<div class="dr-group">
					<p class="dr-label">{ g.Label }</p>
					for _, it := range g.Items {
						<a
							class="dr-item"
							href={ templ.SafeURL(d.Base + it.Path) }
							if it.Current {
								aria-current="page"
							}
						>
							{ it.Label }
							@navBadge(it.Badge)
						</a>
					}
				</div>
			}
		</nav>
		<div class="dr-foot">
			<a class="dr-item" href={ templ.SafeURL(d.Base + "/account") }>Account · { d.UserName }</a>
			<a class="dr-item" href={ templ.SafeURL(d.Base + "/whats-new") }>
				What’s new
				if d.News > 0 {
					<span class="bdg t-accent">{ strconv.Itoa(d.News) } new</span>
				}
			</a>
			<div class="dr-theme">
				<span>Theme</span>
				@themeSwitch(d)
			</div>
			<form method="post" action={ templ.SafeURL(d.Base + "/logout") }><input type="hidden" name="csrf" value={ d.CSRF }/><button type="submit" class="dr-item">Sign out</button></form>
		</div>
	</div>
}

// Crumbs is the breadcrumb trail above the page title; the last step is the page itself.
templ Crumbs(trail []Crumb, base string) {
	if len(trail) > 0 {
		<nav class="crumbs" aria-label="Breadcrumb">
			for i, c := range trail {
				if i > 0 {
					<span class="crumb-sep" aria-hidden="true">/</span>
				}
				if c.Path != "" {
					<a href={ templ.SafeURL(base + c.Path) }>{ c.Label }</a>
				} else if i == len(trail)-1 {
					<span class="crumb-here" aria-current="page">{ c.Label }</span>
				} else {
					<span class="crumb-here">{ c.Label }</span>
				}
			}
		</nav>
	}
}

// connBanners are the two connection banners; the stylesheet shows one while data-live on
// <html> says "reconnecting" or "offline", live.js fills in the numbers. They float just below
// the sticky header, over the page, so showing or hiding one never moves the content.
templ connBanners() {
	<div class="conn-banners">
		<div class="banner tone-warn conn-banner conn-re" role="status">
			<span class="banner-dot pulse"></span>
			<div class="banner-text"><b>Live updates interrupted.</b> Reconnecting (attempt <span data-live-attempt>1</span>, next try in <span data-live-next data-visual-mask>4</span> s). Values may be a few seconds old.</div>
		</div>
		<div class="banner tone-danger conn-banner conn-off" role="alert">
			<span class="banner-dot"></span>
			<div class="banner-text"><b>Connection to the server lost.</b> Live updates are paused; values shown are from <time data-live-since>the last page load</time>. Retrying in <span data-live-next data-visual-mask>8</span> s.</div>
			<button type="button" class="banner-btn" data-live-retry>Retry now</button>
		</div>
	</div>
}

// navBadge is the count pill on a navigation entry (new devices on "Add devices").
templ navBadge(n int) {
	if n > 0 {
		<span class="nav-badge"><span class="sr-only">, new: </span>{ strconv.Itoa(n) }</span>
	}
}

// newsText is the user menu's count of unseen releases: "2 new since last visit".
func newsText(n int) string { return strconv.Itoa(n) + " new since last visit" }
