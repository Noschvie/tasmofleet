package web

import (
	"strconv"

	"github.com/hellwand/tasmofleet/internal/model"
	"github.com/hellwand/tasmofleet/internal/web/ui"
)

// nameOfferNotice says what the device calls itself while the stored name differs (#125). The
// stored name is never overwritten; "Use device name" adopts it, "Keep" declines exactly this name.
templ nameOfferNotice(c identCard) {
	@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Text: "Name on the device: ", Class: "name-offer", Action: c.useNameAction()}) {
		<b>{ c.NameOffer }</b>
	}
}

// deviceHeader is the header of every device tab (prototype screen "device"): the name with the
// state, the address / chip / firmware line, the device buttons, the offline banner and the tabs.
// Buttons are plain forms and links; dialog.js turns Restart into a dialog. Delete leads to the
// delete page (N2): a dialog could not carry the backup list, the choice and the acknowledgement.
templ deviceHeader(t deviceTabs) {
	@deviceHead(t, nil)
	@deviceHeadRest(t)
}

// deviceHeadSwap is what a successful "Refresh identity" sends besides the identity card: the
// header, the breadcrumb, phone title and page title, out of band, so they show the refreshed name,
// address, chip and firmware without a reload (#104).
templ deviceHeadSwap(t deviceTabs, crumbs []ui.Crumb) {
	@deviceHead(t, templ.Attributes{"hx-swap-oob": "true"})
	@deviceOffSlot(t, templ.Attributes{"hx-swap-oob": "true"})
	if t.CanRestart {
		@restartDialog(t, true)
	}
	@ui.CrumbsOOB(crumbs, t.Base)
	@ui.PhoneTitleOOB("device")
	<title>{ t.Name } - TasmoFleet</title>
}

// deviceHead is the name, state, meta line and buttons of the header.
templ deviceHead(t deviceTabs, attrs templ.Attributes) {
	<div class="devhd" id="devhd" { attrs... }>
		<div class="devhd-t">
			<div class="devhd-name">
				<h1>{ t.Name }</h1>
				<span class={ "devhd-state", "t-" + string(t.stateTone()) }><span class="devhd-dot" aria-hidden="true"></span>{ t.stateLabel() }</span>
			</div>
			<div class="devhd-meta">
				<span data-visual-mask>{ t.Address }</span>
				if t.Hostname != "" {
					<span data-visual-mask>{ t.Hostname }</span>
				}
				if t.Chip != "" {
					<span>{ t.Chip }</span>
				}
				if t.Version != "" {
					<span>Tasmota { t.Version }</span>
				}
				if t.UpdateTo != "" {
					<form method="post" action={ templ.SafeURL(t.Base + "/updates/new") } class="devhd-upd">
						<input type="hidden" name="csrf" value={ t.CSRF }/>
						<input type="hidden" name="id" value={ strconv.FormatInt(int64(t.ID), 10) }/>
						<button
							type="submit"
							disabled?={ t.updateBtnWhy() != "" }
							if t.updateBtnWhy() != "" {
								title={ t.updateBtnWhy() }
								aria-disabled="true"
								aria-describedby={ t.describedBy() }
							}
						>Update to { t.UpdateTo }</button>
					</form>
				}
			</div>
		</div>
		<div class="devhd-acts">
			if t.CanRestart {
				if t.restartWhy() != "" {
					@ui.Button(ui.Btn{Label: "Restart", DisabledReason: t.restartWhy(), ReasonID: t.describedBy(), ReasonShared: true})
				} else {
					@ui.Button(ui.Btn{Label: "Restart", Href: t.Base + devPath(t.ID, "/restart"), Dialog: restartDialogID})
				}
			}
			<form method="post" action={ templ.SafeURL(t.Base + devPath(t.ID, "/backup")) }>
				<input type="hidden" name="csrf" value={ t.CSRF }/>
				<input type="hidden" name="back" value={ t.backPath() }/>
				if t.BackupWhy != "" {
					@ui.Button(ui.Btn{Label: "Back up", DisabledReason: t.BackupWhy, ReasonID: t.describedBy(), ReasonShared: true})
				} else {
					@ui.Button(ui.Btn{Label: "Back up", Type: "submit"})
				}
			</form>
			if t.IsAdmin {
				// Edit and Delete are buttons on a wide screen and entries of one "⋯" menu on a phone (#1079): the
				// wrapper lays out as if it were not there, and CSS shows one of the two sets, never both.
				<div class="devhd-wide">
					@ui.Button(ui.Btn{Label: "Edit", Href: t.Base + devPath(t.ID, "/edit")})
					@ui.Button(ui.Btn{Label: "Delete", Kind: "danger", Href: t.Base + devPath(t.ID, "/delete")})
				</div>
				// hx-preserve: the header comes back out of band on every live refresh, and a menu the person has
				// just opened must stay open. Its entries depend on the role only, which a refresh does not change.
				<div class="devhd-more" id={ "devhd-more-" + devID(t.ID) } hx-preserve>
					@ui.RowMenu("More actions", t.moreItems(), false)
				</div>
			}
		</div>
		if lines := t.headReasons(); len(lines) > 0 {
			// Why a button cannot act, in a row of its own under the buttons (the broker notice's place, #853), only where the
			// slot's banner does not say it: a held device, an API that is off, a Back up without a path on an online device.
			<p class="devcard-note devhd-why" id="devhd-why">
				for i, g := range lines {
					if i > 0 {
						<br/>
					}
					{ g.Lead() + ": " }
					@keepTogether(g.Why)
				}
			</p>
		}
		if t.ACL {
			<div class="devhd-acl">
				@ui.BrokerACLNotice()
			</div>
		}
	</div>
}

// deviceHeadRest is what follows the header block: the tabs, the offline banner under them (as in the mockup) and the restart dialog.
templ deviceHeadRest(t deviceTabs) {
	@ui.Tabs("Device pages", t.headTabs())
	@deviceOffSlot(t, nil)
	if t.CanRestart {
		@restartDialog(t, false)
	}
}

// deviceOffSlot holds the one banner that says why the device cannot be used: the offline banner, or for a device that
// never answered the "has not answered yet" one (never both, #1082). The slot is always on the page, so a live refresh
// can put the banner in when the device goes offline and take it out when it is back (#126).
templ deviceOffSlot(t deviceTabs, attrs templ.Attributes) {
	<div id="devhd-slot" { attrs... }>
		if t.NotYet != "" {
			@ui.Banner(ui.BannerData{Tone: ui.ToneNeutral, ID: notYetBannerID, Text: t.NotYet})
		} else if t.offline() {
			@deviceOffBanner(t)
		}
	</div>
}

// deviceOffBanner says the device is offline and since when, and that its controls wait for it: one lead, one
// sentence. The buttons that cannot act point at it (aria-describedby="devhd-off", #1072); its id lets a refresh swap it (#110).
templ deviceOffBanner(t deviceTabs) {
	@ui.Banner(t.offlineBanner())
}

// restartDialog is the Restart confirmation, named after the device. oob: sent by a refresh that
// may have renamed the device, over the dialog already on the page (#110).
templ restartDialog(t deviceTabs, oob bool) {
	@ui.Dialog(ui.DialogData{ID: restartDialogID, Title: restartWords(t.Name).Title, Body: restartWords(t.Name).Text, Action: t.Base + devPath(t.ID, "/restart"), CSRF: t.CSRF, Verb: restartWords(t.Name).Verb, Danger: true, OOB: oob})
}

// deviceOverviewPage is the overview tab (#145, #421): the live tiles, the relay box, then two card
// stacks: Stability, Connection and the reach paths on the left, Identity and Activity on the right
// (phones keep the reading order Stability, Identity, Connection, paths, Activity through the rank
// classes). Offline puts "Last reported" on the tiles and cards except Reachability and Activity.
templ deviceOverviewPage(p deviceOverview) {
	@deviceHeader(p.Tabs)
	if u := p.Updating; u != nil {
		@ui.Banner(ui.BannerData{Tone: ui.ToneAccent, Title: updatingTitle(u.Job), Text: u.StepLabel + ". " + updatingText(u.Job), Action: &ui.Btn{Label: "Follow the transaction", Href: p.Base + "/transactions/" + strconv.FormatInt(int64(u.Job.BatchID), 10)}})
	}
	@liveRegion(p.Live)
	@ui.CardStacks(2) {
		@ui.CardStack(1) {
			if p.Stab != nil {
				@stabilityCard(*p.Stab, nil)
			}
			<section id="devconn" class={ "devcard", ui.StackRank(3) } aria-labelledby="dc-conn">
				<div class="devcard-head">
					<h2 id="dc-conn">{ p.Conn.Title }</h2>
					@staleLabel(!p.Live.Off)
				</div>
				@ui.KV(p.Conn.Rows)
			</section>
			if p.Paths != nil {
				@pathsCard(*p.Paths)
			}
		}
		@ui.CardStack(1) {
			@identityCard(p.Ident)
			@devActBox(p.Activity, nil)
		}
	}
}

// deviceLiveParts is the answer of the live refresh: the region the page replaces, and the
// Activity box, the header, the offline banner and, when what it shows changed, the Identity card
// out of band (#1003).
templ deviceLiveParts(p deviceOverview) {
	@liveRegion(p.Live)
	if p.Stab != nil {
		@stabilityCard(*p.Stab, templ.Attributes{"hx-swap-oob": "true"})
	}
	if !p.Activity.Unchanged {
		@devActBox(p.Activity, templ.Attributes{"hx-swap-oob": "true"})
	}
	if p.Ident.Changed {
		@identityCard(p.Ident)
	}
	if p.Paths != nil {
		@pathsLive(*p.Paths)
	}
	@deviceHead(p.Tabs, templ.Attributes{"hx-swap-oob": "true"})
	@deviceOffSlot(p.Tabs, templ.Attributes{"hx-swap-oob": "true"})
}

// keepTogether writes s with the "(SetOption128 N)" of the HTTP API wording kept on one line: at phone width
// the text must not break inside it (#659).
templ keepTogether(s string) {
	for _, part := range keepParts(s) {
		if part.Keep {
			<span class="nowrap">{ part.Text }</span>
		} else {
			{ part.Text }
		}
	}
}

// liveRegion is the tile row and the relay box. It asks for itself again when this device
// changes state or finishes a command (devstate-N, devjob-N), when its readings arrive
// (power-N, uptime-N, at most every 10 s) and when the stream was missed (resync, #160).
templ liveRegion(l liveView) {
	<div
		id="devlive"
		class="devlive"
		data-off?={ l.Off }
		if l.ReadsOff != "" {
			data-reads-off={ l.ReadsOff }
		}
		hx-get={ l.Base + devPath(l.ID, "/live") + "?act=" + l.ActSig }
		hx-include="#identsig"
		hx-trigger={ "sse:devstate-" + devID(l.ID) + " throttle:2s, sse:devjob-" + devID(l.ID) + " throttle:2s, sse:power-" + devID(l.ID) + " throttle:10s, sse:uptime-" + devID(l.ID) + " throttle:10s, sse:resync" }
		hx-swap="outerHTML"
	>
		if l.ReadsOff != "" {
			// the reason as the page writes it (the "(SetOption128 0)" kept on one line): live.js puts it into the Identity card's line
			<template data-ident-why>@keepTogether(l.ReadsOff)</template>
		}
		<div class="dev-tiles">
			for _, t := range l.Tiles {
				@liveTile(t, l)
			}
		</div>
		if l.Box != nil {
			@relayBoxView(l)
		} else if l.Sensors != nil {
			@sensorBoxView(l)
		}
	</div>
}

// staleLabel says "Last reported" on a tile or card whose values are what the device reported before it went
// offline. It is a word, not an opacity: text at half opacity misses the AA contrast, and says nothing to a screen
// reader (#1071). The live region renders it only while the device is offline; the Connection and Identity cards
// are not swapped by the live refresh, so they always carry it and live.js shows or hides it (syncDeviceOffline).
templ staleLabel(hide bool) {
	<span class="dev-stale" data-stale hidden?={ hide }>@ui.Badge(ui.ToneNeutral, "Last reported")</span>
}

func toneClass(t ui.Tone) string {
	if t == "" {
		return ""
	}
	return "t-" + string(t)
}

// liveTile is one tile of the live region. Offline it says "Last reported" (the last reported state), except
// Reachability: its "Offline" is the current state, not a last report (#676, #513, #1071).
templ liveTile(t tile, l liveView) {
	<div class="dev-tile" data-tile={ t.Key }>
		<div class="dev-tile-l">
			{ t.Label }
			if tileStale(t, l) {
				@staleLabel(false)
			}
		</div>
		<div class={ "dev-tile-v", toneClass(t.Tone) } data-visual-mask?={ t.Mask }>{ t.Value }</div>
		if t.Bar > 0 {
			<svg class={ "dev-bar", toneClass(t.BarTone) } viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true" data-visual-mask>
				<rect class="dev-bar-track" x="0" y="0" width="100" height="6"></rect>
				<rect class="dev-bar-fill" x="0" y="0" width={ strconv.Itoa(t.Bar) } height="6"></rect>
			</svg>
		}
		<div class="dev-tile-s">
			if !t.At.IsZero() {
				{ t.SubPrefix }<time data-visual-mask { ui.StampAttrs(t.At, ui.StampDay)... }>{ t.AtText }</time>
			} else {
				{ t.Sub }
			}
		</div>
		if t.Fix {
			<form method="post" action={ templ.SafeURL(l.Base + "/policy/fix") }>
				<input type="hidden" name="csrf" value={ l.CSRF }/>
				<input type="hidden" name="only" value={ devID(l.ID) }/>
				<input type="hidden" name="from" value="device"/>
				@ui.Button(ui.Btn{Label: "Make compliant…", Type: "submit", Class: "dev-tile-fix"})
			</form>
		}
	</div>
}

// relayBoxView is the box of relay switches: always the same four-column box, for one relay as
// well as for four. The switches are forms that also work without JavaScript; htmx replaces the
// live region with the answer.
templ relayBoxView(l liveView) {
	<section class="devcard dev-box" aria-labelledby="dc-relays">
		<div class="devcard-head">
			<h2 id="dc-relays">Relays</h2>
			if l.Off {
				@staleLabel(false)
			}
			<span class="dev-box-meta">{ l.Box.Right }</span>
		</div>
		<div class="dev-relays">
			for _, rl := range l.Box.Rows {
				<form
					method="post"
					action={ templ.SafeURL(l.Base + devPath(l.ID, "/power/"+strconv.Itoa(rl.N))) }
					class="dev-relay"
					hx-post={ l.Base + devPath(l.ID, "/power/"+strconv.Itoa(rl.N)) }
					hx-target="#devlive"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="csrf" value={ l.CSRF }/>
					<input type="hidden" name="action" value={ rl.Action }/>
					<input type="hidden" name="back" value="device"/>
					<div class="dev-relay-t">
						<span class="dev-relay-n">{ rl.Name } <span class="mono">{ rl.Cmd }</span></span>
						<span class="dev-relay-s" data-visual-mask>{ rl.Line }</span>
					</div>
					<button
						type="submit"
						class="devrelay-sw"
						role="switch"
						aria-checked={ ariaBool(rl.On) }
						aria-label={ rl.Aria }
						disabled?={ !l.Box.Enabled }
						if l.Box.Why != "" {
							title={ l.Box.Why }
							aria-describedby="dev-relays-why"
						}
					><span class="devsw" aria-hidden="true"></span></button>
				</form>
			}
		</div>
		if l.Box.Why != "" {
			<p class="devcard-note" id="dev-relays-why">Switching is disabled: @keepTogether(l.Box.Why)</p>
		}
		if l.Box.Err != "" {
			<p class="error" role="alert">@keepTogether(l.Box.Err)</p>
		}
	</section>
}

// sensorBoxView is the Sensors box that takes the place of the relay box on a device without
// relays. Its readings are the last ones received: labelled "Last reported" while the device is offline.
templ sensorBoxView(l liveView) {
	<section class="devcard dev-box" aria-labelledby="dc-sensors">
		<div class="devcard-head">
			<h2 id="dc-sensors">Sensors</h2>
			if l.Off {
				@staleLabel(false)
			}
			<span class="dev-box-meta">{ l.Sensors.Right }</span>
		</div>
		if len(l.Sensors.Cells) > 0 {
			<div class="dev-relays">
				for _, c := range l.Sensors.Cells {
					<div class="dev-sensor">
						<span class="dev-sensor-l">{ c.Label }</span>
						<span class="dev-sensor-v" data-visual-mask>{ c.Value }</span>
					</div>
				}
			</div>
		} else {
			<p class="devcard-note">{ l.Sensors.Note }</p>
		}
	</section>
}

// devActBox is the Activity list: state changes and transactions of the device, newest first.
// It is history, so an offline device does not label it "Last reported".
templ devActBox(a devActivity, attrs templ.Attributes) {
	<section id="devact" class={ "devcard", ui.StackRank(5) } aria-labelledby="dc-act" { attrs... }>
		<div class="devcard-head">
			<h2 id="dc-act">Activity</h2>
			@ui.Button(ui.Btn{Label: "All activity", Kind: "link", Href: a.All})
		</div>
		if len(a.Rows) > 0 {
			@devActList(a.Rows, a.Base)
		} else {
			<p class="devcard-note">No state changes or transactions yet. Online/offline changes, updates and commands appear here, newest first.</p>
		}
	</section>
}

templ devActList(rows []devActRow, base string) {
	<ul class="dev-act">
		for _, r := range rows {
			<li>
				<time class="dev-act-at" { ui.StampAttrs(r.At, ui.StampDateTimeSec)... }>{ ui.StampText(r.At, ui.StampDateTimeSec) }</time>
				if e := r.Event; e != nil {
					<span class="dev-act-what">
						<span class="sr-only">From </span>
						@ui.Badge(uiTone(e.From), label(e.From))
						{ " " }
						<span aria-hidden="true">→</span>
						{ " " }
						<span class="sr-only">to </span>
						@ui.Badge(uiTone(e.To), label(e.To))
					</span>
					<span class="dev-act-more">{ string(e.Source) }{ healthMore(e.Source, e.Detail) }</span>
				} else if j := r.Job; j != nil {
					<span class="dev-act-what"><a href={ templ.SafeURL(base + "/transactions/" + strconv.FormatInt(int64(j.BatchID), 10)) }>Transaction #{ strconv.FormatInt(int64(j.BatchID), 10) }</a> @ui.Badge(uiTone(j.State), label(j.State))</span>
					<span class="dev-act-more">
						if r.Note != "" {
							{ r.Note }
						} else {
							{ j.Target() }
						}
						if j.LastError != "" {
							· <span class="reason" title={ tip(j.LastError) }>{ humanReason(j.LastError) }</span>
						}
					</span>
				}
			</li>
		}
	</ul>
}

// deviceHistoryPage is every state change and transaction of a device, paged (the overview shows
// the newest few).
templ deviceHistoryPage(p historyView) {
	@deviceHeader(p.Tabs)
	<section class="devcard cw-act" aria-labelledby="dc-hist">
		<div class="devcard-head">
			<h2 id="dc-hist">Activity</h2>
			@ui.Button(ui.Btn{Label: "Back to the overview", Kind: "link", Href: p.Base + devPath(p.Tabs.ID, "")})
		</div>
		if len(p.Rows) > 0 {
			@devActList(p.Rows, p.Base)
		} else {
			<p class="devcard-note">No state changes or transactions yet. Online/offline changes, updates and commands appear here, newest first.</p>
		}
		@pagerNav(p.Pager)
	</section>
}

// identityCard is the Identity card; "Refresh identity" asks the device again and swaps the card. The hidden field
// names what the card shows (Sig): the live region sends it back, and the live refresh carries the card out of band
// only when that changed (Changed, #1003), so a card Refresh identity just swapped in, with its notice, is left alone.
templ identityCard(c identCard) {
	<section
		id="identity"
		class={ "devcard", ui.StackRank(2) }
		aria-labelledby="dc-ident"
		if c.Changed {
			hx-swap-oob="true"
		}
	>
		<input type="hidden" id="identsig" name="ident" value={ c.Sig }/>
		<div class="devcard-head">
			<h2 id="dc-ident">Identity</h2>
			@staleLabel(!c.Off)
			if c.CanProbe {
				@ui.Button(ui.Btn{Label: "Refresh identity", Kind: "link", Attrs: c.probeAttrs()})
			}
		</div>
		if c.CanProbe {
			// The reason Refresh identity cannot act, as text: the button stays focusable (aria-disabled) and live.js sets and
			// clears this line as the device goes offline and comes back, because the card is not swapped for that (#1072).
			<p class="devcard-note" id="ident-why" data-off-why={ reasonOffline } hidden?={ c.whyText() == "" }>
				if c.Why != "" {
					@keepTogether(c.Why)
				} else if c.Off {
					{ reasonOffline }
				}
			</p>
		}
		@identityID(c.ID)
		if c.Topic != nil {
			@ui.KV(c.Rows[:c.TopicAt])
			@identityTopicHint(*c.Topic)
			@ui.KV(c.Rows[c.TopicAt:])
		} else {
			@ui.KV(c.Rows)
		}
		@identityFWR(c)
		if c.CRWarn != "" {
			@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, Text: c.CRWarn})
		}
		if c.NameOffer != "" {
			@nameOfferNotice(c)
		}
		if c.Error != "" || c.Notice != "" {
			// the answer to Refresh identity: live.js carries it into a card the live refresh swaps in (#1003)
			<div data-ident-answer>
				if c.Error != "" {
					@ui.Banner(ui.BannerData{Tone: ui.ToneDanger, Text: c.Error, Alert: true})
				}
				if c.Notice != "" {
					@ui.Banner(ui.BannerData{Tone: ui.ToneOK, Text: c.Notice})
				}
			</div>
		}
	</section>
}

// identityTopicHint says that MQTT writes to the device are held back by a topic collision (#1047), with the other
// device as a link and, for admins, "+N more" as a link to the Topic check card. The markup is ui.Banner's.
templ identityTopicHint(t topicHint) {
	@ui.Banner(ui.BannerData{Tone: ui.ToneWarn, ID: "topic-hint", Text: t.Lead + t.Before}) {
		if t.Other != "" {
			<a href={ templ.SafeURL(t.OtherAt) }>{ t.Other }</a>{ t.After + "." }
		} else {
			{ t.After + "." }
		}
		if t.More > 0 {
			if t.MoreHref != "" {
				{ " " }<a href={ templ.SafeURL(t.MoreHref) }>{ "+" + strconv.Itoa(t.More) + " more" }</a>
			} else {
				{ " +" + strconv.Itoa(t.More) + " more" }
			}
		}
	}
}

// identityID is the first row of the Identity card (#1004): the number every log line names the
// device by ("device":45), with the app's copy button. It is its own row list because ui.KV has
// no place for a button; it uses the same row markup, so it lines up with the rows below.
templ identityID(id model.DeviceID) {
	<dl class="ukv">
		<div class="ukv-row">
			<dt>TasmoFleet ID</dt>
			<dd class="mono ukv-copy" data-visual-mask>
				{ strconv.FormatInt(int64(id), 10) }
				@ui.CopyButton(ui.CopyData{Text: strconv.FormatInt(int64(id), 10), Aria: "Copy the TasmoFleet ID"})
			</dd>
		</div>
	</dl>
}

// identityFWR is the StatusFWR block of the Identity card (#289): the fields of Status 2 under
// Tasmota's own names with the values as sent, each explained behind an info button (ui.Info, a
// popover that opens on a tap as well as on a click; the id is per field, #680), then
// TasmoFleet's own reading of them, kept apart.
templ identityFWR(c identCard) {
	<h3 class="ukv-h">Reported by the device <span class="ukv-sub">Status 2 · StatusFWR</span></h3>
	if len(c.FWR) > 0 {
		<dl class="ukv">
			for _, r := range c.FWR {
				<div class={ "ukv-row", templ.KV("ukv-wide", r.Wide) }>
					<dt>{ r.Name } @ui.Info("fwr-info-"+r.Name, r.Name, r.Info)</dt>
					<dd class="mono">{ r.Value }</dd>
				</div>
			}
		</dl>
	}
	if !c.FWRRead {
		<p class="devcard-note">Most of Status 2 is not read yet. Refresh identity reads it.</p>
	}
	if len(c.Reading) > 0 {
		<h3 class="ukv-h">TasmoFleet&#39;s reading <span class="ukv-sub">worked out by TasmoFleet, not reported by the device</span></h3>
		@ui.KV(c.Reading)
	}
}

// stabilityCard is the Stability card of the Overview (#325): the verdict as a badge, a notice only
// when there is a problem, then the numbers behind it. attrs: hx-swap-oob on a live refresh.
templ stabilityCard(c stabCard, attrs templ.Attributes) {
	<section id="stability" class={ "devcard", "stab-card", ui.StackRank(1) } aria-labelledby="dc-stab" { attrs... }>
		<div class="stab-head">
			<h2 id="dc-stab">Stability</h2>
			@ui.Badge(c.badgeTone(), c.badgeLabel())
			if c.Stale {
				@staleLabel(false)
			}
			if !c.NoData {
				<span class="stab-meta">{ c.Meta }</span>
			}
		</div>
		if len(c.Note) > 0 {
			<div class={ "stab-note", stabTone(c.Level) }>
				for _, s := range c.Note {
					if s.Bold {
						<strong>{ s.Text }</strong>
					} else {
						{ s.Text }
					}
				}
			</div>
		}
		<dl class="ukv">
			for _, r := range c.Rows {
				<div class="ukv-row">
					<dt>{ r.Key }</dt>
					<dd>
						if r.Class != "" {
							<span class={ r.Class }>{ r.Main }</span>
						} else {
							{ r.Main }
						}
						{ r.Rest }
						if r.Sub != "" || !r.SubAt.IsZero() {
							<span class="sub">
								if !r.SubAt.IsZero() {
									<time data-visual-mask { ui.StampAttrs(r.SubAt, ui.StampDay)... }>{ r.SubAtText }</time>
								}
								{ r.Sub }
							</span>
						}
						if r.Spark != nil {
							<svg class={ "stab-spark", r.Spark.Tone } viewBox="0 0 240 36" preserveAspectRatio="none" role="img" aria-label="Wi-Fi signal, last 24 hours, one sample per hour" data-visual-mask>
								<line class="ref" x1="0" x2="240" y1={ r.Spark.Ref } y2={ r.Spark.Ref }></line>
								<polyline class="line" points={ r.Spark.Points }></polyline>
							</svg>
						}
					</dd>
				</div>
			}
		</dl>
		if len(c.Boots) > 0 {
			<h3 class="devcard-h3">Recent restarts</h3>
			<ul class="stab-boots">
				for _, b := range c.Boots {
					<li>
						<span class="when"><time data-visual-mask { ui.StampAttrs(b.At, ui.StampClockOrDay)... }>{ b.AtText }</time></span>
						<span>
							{ b.Label }
							if b.Raw != "" {
								<br/>
								<span class="raw">{ b.Raw }</span>
							}
						</span>
						if b.Ran != "" {
							<span class="ran">{ b.Ran }</span>
						}
					</li>
				}
			</ul>
		}
	</section>
}
