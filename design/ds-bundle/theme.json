  "tokens": {
    "--font-heading": "\"Archivo\", system-ui, sans-serif",
    "--font-body": "\"Archivo\", system-ui, sans-serif",
    "--font-mono": "ui-monospace, \"SF Mono\", \"Cascadia Mono\", \"Liberation Mono\", Menlo,\n    monospace",
    "--font-heading-weight": "800",
    "--fs-xs": "12px",
    "--fs-sm": "13px",
    "--fs-body": "14px",
    "--fs-md": "16px",
    "--fs-lg": "19px",
    "--fs-h1": "26px",
    "--fs-stat": "34px",
    "--lh-tight": "1.15",
    "--lh-body": "1.5",
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "20px",
    "--space-6": "24px",
    "--space-8": "32px",
    "--space-10": "40px",
    "--space-12": "48px",
    "--radius-sm": "0px",
    "--radius-md": "0px",
    "--radius-lg": "0px",
    "--rule-w": "2px",
    "--hair-w": "1px",
    "--control-h-sm": "28px",
    "--control-h": "34px",
    "--control-h-lg": "40px",
    "--control-pad-x": "14px",
    "--control-pad-x-sm": "10px",
    "--grid-cols": "12",
    "--gutter": "var(--space-4)",
    "--container": "1440px",
    "--page-pad": "var(--space-6)",
    "--z-sticky": "10",
    "--z-menu": "40",
    "--z-dialog": "1000",
    "--radius": "var(--radius-md)",
    "--font": "var(--font-body)",
    "--control-line": "var(--color-border)"
  }
}
