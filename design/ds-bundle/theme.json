{
  "name": "tasmofleet DS",
  "basedOn": "Modernist (Claude Design)",
  "description": "Flat, 0 radius, 2px section rules, modular grid, Archivo; ink on ground, teal accent used sparingly; light and dark with the same token names.",
  "css": "styles.css",
  "themeSelection": {
    "default": "prefers-color-scheme",
    "override": "data-theme=\"light\" | \"dark\" on <html>"
  },
  "fonts": [
    {
      "family": "Archivo",
      "weights": "400-800 (variable)",
      "files": [
        "fonts/archivo-latin.woff2",
        "fonts/archivo-latin-ext.woff2"
      ],
      "license": "fonts/OFL.txt"
    }
  ],
  "ramps": {
    "accent": {
      "100": "#e5fbf6",
      "200": "#c2f2e8",
      "300": "#87e5d6",
      "400": "#2dd4bf",
      "500": "#0cb3a3",
      "600": "#0b9488",
      "700": "#0f766e",
      "800": "#005a53",
      "900": "#033c37",
      "950": "#002724"
    },
    "success": {
      "100": "#e7fbeb",
      "200": "#c8f3d0",
      "300": "#96e7a8",
      "400": "#56d77e",
      "500": "#2eb861",
      "600": "#12994c",
      "700": "#017b3b",
      "800": "#035d2c",
      "900": "#023e1c",
      "950": "#012910"
    },
    "warning": {
      "100": "#fff3e4",
      "200": "#ffe1bc",
      "300": "#fec57f",
      "400": "#fca31c",
      "500": "#d88605",
      "600": "#b56d01",
      "700": "#935605",
      "800": "#713f03",
      "900": "#4e2801",
      "950": "#341801"
    },
    "danger": {
      "100": "#fff2f0",
      "200": "#ffddd9",
      "300": "#febfb8",
      "400": "#ff998f",
      "500": "#fe5d57",
      "600": "#d84641",
      "700": "#b03531",
      "800": "#872623",
      "900": "#5c1714",
      "950": "#3d0d0b"
    },
    "info": {
      "100": "#eff6ff",
      "200": "#d7e8ff",
      "300": "#b5d3fe",
      "400": "#8dbbfe",
      "500": "#569aff",
      "600": "#3d7de1",
      "700": "#3063b7",
      "800": "#244a8d",
      "900": "#173160",
      "950": "#0d1f41"
    },
    "neutral": {
      "100": "#f2f6f6",
      "200": "#e2e7e7",
      "300": "#cbd3d2",
      "400": "#b2bbba",
      "500": "#949e9d",
      "600": "#798382",
      "700": "#5f6968",
      "800": "#464f4e",
      "900": "#2c3534",
      "950": "#1a2222"
    }
  },
  "themes": {
    "light": {
      "--color-accent": "#0f766e",
      "--color-accent-active": "#033c37",
      "--color-accent-hover": "#005a53",
      "--color-accent-soft": "#e5fbf6",
      "--color-accent-soft-text": "#005a53",
      "--color-bg": "#f4f6f6",
      "--color-border": "#798382",
      "--color-border-overlay": "#798382",
      "--color-danger": "#872623",
      "--color-danger-border": "#d84641",
      "--color-danger-soft": "#fff2f0",
      "--color-danger-text": "#872623",
      "--color-divider": "#cbd3d2",
      "--color-focus": "#0f766e",
      "--color-hover": "#151e1d @ 6%",
      "--color-info": "#3063b7",
      "--color-info-border": "#3d7de1",
      "--color-info-soft": "#eff6ff",
      "--color-info-text": "#244a8d",
      "--color-link": "#0f766e",
      "--color-neutral": "#798382",
      "--color-neutral-border": "#949e9d",
      "--color-neutral-soft": "#e2e7e7",
      "--color-neutral-text": "#464f4e",
      "--color-on-accent": "#ffffff",
      "--color-on-power": "#ffffff",
      "--color-overlay": "#ffffff",
      "--color-power-on": "#151e1d",
      "--color-press": "#151e1d @ 12%",
      "--color-rule": "#151e1d",
      "--color-selected": "#e5fbf6",
      "--color-success": "#017b3b",
      "--color-success-border": "#12994c",
      "--color-success-soft": "#e7fbeb",
      "--color-success-text": "#035d2c",
      "--color-surface": "#ffffff",
      "--color-surface-2": "#ecf0f0",
      "--color-text": "#151e1d",
      "--color-text-2": "#5f6968",
      "--color-text-3": "var(\n    --color-neutral-500\n  )",
      "--color-warning": "#b56d01",
      "--color-warning-border": "#d88605",
      "--color-warning-soft": "#fff3e4",
      "--color-warning-text": "#713f03"
    },
    "dark": {
      "--color-accent": "#2dd4bf",
      "--color-accent-active": "#c2f2e8",
      "--color-accent-hover": "#87e5d6",
      "--color-accent-soft": "#002724",
      "--color-accent-soft-text": "#87e5d6",
      "--color-bg": "#0c1110",
      "--color-border": "#6d7776",
      "--color-border-overlay": "#949e9d",
      "--color-danger": "#fe5d57",
      "--color-danger-border": "#d84641",
      "--color-danger-soft": "#3d0d0b",
      "--color-danger-text": "#febfb8",
      "--color-divider": "#313a39",
      "--color-focus": "#87e5d6",
      "--color-hover": "#e9eeee @ 7%",
      "--color-info": "#8dbbfe",
      "--color-info-border": "#3063b7",
      "--color-info-soft": "#0d1f41",
      "--color-info-text": "#b5d3fe",
      "--color-link": "#87e5d6",
      "--color-neutral": "#949e9d",
      "--color-neutral-border": "#798382",
      "--color-neutral-soft": "#2c3534",
      "--color-neutral-text": "#cbd3d2",
      "--color-on-accent": "#002724",
      "--color-on-power": "#0c1110",
      "--color-overlay": "#222929",
      "--color-power-on": "#e9eeee",
      "--color-press": "#e9eeee @ 13%",
      "--color-rule": "#e9eeee",
      "--color-selected": "#16312e",
      "--color-success": "#56d77e",
      "--color-success-border": "#017b3b",
      "--color-success-soft": "#012910",
      "--color-success-text": "#96e7a8",
      "--color-surface": "#131918",
      "--color-surface-2": "#19201f",
      "--color-text": "#e9eeee",
      "--color-text-2": "#aeb8b7",
      "--color-text-3": "#798382",
      "--color-warning": "#fca31c",
      "--color-warning-border": "#935605",
      "--color-warning-soft": "#341801",
      "--color-warning-text": "#fec57f"
